import * as memory from "std:memory";

@target_os("windows")
@ffi.lib("kernel32")
declare function GetStdHandle(nStdHandle: i32): ptr<void>;

@target_os("windows")
@ffi.lib("kernel32")
declare function WriteFile(
    handle: ptr<void>,
    buffer: ptr<void>,
    bytesToWrite: i32,
    bytesWritten: ptr<i32>,
    overlapped: ptr<void>
): i32;

@target_os("linux")
@ffi.lib("c")
declare function write(fd: i32, buffer: ptr<void>, count: i32): i32;


    @target_os("windows")
    export @unsafe function log(message: string): void {
        let handle: ptr<void> = GetStdHandle(-11);
        let written: i32 = 0;
        let pData = memory.offset(message, 8);
        WriteFile(handle, pData, message.byteLength, addressof(written), 0);
        let newline = "\n";
        WriteFile(handle, memory.offset(newline, 8), 1, addressof(written), 0);
    }

    @target_os("windows")
    export @unsafe function warn(message: string): void {
        let handle: ptr<void> = GetStdHandle(-11);
        let written: i32 = 0;
        let pData = memory.offset(message, 8);
        WriteFile(handle, pData, message.byteLength, addressof(written), 0);
        let newline = "\n";
        WriteFile(handle, memory.offset(newline, 8), 1, addressof(written), 0);
    }

@target_os("windows")
export @unsafe function error(message: string): void {
    let handle: ptr<void> = GetStdHandle(-12);
    let written: i32 = 0;
    let pData = memory.offset(message, 8);
    WriteFile(handle, pData, message.byteLength, addressof(written), 0);
    let newline = "\n";
    WriteFile(handle, memory.offset(newline, 8), 1, addressof(written), 0);
}

export declare function print_i32(val: i32): void;
export declare function print_ptr(val: i64): void;

