import { Array } from "std:array";
import { Optional, Some, None } from "std:option";

import { Token } from "../../self-hosting/lexer.tsn";
import { Parser } from "../../self-hosting/parser.tsn";

export @unsafe function force_instantiations(): void {
    let a = new Array<rawPtr<void>>();
    let p: rawPtr<void> = null;
    a.push(p);
    a.pop();
    a.get(0);
    a.set(0, p);
    a.grow();
    a.dispose();
    
    let o = Some<rawPtr<void>>(p);
    // o.isSome();
    // o.isNone();
    // o.unwrap();
    // o.unwrapOr(p);

    let a2 = new Array<i32>();
    let p2: i32 = 0;
    a2.push(p2);

    let a3 = new Array<ptr<void>>();
    let p3: ptr<void> = null;
    a3.push(p3);
    a3.get(0);
    a3.length();

    let a4 = new Array<Token>();
    let t: Token = null;
    a4.push(t);
    
    let parser = new Parser(a4);
}
