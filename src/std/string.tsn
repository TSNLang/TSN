import * as memory from "std:memory";

declare function print_i32(n: i32): void;


    /**
     * Độ dài tính bằng byte (không bao gồm null terminator).
     */
    export @unsafe function byteLength(s: string): i32 {
        if (s == null) return 0;
        let pLen: rawPtr<i32> = memory.offset(s, 4);
        let len = pLen.get();
        return len;
    }

    /**
     * Độ dài tính bằng số ký tự (hỗ trợ UTF-8).
     * TỐI ƯU: Hiện tại trả về byteLength vì source code parser chủ yếu là ASCII.
     */
    export @unsafe function length(s: string): i32 {
        if (s == null) return 0;
        return byteLength(s);
    }

    /**
     * Lấy mã code point của ký tự tại vị trí index.
     */
    export @unsafe function charCodeAt(s: string, index: i32): i32 {
        if (s == null) return 0;
        let p: rawPtr<void> = memory.offset(s, 8); // Skip header
        return memory.getByte(p, index);
    }

    /**
     * Nối hai chuỗi.
     */
    export @unsafe function concat(a: string, b: string): string {
        let la = byteLength(a);
        let lb = byteLength(b);
        let total = la + lb;
        
        // Header (8) + data + null terminator (1)
        let buf = memory.alloc(total + 9);
        if (buf == null) return "";
        
        let pRefCount: rawPtr<i32> = buf;
        pRefCount.set(1);
        let pLength: rawPtr<i32> = memory.offset(buf, 4);
        pLength.set(total);

        let dataDest = memory.offset(buf, 8);
        if (la > 0) memory.copy(dataDest, memory.offset(a, 8), la);
        if (lb > 0) memory.copy(memory.offset(dataDest, la), memory.offset(b, 8), lb);
        
        memory.setByte(dataDest, total, 0); // Null terminator
        
        let res: string = buf;
        return res;
    }

    /**
     * So sánh hai chuỗi. Trả về 0 nếu bằng nhau.
     */
    export @unsafe function compare(a: string, b: string): i32 {
        let pa_raw: rawPtr<void> = a;
        let pb_raw: rawPtr<void> = b;
        if (pa_raw == pb_raw) return 0;
        if (a == null) return 0 - 1;
        if (b == null) return 1;

        let pa: rawPtr<void> = memory.offset(a, 8);
        let pb: rawPtr<void> = memory.offset(b, 8);
        let i = 0;
        
        while (true) {
            let ca = memory.getByte(pa, i);
            let cb = memory.getByte(pb, i);
            
            if (ca != cb) return ca - cb;
            if (ca == 0) return 0;
            i++;
        }
    }

    export @unsafe function equals(a: string, b: string): bool {
        return compare(a, b) == 0;
    }

    /**
     * Trích xuất chuỗi con (tính theo byte).
     */
    export @unsafe function substr(s: string, start: i32, len: i32): string {
        if (s == null) return "";
        let buf = memory.alloc(len + 9);
        if (buf == null) return "";
        
        let pRefCount: rawPtr<i32> = buf;
        pRefCount.set(1);
        let pLength: rawPtr<i32> = memory.offset(buf, 4);
        pLength.set(len);

        let dataDest = memory.offset(buf, 8);
        memory.copy(dataDest, memory.offset(s, 8 + start), len);
        memory.setByte(dataDest, len, 0);
        
        let res: string = buf;
        return res;
    }

    /**
     * Kiểm tra chuỗi con ở vị trí bắt đầu.
     */
    export @unsafe function startsWith(s: string, search: string): bool {
        let slen = byteLength(s);
        let sslen = byteLength(search);
        if (sslen > slen) return false;
        
        for (let i = 0; i < sslen; i++) {
            if (charCodeAt(s, i) != charCodeAt(search, i)) return false;
        }
        return true;
    }

    export @unsafe function includes(s: string, search: string): bool {
        let slen = byteLength(s);
        let sslen = byteLength(search);
        if (sslen > slen) return false;
        
        for (let i = 0; i <= slen - sslen; i++) {
            let match = true;
            for (let j = 0; j < sslen; j++) {
                if (charCodeAt(s, i + j) != charCodeAt(search, j)) {
                    match = false;
                    break;
                }
            }
            if (match) return true;
        }
        return false;
    }

    export @unsafe function indexOf(s: string, search: string): i32 {
        let slen = byteLength(s);
        let sslen = byteLength(search);
        if (sslen > slen) return -1;
        
        for (let i = 0; i <= slen - sslen; i++) {
            let match = true;
            for (let j = 0; j < sslen; j++) {
                if (charCodeAt(s, i + j) != charCodeAt(search, j)) {
                    match = false;
                    break;
                }
            }
            if (match) return i;
        }
        return -1;
    }

