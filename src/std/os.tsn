import * as memory from "std:memory";
import { Iterator } from "std:iterator";
import { Optional, Some, None } from "std:option";
import { Array } from "std:array";

@ffi.lib("")
declare
function tsn_get_argc(): i32;

@ffi.lib("")
declare
function tsn_get_argv_ptr(): rawPtr<void>;

export class ArgsIterator implements Iterator<string> {
    private argc: i32;
    private argv: rawPtr<void>;
    private index: i32;

    constructor() {
        this.argc = tsn_get_argc();
        this.argv = tsn_get_argv_ptr();
        this.index = 0;
    }

    next(): Optional<string> {
        if (this.index >= this.argc) {
            return None<string>();
        }
        
        let ptrOffset = (this.index as i64) * 8;
        let strPtr = memory.getPointer(this.argv, ptrOffset);
        
        // Find length of null-terminated C string
        let len = 0;
        while (true) {
            let b = memory.getByte(strPtr, len as i64);
            if (b == 0) break;
            len = len + 1;
        }

        // Allocate TSN string: 4 bytes refCount + 4 bytes length + len + 1 null terminator
        let totalSize = (len as i64) + 9;
        let buf = memory.alloc(totalSize);
        
        let pRefCount: rawPtr<i32> = buf;
        pRefCount.set(1);
        
        let pLength: rawPtr<i32> = memory.offset(buf, 4);
        pLength.set(len);
        
        let dataDest = memory.offset(buf, 8);
        if (len > 0) {
            memory.copy(dataDest, strPtr, len as i64);
        }
        memory.setByte(dataDest, len as i64, 0); // Null terminator
        
        let s: string = buf;
        
        this.index = this.index + 1;
        return Some<string>(s);
    }

    
    // Tạm thời để thay thế [...iterator] giống như .collect() của Rust
    toArray(): Array<string> {
        let arr = new Array<string>();
        while (true) {
            let opt = this.next();
            if (opt.isNone()) break;
            arr.push(opt.unwrap());
        }
        return arr;
    }
}

export function args(): ArgsIterator {
    return new ArgsIterator();
}
