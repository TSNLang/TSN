// Enhanced compiler with basic import resolution
// This version scans for local imports (./file.tsn) and compiles them together

import { log } from "std:console";
import { readText, writeText } from "std:fs";
import { Lexer } from "./lexer.tsn";
import { ASTParser } from "./ast-parser.tsn";
import { Program, Token, TokenKind, Declaration } from "./ast.tsn";
import { Array } from "std:array";
import { MIRBuilder } from "./mir-builder-flat.tsn";
import { MIRCodegen } from "./mir-codegen-flat.tsn";

// Helper to extract import paths from source code
function extractImports(source: string): Array<string> {
    let imports = new Array<string>();
    let i = 0;
    let len = source.length;
    
    while (i < len) {
        // Look for "import" keyword
        if (i + 6 < len) {
            let substr = source.slice(i, i + 6);
            if (substr == "import") {
                // Found import, look for "from"
                let j = i + 6;
                while (j < len) {
                    if (j + 4 < len) {
                        let fromStr = source.slice(j, j + 4);
                        if (fromStr == "from") {
                            // Found "from", extract path
                            j = j + 4;
                            // Skip whitespace and quotes
                            while (j < len) {
                                let ch = source.charCodeAt(j);
                                if (ch == 34 || ch == 39) { // " or '
                                    j = j + 1;
                                    let pathStart = j;
                                    while (j < len) {
                                        let ch2 = source.charCodeAt(j);
                                        if (ch2 == 34 || ch2 == 39) {
                                            let importPath = source.slice(pathStart, j);
                                            // Only add local imports (starting with ./)
                                            if (importPath.charCodeAt(0) == 46) { // '.'
                                                imports.push(importPath);
                                            }
                                            break;
                                        }
                                        j = j + 1;
                                    }
                                    break;
                                }
                                j = j + 1;
                            }
                            break;
                        }
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    
    return imports;
}

// Resolve relative import path
function resolveImportPath(basePath: string, importPath: string): string {
    // Simple resolution: if importPath starts with "./", replace with basePath directory
    // For now, just return the import path as-is for simplicity
    // TODO: Proper path resolution
    
    // Find last / or \ in basePath
    let lastSlash = 0;
    let i = 0;
    while (i < basePath.length) {
        let ch = basePath.charCodeAt(i);
        if (ch == 47 || ch == 92) { // / or \
            lastSlash = i;
        }
        i = i + 1;
    }
    
    // Get directory part
    let dir = basePath.slice(0, lastSlash + 1);
    
    // Remove "./" from import path
    let relPath = importPath;
    if (importPath.charCodeAt(0) == 46 && importPath.charCodeAt(1) == 47) {
        relPath = importPath.slice(2, importPath.length);
    }
    
    return dir + relPath;
}

class CompilerState {
    public source: string;
    public tokens: Array<Token>;
    public allDeclarations: Array<Declaration>;
    
    constructor() {
        this.source = "";
        this.tokens = null as Array<Token>;
        this.allDeclarations = new Array<Declaration>();
    }
}

@unsafe function parseFileWithImports(state: CompilerState, path: string, processedFiles: Array<string>): bool {
    log("parseFileWithImports: ");
    log(path);
    
    // Check if already processed
    let i = 0;
    while (i < processedFiles.length) {
        let processed = processedFiles.get(i);
        if (processed == path) {
            log("Already processed, skipping");
            return true;
        }
        i = i + 1;
    }
    
    processedFiles.push(path);
    
    // Read file
    let fsResult = readText(path);
    if (!fsResult.isOk()) {
        log("Error: could not read file: ");
        log(path);
        return false;
    }
    
    let source = fsResult.value();
    
    // Extract imports
    log("Extracting imports...");
    let imports = extractImports(source);
    log("Found imports:");
    print_i32(imports.length);
    
    // Process imports first (depth-first)
    let j = 0;
    while (j < imports.length) {
        let importPath = imports.get(j);
        log("Processing import: ");
        log(importPath);
        let resolvedPath = resolveImportPath(path, importPath);
        log("Resolved to: ");
        log(resolvedPath);
        if (!parseFileWithImports(state, resolvedPath, processedFiles)) {
            return false;
        }
        j = j + 1;
    }
    
    // Now parse this file
    log("Parsing file: ");
    log(path);
    
    let lexer = new Lexer(source);
    let tokens = lexer.tokenize();
    if (tokens.length == 0) {
        log("Error: no tokens generated");
        return false;
    }
    
    let parser = new ASTParser(tokens);
    
    // Parse all declarations and add to state.allDeclarations
    while (parser.pos < tokens.length) {
        let t = tokens.get(parser.pos);
        if (t == null || t.kind == TokenKind.EOF) {
            break;
        }
        
        // Skip import statements in parsed output
        if (t.kind == TokenKind.Import) {
            // Skip until semicolon
            while (parser.pos < tokens.length) {
                let skipT = tokens.get(parser.pos);
                parser.pos = parser.pos + 1;
                if (skipT.kind == TokenKind.Semicolon) {
                    break;
                }
            }
            continue;
        }
        
        let decl = parser.parseDeclaration();
        if (decl != null) {
            state.allDeclarations.push(decl);
        }
    }
    
    return true;
}

declare function tsn_get_argc(): i32;
declare function tsn_get_argv(index: i32): ptr;
declare function cstringToString(cstr: ptr): string;
declare function print_i32(n: i32): void;

@unsafe function main(): i32 {
    log("=== TSN Compiler with Import Resolution ===");
    
    let argCount = tsn_get_argc();
    if (argCount < 2) {
        log("Usage: tsn-imports <input.tsn> [output.ll]");
        return 1;
    }

    let inputPath = cstringToString(tsn_get_argv(1));
    let outputPath = "";
    if (argCount > 2) {
        outputPath = cstringToString(tsn_get_argv(2));
    } else {
        outputPath = "output.ll";
    }
    
    log("Input: ");
    log(inputPath);
    log("Output: ");
    log(outputPath);

    let state = new CompilerState();
    let processedFiles = new Array<string>();
    
    if (!parseFileWithImports(state, inputPath, processedFiles)) {
        log("Failed to parse files with imports");
        return 1;
    }
    
    log("Total declarations collected: ");
    print_i32(state.allDeclarations.length);
    
    // Create Program from all declarations
    let astProgram = new Program(state.allDeclarations);

    log("=== BUILDING MIR FROM AST ===");
    let mirBuilder = new MIRBuilder(inputPath);
    let mirModule = mirBuilder.build(astProgram);
    log("=== MIR BUILD COMPLETE ===");

    log("=== GENERATING LLVM IR FROM MIR ===");
    let codegen = new MIRCodegen(mirModule);
    let ir = codegen.generate();
    log("=== LLVM IR GENERATION COMPLETE ===");
    
    log("Generated IR length:");
    print_i32(ir.length);

    if (outputPath != "") {
        log("Writing LLVM IR to file...");
        let writeRes = writeText(outputPath, ir);
        if (!writeRes.isOk()) {
            log("FAILED to write output file!");
            return 1;
        }
        log("✓ Successfully wrote output file!");
    }

    return 0;
}
