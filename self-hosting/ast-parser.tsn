declare function print_i32(n: i32): void;
import { log } from "std:console";
import { Array } from "std:array";
import { 
    Token, TokenKind, Program, Declaration, ClassMemberDecl, ParameterInfo,
    Stmt, BlockStmt, VarDeclStmt, ReturnStmt, IfStmt, WhileStmt, ForStmt, ExprStmt,
    Expr, BinaryExpr, UnaryExpr, IdentifierExpr, NumberLiteral, StringLiteral, BooleanLiteral,
    MemberExpr, CallExpr, NewExpr, ThisExpr, ArrayLiteral, IndexExpr
} from "./ast.tsn";

export class ASTParser {
    private tokens: Array<Token>;
    private pos: i32;

    @unsafe private pushDecl(arr: Array<Declaration>, item: Declaration): void {
        log("--- pushDecl: enter");
        if (item != null) {
            log("--- pushDecl: incref item");
            class_incref(item);
        }
        log("--- pushDecl: calling arr.push");
        arr.push(item);
        log("--- pushDecl: done");
    }

    @unsafe private pushParam(arr: Array<ParameterInfo>, item: ParameterInfo): void {
        if (item != null) class_incref(item);
        arr.push(item);
    }

    @unsafe private pushMember(arr: Array<ClassMemberDecl>, item: ClassMemberDecl): void {
        if (item != null) class_incref(item);
        arr.push(item);
    }

    @unsafe private pushStmt(arr: Array<Stmt>, item: Stmt): void {
        if (item != null) class_incref(item);
        arr.push(item);
    }

    @unsafe private pushExpr(arr: Array<Expr>, item: Expr): void {
        if (item != null) class_incref(item);
        arr.push(item);
    }

    @unsafe constructor(tokens: Array<Token>) {
        log("--- ASTParser.constructor: start");
        this.tokens = tokens;
        this.pos = 0;
        log("--- ASTParser.constructor: end");
    }

    public parse(): Program {
        let declarations = new Array<Declaration>();
        
        // Inline isAtEnd() to avoid vtable issues
        while (this.pos < this.tokens.length) {
            let t = this.tokens.get(this.pos);
            if (t == null || t.kind == TokenKind.EOF) {
                break;
            }
            let decl = this.parseDeclaration();
            if (decl != null) {
                declarations.push(decl);
            }
        }
        
        let prog = new Program(declarations);
        class_incref(prog);
        class_incref(prog);
        return prog;
    }

    @unsafe private parseDeclaration(): Declaration {
        let isExported = this.matchKind(TokenKind.Export);
        let isDeclare = this.matchKind(TokenKind.Declare);
        
        if (this.matchKind(TokenKind.Import)) {
            return this.parseImportDecl();
        }
        
        if (this.matchKind(TokenKind.Function)) {
            return this.parseFunctionDecl(isExported, isDeclare);
        }
        
        if (this.matchKind(TokenKind.Class)) {
            return this.parseClassDecl(isExported, isDeclare);
        }
        
        if (!this.isAtEnd()) {
            this.advance();
        }
        return null as Declaration;
    }

    @unsafe private parseImportDecl(): Declaration {
        log("--- parseImportDecl: start");
        let defaultImport = "";
        let namespaceImport = "";
        
        if (this.peekKind() == TokenKind.Identifier) {
            log("--- parseImportDecl: default import branch");
            let lex = this.advanceLexeme();
            defaultImport = lex;
            class_incref(defaultImport);
            this.matchKind(TokenKind.Comma);
        }
        
        if (this.matchKind(TokenKind.LBrace)) {
            log("--- parseImportDecl: named import branch");
            while (!this.check(TokenKind.RBrace) && !this.isAtEnd()) {
                this.advance();
                if (!this.matchKind(TokenKind.Comma)) break;
            }
            this.matchKind(TokenKind.RBrace);
        } else if (this.matchKind(TokenKind.Star)) {
            log("--- parseImportDecl: namespace import branch");
            this.matchKind(TokenKind.As);
            log("--- parseImportDecl: about to advance for alias");
            let lex = this.advanceLexeme();
            namespaceImport = lex;
            class_incref(namespaceImport);
            log("--- parseImportDecl: assigned to namespaceImport");
        }
        
        log("--- parseImportDecl: matching From");
        this.matchKind(TokenKind.From);
        log("--- parseImportDecl: From matched, checking String token");
        let source = "";
        if (this.peekKind() == TokenKind.String) {
            let lex = this.advanceLexeme();
            source = lex;
            class_incref(source);
        }
        log("--- parseImportDecl: matching Semicolon");
        this.matchKind(TokenKind.Semicolon);
        log("--- parseImportDecl: creating Declaration");
        
        return new Declaration("ImportDecl", source, defaultImport, namespaceImport, "", new Array<ClassMemberDecl>(), null as Stmt);
    }

    @unsafe private parseFunctionDecl(isExported: bool, isDeclare: bool): Declaration {
        let name = "";
        if (this.peekKind() == TokenKind.Identifier) {
            name = this.advanceLexeme();
        }
        
        if (this.matchKind(TokenKind.Less)) {
            this.skipUntil(TokenKind.Greater);
            this.matchKind(TokenKind.Greater);
        }
        
        let params = new Array<ParameterInfo>();
        if (this.matchKind(TokenKind.LParen)) {
            log("--- ASTParser.parseFunctionDecl: parsing params");
            while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                let pName = this.advanceLexeme();
                let pType = "";
                if (this.matchKind(TokenKind.Colon)) pType = this.parseTypeText();
                this.pushParam(params, new ParameterInfo(pName, pType, false));
                if (!this.matchKind(TokenKind.Comma)) break;
            }
            this.matchKind(TokenKind.RParen);
        }
        
        let retType = "void";
        if (this.matchKind(TokenKind.Colon)) {
            retType = this.parseTypeText();
        }
        log("--- ASTParser.parseFunctionDecl: retType =");
        log(retType);
        
        let body: Stmt = null as Stmt;
        if (isDeclare) {
            this.matchKind(TokenKind.Semicolon);
        } else {
            log("--- ASTParser.parseFunctionDecl: parsing block body");
            body = this.parseBlockStmt();
        }
        
        let decl = new Declaration("FunctionDecl", name, retType, "", "", new Array<ClassMemberDecl>(), body);
        class_incref(params);
        decl.params = params;
        log("--- ASTParser.parseFunctionDecl: decl successfully created");
        return decl;
    }

    @unsafe private parseClassDecl(isExported: bool, isDeclare: bool): Declaration {
        let name = "";
        if (this.peekKind() == TokenKind.Identifier) {
            name = this.advanceLexeme();
        }
        
        if (this.matchKind(TokenKind.Less)) {
            this.skipUntil(TokenKind.Greater);
            this.matchKind(TokenKind.Greater);
        }
        
        let members = new Array<ClassMemberDecl>();
        if (this.matchKind(TokenKind.LBrace)) {
            while (!this.check(TokenKind.RBrace) && !this.isAtEnd()) {
                this.pushMember(members, this.parseClassMember());
            }
            this.matchKind(TokenKind.RBrace);
        }
        
        return new Declaration("ClassDecl", name, "", "", "", members, null as Stmt);
    }

    @unsafe private parseClassMember(): ClassMemberDecl {
        let isPublic = false;
        let isPrivate = false;
        let isProtected = false;
        let isStatic = false;
        
        while (true) {
            let k = this.peekKind();
            if (k == TokenKind.Public) { isPublic = true; this.advance(); }
            else if (k == TokenKind.Private) { isPrivate = true; this.advance(); }
            else if (k == TokenKind.Protected) { isProtected = true; this.advance(); }
            else if (k == TokenKind.Static) { isStatic = true; this.advance(); }
            else break;
        }

        let isConstructor = this.matchKind(TokenKind.Constructor);
        let name = "";
        if (!isConstructor) {
            name = this.advanceLexeme();
        } else {
            name = "constructor";
        }

        let params = new Array<ParameterInfo>();
        if (this.matchKind(TokenKind.LParen)) {
            while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                let pName = this.advanceLexeme();
                let pType = "";
                if (this.matchKind(TokenKind.Colon)) pType = this.parseTypeText();
                this.pushParam(params, new ParameterInfo(pName, pType, false));
                if (!this.matchKind(TokenKind.Comma)) break;
            }
            this.matchKind(TokenKind.RParen);
        }

        let typeText = "";
        if (this.matchKind(TokenKind.Colon)) {
            typeText = this.parseTypeText();
        }

        let body: Stmt = null as Stmt;
        let hasBody = false;
        if (this.peekKind() == TokenKind.LBrace) {
            body = this.parseBlockStmt();
            hasBody = true;
        } else {
            this.matchKind(TokenKind.Semicolon);
        }

        let kind: string = "FieldDecl";
        if (hasBody) {
            if (isConstructor) {
                kind = "ConstructorDecl";
            } else {
                kind = "MethodDecl";
            }
        }
        
        let m = new ClassMemberDecl(kind, name, "", isPublic, isPrivate, isProtected, isStatic, false, isConstructor, "", new Array<string>(), "", params, "", "", "", typeText, hasBody, 0, 0, 0, 0, 0, 0, 0, body);
        return m;
    }

    @unsafe private parseBlockStmt(): BlockStmt {
        log("--- ASTParser.parseBlockStmt: entering");
        this.matchKind(TokenKind.LBrace);
        log("--- ASTParser.parseBlockStmt: LBrace matched");
        let statements = new Array<Stmt>();
        log("--- ASTParser.parseBlockStmt: statements array created");
        while (!this.check(TokenKind.RBrace) && !this.isAtEnd()) {
            let oldPos = this.pos;
            log("--- ASTParser.parseBlockStmt: parsing statement");
            this.pushStmt(statements, this.parseStatement());
            log("--- ASTParser.parseBlockStmt: statement parsed");
            if (this.pos == oldPos) {
                log("parseBlockStmt: ERROR - pos did not advance, kind:");
                print_i32(this.peekKind());
                this.advance();
            }
        }
        log("--- ASTParser.parseBlockStmt: loop ended");
        this.matchKind(TokenKind.RBrace);
        log("--- ASTParser.parseBlockStmt: RBrace matched");
        let resBlock = new BlockStmt(statements);
        log("--- ASTParser.parseBlockStmt: BlockStmt successfully created");
        class_incref(resBlock);
        class_incref(resBlock);
        return resBlock;
    }

    @unsafe private parseStatement(): Stmt {
        if (this.matchKind(TokenKind.Let) || this.matchKind(TokenKind.Const)) {
            return this.parseVarDeclStmt();
        }
        if (this.matchKind(TokenKind.Return)) {
            let expr: Expr = null as Expr;
            if (!this.check(TokenKind.Semicolon)) expr = this.parseExpression();
            this.matchKind(TokenKind.Semicolon);
            return new ReturnStmt(expr);
        }
        if (this.matchKind(TokenKind.If)) {
            this.matchKind(TokenKind.LParen);
            let cond = this.parseExpression();
            this.matchKind(TokenKind.RParen);
            let then = this.parseStatement();
            let els: Stmt = null as Stmt;
            if (this.matchKind(TokenKind.Else)) els = this.parseStatement();
            return new IfStmt(cond, then, els);
        }
        if (this.matchKind(TokenKind.While)) {
            this.matchKind(TokenKind.LParen);
            let cond = this.parseExpression();
            this.matchKind(TokenKind.RParen);
            let body = this.parseStatement();
            return new WhileStmt(cond, body);
        }
        if (this.check(TokenKind.LBrace)) {
            return this.parseBlockStmt();
        }
        
        if (this.check(TokenKind.RBrace) || this.check(TokenKind.Semicolon) || this.isAtEnd()) {
            if (this.matchKind(TokenKind.Semicolon)) {
                return new ExprStmt(null as Expr);
            }
            return new ExprStmt(null as Expr);
        }
        
        let expr = this.parseExpression();
        this.matchKind(TokenKind.Semicolon);
        return new ExprStmt(expr);
    }

    @unsafe private parseVarDeclStmt(): VarDeclStmt {
        let name = this.advanceLexeme();
        let typeText = "";
        if (this.matchKind(TokenKind.Colon)) typeText = this.parseTypeText();
        let init: Expr = null as Expr;
        if (this.matchKind(TokenKind.Equal)) init = this.parseExpression();
        this.matchKind(TokenKind.Semicolon);
        return new VarDeclStmt(name, typeText, init, false);
    }

    @unsafe private parseExpression(): Expr {
        return this.parseAssignment();
    }

    @unsafe private parseAssignment(): Expr {
        let left = this.parseEquality();
        if (this.matchKind(TokenKind.Equal)) {
            let right = this.parseAssignment();
            return new BinaryExpr("=", left, right);
        }
        return left;
    }

    @unsafe private parseEquality(): Expr {
        let left = this.parseAdditive();
        while (this.peekKind() == TokenKind.EqualEqual || this.peekKind() == TokenKind.BangEqual) {
            let op = this.advanceLexeme();
            let right = this.parseAdditive();
            left = new BinaryExpr(op, left, right);
        }
        return left;
    }

    @unsafe private parseAdditive(): Expr {
        let left = this.parseMultiplicative();
        while (this.peekKind() == TokenKind.Plus || this.peekKind() == TokenKind.Minus) {
            let op = this.advanceLexeme();
            let right = this.parseMultiplicative();
            left = new BinaryExpr(op, left, right);
        }
        return left;
    }

    @unsafe private parseMultiplicative(): Expr {
        let left = this.parseUnary();
        while (this.peekKind() == TokenKind.Star || this.peekKind() == TokenKind.Slash) {
            let op = this.advanceLexeme();
            let right = this.parseUnary();
            left = new BinaryExpr(op, left, right);
        }
        return left;
    }

    @unsafe private parseUnary(): Expr {
        if (this.matchKind(TokenKind.Bang) || this.matchKind(TokenKind.Minus)) {
            let op = this.previousLexeme();
            let operand = this.parseUnary();
            return new UnaryExpr(op, operand, true);
        }
        return this.parsePostfix();
    }

    @unsafe private parsePostfix(): Expr {
        let expr = this.parsePrimary();
        while (true) {
            if (this.matchKind(TokenKind.LParen)) {
                let args = new Array<Expr>();
                while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                    this.pushExpr(args, this.parseExpression());
                    if (!this.matchKind(TokenKind.Comma)) break;
                }
                this.matchKind(TokenKind.RParen);
                expr = new CallExpr(expr, args, new Array<string>());
            } else if (this.matchKind(TokenKind.Dot)) {
                let name = this.advanceLexeme();
                expr = new MemberExpr(expr, name);
            } else if (this.matchKind(TokenKind.LBracket)) {
                let index = this.parseExpression();
                this.matchKind(TokenKind.RBracket);
                expr = new IndexExpr(expr, index);
            } else break;
        }
        return expr;
    }

    @unsafe private parsePrimary(): Expr {
        if (this.matchKind(TokenKind.Number)) return new NumberLiteral(this.previousLexeme());
        if (this.matchKind(TokenKind.String)) return new StringLiteral(this.previousLexeme());
        if (this.matchKind(TokenKind.Identifier)) return new IdentifierExpr(this.previousLexeme());
        if (this.matchKind(TokenKind.This)) return new ThisExpr();
        if (this.matchKind(TokenKind.New)) {
            let name = this.advanceLexeme();
            let args = new Array<Expr>();
            if (this.matchKind(TokenKind.LParen)) {
                while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                    this.pushExpr(args, this.parseExpression());
                    if (!this.matchKind(TokenKind.Comma)) break;
                }
                this.matchKind(TokenKind.RParen);
            }
            return new NewExpr(name, args, new Array<string>());
        }
        if (this.matchKind(TokenKind.LParen)) {
            let expr = this.parseExpression();
            this.matchKind(TokenKind.RParen);
            return expr;
        }
        
        if (!this.isAtEnd() && !this.check(TokenKind.Semicolon) && !this.check(TokenKind.RBrace)) {
            this.advance();
        }
        return null as Expr;
    }

    @unsafe private parseTypeText(): string {
        let res = "";
        while (!this.isAtEnd()) {
            let k = this.peekKind();
            if (k == TokenKind.RParen || k == TokenKind.Comma || k == TokenKind.RBrace || k == TokenKind.Semicolon || k == TokenKind.Equal || k == TokenKind.LBrace) break;
            let lex = this.advanceLexeme();
            res = res + lex;
        }
        // Double incref: one canceled by @unsafe cleanup, one stays for caller
        class_incref(res);
        class_incref(res);
        return res;
    }

    @unsafe private skipUntil(kind: i32): void {
        while (!this.isAtEnd() && !this.check(kind)) this.advance();
    }

    @unsafe private matchKind(kind: i32): bool {
        if (this.check(kind)) { 
            this.pos = this.pos + 1; 
            return true; 
        }
        return false;
    }

    @unsafe private check(kind: i32): bool {
        if (this.tokens == null) { return false; }
        if (this.isAtEnd()) return kind == TokenKind.EOF;
        let t = this.tokens.get(this.pos);
        if (t == null) { return false; }
        return t.kind == kind;
    }

    @unsafe private advance(): Token {
        if (this.tokens == null) {
            log("--- ASTParser.advance: ERROR - tokens is NULL!");
            return null as Token;
        }
        let t = this.tokens.get(this.pos);
        if (this.pos < this.tokens.length) {
            this.pos = this.pos + 1;
        }
        return t;
    }

    @unsafe private advanceLexeme(): string {
        if (this.tokens == null) { return ""; }
        let t = this.tokens.get(this.pos);
        if (this.pos < this.tokens.length) {
            this.pos = this.pos + 1;
        }
        if (t == null) { return ""; }
        let lex = t.lexeme;
        if (lex == null) { return ""; }
        class_incref(lex);
        class_incref(lex);
        return lex;
    }

    @unsafe private previousLexeme(): string {
        if (this.tokens == null) { return ""; }
        let t = this.tokens.get(this.pos - 1);
        if (t == null) { return ""; }
        class_incref(t);
        let lex = t.lexeme;
        if (lex == null) { return ""; }
        class_incref(lex);
        class_incref(lex);
        return lex;
    }

    @unsafe private previousLexeme(): string {
        if (this.tokens == null) { return ""; }
        let t = this.tokens.get(this.pos - 1);
        if (t == null) { return ""; }
        class_incref(t);
        let lex = t.lexeme;
        if (lex == null) { return ""; }
        class_incref(lex);
        class_incref(lex);
        return lex;
    }

    @unsafe private peekKind(): i32 {
        if (this.tokens == null) { return TokenKind.EOF; }
        if (this.pos >= this.tokens.length) { return TokenKind.EOF; }
        let t = this.tokens.get(this.pos);
        if (t == null) { return TokenKind.EOF; }
        return t.kind;
    }

    @unsafe private isAtEnd(): bool {
        if (this.tokens == null) {
            log("--- ASTParser.isAtEnd: ERROR - tokens is NULL!");
            return true;
        }
        if (this.pos >= this.tokens.length) {
            return true;
        }
        let t = this.tokens.get(this.pos);
        if (t == null) return true;
        return t.kind == TokenKind.EOF;
    }

    @unsafe private peek(): Token {
        return this.tokens.get(this.pos);
    }

    @unsafe private previous(): Token {
        return this.tokens.get(this.pos - 1);
    }
}
