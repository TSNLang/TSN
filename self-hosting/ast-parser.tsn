declare function print_i32(n: i32): void;
import { log } from "std:console";
import { Array } from "std:array";
import { 
    Token, TokenKind, Program, Declaration, ClassMemberDecl, ParameterInfo,
    Stmt, BlockStmt, VarDeclStmt, ReturnStmt, IfStmt, WhileStmt, ForStmt, ExprStmt,
    Expr, BinaryExpr, UnaryExpr, IdentifierExpr, NumberLiteral, StringLiteral, BooleanLiteral,
    MemberExpr, CallExpr, NewExpr, ThisExpr, ArrayLiteral, IndexExpr
} from "./ast.tsn";

export class ASTParser {
    private tokens: Array<Token>;
    private pos: i32;

    constructor(tokens: Array<Token>) {
        this.tokens = tokens;
        this.pos = 0;
    }

    public parse(): Program {
        let declarations = new Array<Declaration>();
        while (!this.isAtEnd()) {
            let decl = this.parseDeclaration();
            if (decl != null) {
                declarations.push(decl);
            }
        }
        return new Program(declarations);
    }

    private parseDeclaration(): Declaration {
        let isExported = this.matchKind(TokenKind.Export);
        let isDeclare = this.matchKind(TokenKind.Declare);
        
        if (this.matchKind(TokenKind.Import)) {
            return this.parseImportDecl();
        }
        
        if (this.matchKind(TokenKind.Function)) {
            return this.parseFunctionDecl(isExported, isDeclare);
        }
        
        if (this.matchKind(TokenKind.Class)) {
            return this.parseClassDecl(isExported, isDeclare);
        }
        
        if (!this.isAtEnd()) {
            this.advance();
        }
        return null as Declaration;
    }

    private parseImportDecl(): Declaration {
        let defaultImport = "";
        let namespaceImport = "";
        let namedImports = new Array<any>(); // Tạm thời
        
        if (this.peek().kind == TokenKind.Identifier) {
            defaultImport = this.advance().lexeme;
            this.matchKind(TokenKind.Comma);
        }
        
        if (this.matchKind(TokenKind.LBrace)) {
            while (!this.check(TokenKind.RBrace) && !this.isAtEnd()) {
                this.advance(); // Skip specifiers for now
                if (!this.matchKind(TokenKind.Comma)) break;
            }
            this.matchKind(TokenKind.RBrace);
        } else if (this.matchKind(TokenKind.Star)) {
            this.matchKind(TokenKind.As);
            namespaceImport = this.advance().lexeme;
        }
        
        this.matchKind(TokenKind.From);
        let source = "";
        if (this.peek().kind == TokenKind.String) {
            source = this.advance().lexeme;
        }
        this.matchKind(TokenKind.Semicolon);
        
        return new Declaration("ImportDecl", source, defaultImport, namespaceImport, "", new Array<ClassMemberDecl>());
    }

    private parseFunctionDecl(isExported: bool, isDeclare: bool): Declaration {
        let name = "";
        if (this.peek().kind == TokenKind.Identifier) {
            name = this.advance().lexeme;
        }
        
        if (this.matchKind(TokenKind.Less)) {
            this.skipUntil(TokenKind.Greater);
            this.matchKind(TokenKind.Greater);
        }
        
        let params = new Array<ParameterInfo>();
        if (this.matchKind(TokenKind.LParen)) {
            while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                let pName = this.advance().lexeme;
                let pType = "";
                if (this.matchKind(TokenKind.Colon)) pType = this.parseTypeText();
                params.push(new ParameterInfo(pName, pType, false));
                if (!this.matchKind(TokenKind.Comma)) break;
            }
            this.matchKind(TokenKind.RParen);
        }
        
        if (this.matchKind(TokenKind.Colon)) {
            this.parseTypeText();
        }
        
        let body: Stmt = null as Stmt;
        if (isDeclare) {
            this.matchKind(TokenKind.Semicolon);
        } else {
            body = this.parseBlockStmt();
        }
        
        let decl = new Declaration("FunctionDecl", name, "", "", "", new Array<ClassMemberDecl>());
        decl.params = params;
        decl.body = body;
        return decl;
    }

    private parseClassDecl(isExported: bool, isDeclare: bool): Declaration {
        let name = "";
        if (this.peek().kind == TokenKind.Identifier) {
            name = this.advance().lexeme;
        }
        
        if (this.matchKind(TokenKind.Less)) {
            this.skipUntil(TokenKind.Greater);
            this.matchKind(TokenKind.Greater);
        }
        
        let members = new Array<ClassMemberDecl>();
        if (this.matchKind(TokenKind.LBrace)) {
            while (!this.check(TokenKind.RBrace) && !this.isAtEnd()) {
                members.push(this.parseClassMember());
            }
            this.matchKind(TokenKind.RBrace);
        }
        
        return new Declaration("ClassDecl", name, "", "", "", members);
    }

    private parseClassMember(): ClassMemberDecl {
        let isPublic = false;
        let isPrivate = false;
        let isProtected = false;
        let isStatic = false;
        
        while (true) {
            let k = this.peek().kind;
            if (k == TokenKind.Public) { isPublic = true; this.advance(); }
            else if (k == TokenKind.Private) { isPrivate = true; this.advance(); }
            else if (k == TokenKind.Protected) { isProtected = true; this.advance(); }
            else if (k == TokenKind.Static) { isStatic = true; this.advance(); }
            else break;
        }

        let isConstructor = this.matchKind(TokenKind.Constructor);
        let name = "";
        if (!isConstructor) {
            name = this.advance().lexeme;
        } else {
            name = "constructor";
        }

        let params = new Array<ParameterInfo>();
        if (this.matchKind(TokenKind.LParen)) {
            while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                let pName = this.advance().lexeme;
                let pType = "";
                if (this.matchKind(TokenKind.Colon)) pType = this.parseTypeText();
                params.push(new ParameterInfo(pName, pType, false));
                if (!this.matchKind(TokenKind.Comma)) break;
            }
            this.matchKind(TokenKind.RParen);
        }

        let typeText = "";
        if (this.matchKind(TokenKind.Colon)) {
            typeText = this.parseTypeText();
        }

        let body: Stmt = null as Stmt;
        let hasBody = false;
        if (this.peek().kind == TokenKind.LBrace) {
            body = this.parseBlockStmt();
            hasBody = true;
        } else {
            this.matchKind(TokenKind.Semicolon);
        }

        let kind: string = "FieldDecl";
        if (hasBody) {
            if (isConstructor) {
                kind = "ConstructorDecl";
            } else {
                kind = "MethodDecl";
            }
        }
        
        let m = new ClassMemberDecl(kind, name, "", isPublic, isPrivate, isProtected, isStatic, false, isConstructor, "", new Array<string>(), "", params, "", "", "", typeText, hasBody, 0, 0, 0, 0, 0, 0, 0, body);
        return m;
    }

    private parseBlockStmt(): BlockStmt {
        this.matchKind(TokenKind.LBrace);
        let statements = new Array<Stmt>();
        while (!this.check(TokenKind.RBrace) && !this.isAtEnd()) {
            let oldPos = this.pos;
            statements.push(this.parseStatement());
            if (this.pos == oldPos) {
                log("parseBlockStmt: ERROR - pos did not advance at token:");
                log(this.peek().lexeme);
                log("token kind:");
                print_i32(this.peek().kind);
                this.advance();
            }
        }
        this.matchKind(TokenKind.RBrace);
        return new BlockStmt(statements);
    }

    private parseStatement(): Stmt {
        if (this.matchKind(TokenKind.Let) || this.matchKind(TokenKind.Const)) {
            return this.parseVarDeclStmt();
        }
        if (this.matchKind(TokenKind.Return)) {
            let expr: Expr = null as Expr;
            if (!this.check(TokenKind.Semicolon)) expr = this.parseExpression();
            this.matchKind(TokenKind.Semicolon);
            return new ReturnStmt(expr);
        }
        if (this.matchKind(TokenKind.If)) {
            this.matchKind(TokenKind.LParen);
            let cond = this.parseExpression();
            this.matchKind(TokenKind.RParen);
            let then = this.parseStatement();
            let els: Stmt = null as Stmt;
            if (this.matchKind(TokenKind.Else)) els = this.parseStatement();
            return new IfStmt(cond, then, els);
        }
        if (this.matchKind(TokenKind.While)) {
            this.matchKind(TokenKind.LParen);
            let cond = this.parseExpression();
            this.matchKind(TokenKind.RParen);
            let body = this.parseStatement();
            return new WhileStmt(cond, body);
        }
        if (this.check(TokenKind.LBrace)) {
            return this.parseBlockStmt();
        }
        
        if (this.check(TokenKind.RBrace) || this.isAtEnd()) {
            return new ExprStmt(null as Expr);
        }
        
        let expr = this.parseExpression();
        this.matchKind(TokenKind.Semicolon);
        return new ExprStmt(expr);
    }

    private parseVarDeclStmt(): VarDeclStmt {
        let name = this.advance().lexeme;
        let typeText = "";
        if (this.matchKind(TokenKind.Colon)) typeText = this.parseTypeText();
        let init: Expr = null as Expr;
        if (this.matchKind(TokenKind.Equal)) init = this.parseExpression();
        this.matchKind(TokenKind.Semicolon);
        return new VarDeclStmt(name, typeText, init, false);
    }

    private parseExpression(): Expr {
        return this.parseAssignment();
    }

    private parseAssignment(): Expr {
        let left = this.parseEquality();
        if (this.matchKind(TokenKind.Equal)) {
            let right = this.parseAssignment();
            return new BinaryExpr("=", left, right);
        }
        return left;
    }

    private parseEquality(): Expr {
        let left = this.parseAdditive();
        while (this.peek().kind == TokenKind.EqualEqual || this.peek().kind == TokenKind.BangEqual) {
            let op = this.advance().lexeme;
            let right = this.parseAdditive();
            left = new BinaryExpr(op, left, right);
        }
        return left;
    }

    private parseAdditive(): Expr {
        let left = this.parseMultiplicative();
        while (this.peek().kind == TokenKind.Plus || this.peek().kind == TokenKind.Minus) {
            let op = this.advance().lexeme;
            let right = this.parseMultiplicative();
            left = new BinaryExpr(op, left, right);
        }
        return left;
    }

    private parseMultiplicative(): Expr {
        let left = this.parseUnary();
        while (this.peek().kind == TokenKind.Star || this.peek().kind == TokenKind.Slash) {
            let op = this.advance().lexeme;
            let right = this.parseUnary();
            left = new BinaryExpr(op, left, right);
        }
        return left;
    }

    private parseUnary(): Expr {
        if (this.matchKind(TokenKind.Bang) || this.matchKind(TokenKind.Minus)) {
            let op = this.previous().lexeme;
            let operand = this.parseUnary();
            return new UnaryExpr(op, operand, true);
        }
        return this.parsePostfix();
    }

    private parsePostfix(): Expr {
        let expr = this.parsePrimary();
        while (true) {
            if (this.matchKind(TokenKind.LParen)) {
                let args = new Array<Expr>();
                while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                    args.push(this.parseExpression());
                    if (!this.matchKind(TokenKind.Comma)) break;
                }
                this.matchKind(TokenKind.RParen);
                expr = new CallExpr(expr, args, new Array<string>());
            } else if (this.matchKind(TokenKind.Dot)) {
                let name = this.advance().lexeme;
                expr = new MemberExpr(expr, name);
            } else if (this.matchKind(TokenKind.LBracket)) {
                let index = this.parseExpression();
                this.matchKind(TokenKind.RBracket);
                expr = new IndexExpr(expr, index);
            } else break;
        }
        return expr;
    }

    private parsePrimary(): Expr {
        if (this.matchKind(TokenKind.Number)) return new NumberLiteral(this.previous().lexeme);
        if (this.matchKind(TokenKind.String)) return new StringLiteral(this.previous().lexeme);
        if (this.matchKind(TokenKind.Identifier)) return new IdentifierExpr(this.previous().lexeme);
        if (this.matchKind(TokenKind.This)) return new ThisExpr();
        if (this.matchKind(TokenKind.New)) {
            let name = this.advance().lexeme;
            let args = new Array<Expr>();
            if (this.matchKind(TokenKind.LParen)) {
                while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                    args.push(this.parseExpression());
                    if (!this.matchKind(TokenKind.Comma)) break;
                }
                this.matchKind(TokenKind.RParen);
            }
            return new NewExpr(name, args, new Array<string>());
        }
        if (this.matchKind(TokenKind.LParen)) {
            let expr = this.parseExpression();
            this.matchKind(TokenKind.RParen);
            return expr;
        }
        return null as Expr;
    }

    private parseTypeText(): string {
        let res = "";
        while (!this.isAtEnd()) {
            let k = this.peek().kind;
            if (k == TokenKind.RParen || k == TokenKind.Comma || k == TokenKind.RBrace || k == TokenKind.Semicolon || k == TokenKind.Equal || k == TokenKind.LBrace) break;
            res = res + this.advance().lexeme;
        }
        return res;
    }

    private skipUntil(kind: i32): void {
        while (!this.isAtEnd() && !this.check(kind)) this.advance();
    }

    private matchKind(kind: i32): bool {
        if (this.check(kind)) { this.advance(); return true; }
        return false;
    }

    private check(kind: i32): bool {
        if (this.isAtEnd()) return kind == TokenKind.EOF;
        return this.peek().kind == kind;
    }

    private advance(): Token {
        if (!this.isAtEnd()) this.pos = this.pos + 1;
        return this.previous();
    }

    private isAtEnd(): bool {
        if (this.pos >= this.tokens.length) {
            return true;
        }
        return this.peek().kind == TokenKind.EOF;
    }

    private peek(): Token {
        return this.tokens.get(this.pos);
    }

    private previous(): Token {
        return this.tokens.get(this.pos - 1);
    }
}
