import { log } from "std:console";
import { readText, writeText } from "std:fs";
import { args } from "std:os";
import { Lexer } from "./lexer.tsn";
import { ASTParser } from "./ast-parser.tsn";
import { Program, Token, TokenKind, Declaration } from "./ast.tsn";
import { Array } from "std:array";
import { MIRBuilder } from "./mir-builder.tsn";
import { MIRCodegen } from "./mir-codegen.tsn";
import { MIRType } from "./mir.tsn";

export class CompilerState {
    public source: string;
    public tokens: Array<Token>;
    
    constructor() {
        this.source = "";
        this.tokens = null as Array<Token>;
    }
}

function logBool(label: string, value: bool): void {
    log(label);
    if (value) {
        log("true");
        return;
    }
    log("false");
}

@unsafe function parseFile(state: CompilerState, path: string): Program {
    let fsResult = readText(path);
    if (!fsResult.isOk()) {
        log("Error: could not read file: ");
        log(path);
        return null as Program;
    }

    state.source = fsResult.value();
    class_incref(state.source);
    let lexer = new Lexer(state.source);
    state.tokens = lexer.tokenize();
    if (state.tokens.length == 0) {
        log("Error: no tokens generated from file");
        return null as Program;
    }
    let parser = new ASTParser(state.tokens);
    
    // Inline parse logic using parser.pos directly
    let declarations = new Array<Declaration>();
    while (parser.pos < state.tokens.length) {
        let t = state.tokens.get(parser.pos);
        if (t == null || t.kind == TokenKind.EOF) {
            break;
        }
        let decl = parser.parseDeclaration();
        if (decl != null) {
            declarations.push(decl);
        }
    }
    let astProgram = new Program(declarations);
    class_incref(astProgram);
    class_incref(astProgram);

    let decls_count = declarations.length;
    if (decls_count == 0) {
        log("Error: no declarations found in file: ");
        log(path);
        return null as Program;
    }

    return astProgram;
}

@unsafe function main(): i32 {
    let argIt = args();
    let argList = argIt.toArray();

    if (argList.length < 2) {
        log("Usage: tsnc <input.tsn> [-o <output.ll>]");
        return 1;
    }

    let inputPath = argList.get(1);
    class_incref(inputPath);
    if (inputPath == "-h" || inputPath == "--help") {
        log("Usage: tsnc <input.tsn> [-o <output.ll>]");
        return 0;
    }

    let outputPath = "";
    let i = 2;
    while (i < argList.length) {
        let arg = argList.get(i);
        class_incref(arg);
        if (arg == "-o" && i + 1 < argList.length) {
            outputPath = argList.get(i + 1);
            class_incref(outputPath);
            i = i + 2;
        } else {
            i = i + 1;
        }
    }

    log("=== TSN SELF-HOSTING COMPILER ===");
    log("Compiling file:");
    log(inputPath);
    if (outputPath != "") {
        log("Output path:");
        log(outputPath);
    }

    let state = new CompilerState();
    let astProgram = parseFile(state, inputPath);
    if (astProgram == null) {
        log("Compilation failed during parsing.");
        return 1;
    }

    log("=== PARSED SUCCESSFULLY BY SELF-HOSTED COMPILER ===");

    log("=== BUILDING MIR FROM AST ===");
    let mirBuilder = new MIRBuilder(inputPath);
    let mirModule = mirBuilder.build(astProgram);
    log("=== MIR BUILD COMPLETE ===");

    log("=== GENERATING LLVM IR FROM MIR ===");
    let codegen = new MIRCodegen(mirModule);
    let ir = codegen.generate();
    log("=== LLVM IR GENERATION COMPLETE ===");
    
    log("Generated IR length:");
    print_i32(ir.length);

    if (outputPath != "") {
        log("Writing LLVM IR to file...");
        let writeRes = writeText(outputPath, ir);
        if (!writeRes.isOk()) {
            log("FAILED to write output file!");
            return 1;
        }
        log("✓ Successfully wrote output file!");
    }

    return 0;
}

