import { log } from "std:console";
import { readText } from "std:fs";
import { Lexer } from "./lexer.tsn";
import { Parser } from "./parser.tsn";
import { Program } from "./ast.tsn";
import { MIRBuilder } from "./mir-builder.tsn";
import { MIRCodegen } from "./mir-codegen.tsn";
import { MIRType } from "./mir.tsn";

function logBool(label: string, value: bool): void {
    log(label);
    if (value) {
        log("true");
        return;
    }
    log("false");
}

function parseFile(path: string): i32 {
    let fsResult = readText(path);
    if (!fsResult.isOk()) {
        log("parse FAILED: could not read file");
        log(path);
        return 1;
    }

    let source = fsResult.value();
    let lexer = new Lexer(source);
    let tokens = lexer.tokenize();
    if (tokens.length == 0) {
        log("parse FAILED: no tokens generated");
        return 1;
    }
    let parser = new Parser(tokens);
    let program = parser.parse();

    if (program.declarations.length == 0) {
        log("parse FAILED: no declarations found in file");
        log(path);
        return 1;
    }

    log("parsed file");
    log(path);
    log("declaration count");
    log(program.declarations.length);
    log("class count");
    log(program.classDecls.length);
    log("function count");
    log(program.functionDecls.length);
    
    return 0;
}

function main(): i32 {
    log("=== TSN SELF-HOSTING COMPILER (PARSER PHASE) ===");
    if (parseFile("d:\\project\\TSN\\self-hosting\\parser.tsn") != 0) return 1;
    if (parseFile("d:\\project\\TSN\\self-hosting\\lexer.tsn") != 0) return 1;
    if (parseFile("d:\\project\\TSN\\self-hosting\\ast.tsn") != 0) return 1;
    if (parseFile("d:\\project\\TSN\\self-hosting\\main.tsn") != 0) return 1;
    
    log("=== ALL FILES PARSED SUCCESSFULLY BY SELF-HOSTED COMPILER ===");

    log("=== RUNNING SELF-HOSTED CODEGEN SMOKE TEST ===");
    let builder = new MIRBuilder("smoke_test");
    builder.createFunction("test_func", new MIRType("i32", false, 4));
    let entryBlock = builder.createBasicBlock("smoke_entry");
    builder.setInsertPoint(entryBlock);
    let c1 = builder.createConstant("42", new MIRType("i32", false, 4));
    builder.createReturn(c1);

    let codegen = new MIRCodegen(builder.getModule());
    let ir = codegen.generate();
    log("Generated LLVM IR:");
    log(ir);

    return 0;
}

