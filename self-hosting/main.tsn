import { log } from "std:console";
import { readText } from "std:fs";
import { args } from "std:os";
import { Lexer } from "./lexer.tsn";
import { ASTParser } from "./ast-parser.tsn";
import { ASTProgram } from "./ast.tsn";
import { MIRBuilder } from "./mir-builder.tsn";
import { MIRCodegen } from "./mir-codegen.tsn";
import { MIRType } from "./mir.tsn";

function logBool(label: string, value: bool): void {
    log(label);
    if (value) {
        log("true");
        return;
    }
    log("false");
}

function parseFile(path: string): ASTProgram {
    log("--- parseFile: start reading");
    log(path);
    let fsResult = readText(path);
    if (!fsResult.isOk()) {
        log("parse FAILED: could not read file");
        return null as ASTProgram;
    }

    log("--- parseFile: read success, starting lexer");
    let source = fsResult.value();
    let lexer = new Lexer(source);
    let tokens = lexer.tokenize();
    log("--- parseFile: tokenize success");
    if (tokens.length == 0) {
        log("parse FAILED: no tokens generated");
        return null as ASTProgram;
    }
    log("--- parseFile: starting parser constructor");
    log("tokens length check before parser:");
    print_i32(tokens.length);
    let parser = new ASTParser(tokens);
    let astProgram: ASTProgram = parser.parse();
    log("--- parseFile: parse success");

    let decls_count = astProgram.declarations.length;
    log("--- declarations count:");
    print_i32(decls_count);

    if (decls_count == 0) {
        log("parse FAILED: no declarations found in file");
        log(path);
        return null as ASTProgram;
    }

    log("parsed file");
    log(path);
    
    return astProgram;
}

function main(): i32 {
    let argIt = args();
    let argList = argIt.toArray();

    if (argList.length < 2) {
        log("Usage: tsnc <input.tsn>");
        return 1;
    }

    let inputPath = argList.get(1);
    if (inputPath == "-h" || inputPath == "--help") {
        log("Usage: tsnc <input.tsn>");
        return 0;
    }

    log("=== TSN SELF-HOSTING COMPILER ===");
    log("Compiling file:");
    log(inputPath);

    let astProgram = parseFile(inputPath);
    if (astProgram == null) {
        log("Compilation failed during parsing.");
        return 1;
    }

    log("=== PARSED SUCCESSFULLY BY SELF-HOSTED COMPILER ===");

    log("=== BUILDING MIR FROM AST ===");
    let mirBuilder = new MIRBuilder(inputPath);
    let mirModule = mirBuilder.build(astProgram);
    log("=== MIR BUILD COMPLETE ===");

    log("=== GENERATING LLVM IR FROM MIR ===");
    let codegen = new MIRCodegen(mirModule);
    let ir = codegen.generate();
    log("=== LLVM IR GENERATION COMPLETE ===");
    
    log("Generated IR length:");
    print_i32(ir.length);

    log("=== RUNNING SELF-HOSTED CODEGEN SMOKE TEST ===");
    let builder = new MIRBuilder("smoke_test");
    builder.createFunction("test_func", new MIRType("i32", false, 4));
    let entryBlock = builder.createBasicBlock("smoke_entry");
    builder.setInsertPoint(entryBlock);
    let c1 = builder.createConstant("42", new MIRType("i32", false, 4));
    builder.createReturn(c1);

    let codegen = new MIRCodegen(builder.getModule());
    let ir = codegen.generate();
    log("Generated LLVM IR:");
    log(ir);

    return 0;
}

