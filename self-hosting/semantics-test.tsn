declare function print_i32(n: i32): void;
import { SemanticAnalyzer, Symbol, Scope } from "./semantics.tsn";
import { Program, Declaration } from "./ast.tsn";
import { Array } from "std:array";
import { log } from "std:console";

function main(): i32 {
    log("Semantics-Test: Starting...");
    let analyzer = new SemanticAnalyzer();
    
    let declarations = new Array<Declaration>();
    let program = new Program(declarations);
    
    analyzer.analyze(program);
    log("Semantics-Test: Empty program analysis passed");
    
    return 0;
}

