declare function print_i32(n: i32): void;
declare function print_ptr(s: string): void;
import { Array } from "std:array";
import { log } from "std:console";
import { Lexer } from "./lexer.tsn";
import { ASTParser } from "./ast-parser.tsn";
import { MIRBuilder } from "./mir-builder.tsn";
import { MIRModule } from "./mir.tsn";
import { MIRCodegen } from "./mir-codegen.tsn";

function main(): i32 {
    let source = "function test() { return 1; } class MyClass { public method() { return 2; } }";
    log("MIR-Test: Starting Lexer...");
    let lexer = new Lexer(source);
    let tokens = lexer.tokenize();
    
    log("MIR-Test: Starting Parser...");
    let parser = new ASTParser(tokens);
    let program = parser.parse();
    
    log("MIR-Test: Starting MIRBuilder...");
    let builder = new MIRBuilder("main_module");
    let mirModule = builder.build(program);
    
    log("MIR-Test: MIR Module Name: " + mirModule.name);
    
    log("MIR-Test: Starting MIRCodegen...");
    let codegen = new MIRCodegen(mirModule);
    let llvmIR = codegen.generate();
    
    log("Generated LLVM IR (Length):");
    print_i32(llvmIR.length);
    log("MIR-Test completed successfully!");
    return 0;
}
