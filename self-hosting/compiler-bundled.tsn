// ===== From mir-flat.tsn =====

declare function print_i32(n: i32): void;
// MIR (Mid-level Intermediate Representation) for TSN
// A simplified IR that bridges AST and LLVM IR
// REFACTORED: No inheritance - flat class structures




// MIR Types

class MIRType {
    public name: string;
    public isPointer: bool;
    public size: i32;

    constructor(name: string, isPointer: bool, size: i32) {
        this.name = name;
        this.isPointer = isPointer;
        this.size = size;
    }
}

// MIR Values - FLATTENED (was MIRValue + 3 derived classes)

class MIRValue {
    public kind: string;  // "Constant", "Register", "Global"
    public valueType: MIRType;
    public name: string;
    
    // From MIRConstant:
    public constantValue: string;
    
    // From MIRRegister:
    public registerId: i32;
    
    // From MIRGlobal:
    public globalName: string;

    constructor(kind: string, valueType: MIRType, name: string) {
        this.kind = kind;
        this.valueType = valueType;
        this.name = name;
        this.constantValue = "";
        this.registerId = 0;
        this.globalName = "";
    }
}

// Factory functions for MIRValue variants
function createConstant(valueType: MIRType, value: string): MIRValue {
    let v = new MIRValue("Constant", valueType, "");
    v.constantValue = value;
    return v;
}

function createRegister(valueType: MIRType, id: i32): MIRValue {
    let v = new MIRValue("Register", valueType, "");
    v.registerId = id;
    return v;
}

function createGlobal(valueType: MIRType, globalName: string): MIRValue {
    let v = new MIRValue("Global", valueType, globalName);
    v.globalName = globalName;
    return v;
}

// MIR Instructions - FLATTENED (was MIRInst + 13 derived classes)

class MIRInst {
    public opcode: string;  // "Binary", "Load", "Store", "Call", "Return", etc.
    public result: MIRValue;
    
    // Fields from all derived instruction types:
    // From MIRBinaryInst:
    public binaryOp: string;
    public leftOperand: MIRValue;
    public rightOperand: MIRValue;
    
    // From MIRLoadInst, MIRStoreInst, MIRGetElementPtrInst:
    public address: MIRValue;
    
    // From MIRStoreInst, MIRReturnInst, MIRIncrefInst, MIRDecrefInst, MIRIntToPtrInst, MIRPtrToIntInst:
    public value: MIRValue;
    
    // From MIRCallInst:
    public callee: string;
    public callArgs: Array<MIRValue>;
    
    // From MIRBranchInst:
    public condition: MIRValue;
    public trueBlock: i32;
    public falseBlock: i32;
    
    // From MIRJumpInst:
    public targetBlock: i32;
    
    // From MIRAllocaInst:
    public allocType: MIRType;
    
    // From MIRGetElementPtrInst:
    public basePtr: MIRValue;
    public indexValue: MIRValue;

    constructor(opcode: string, result: MIRValue) {
        this.opcode = opcode;
        this.result = result;
        
        // Initialize all fields to defaults:
        this.binaryOp = "";
        this.leftOperand = result;  // dummy
        this.rightOperand = result;  // dummy
        this.address = result;  // dummy
        this.value = result;  // dummy
        this.callee = "";
        this.callArgs = new Array<MIRValue>();
        this.condition = result;  // dummy
        this.trueBlock = 0;
        this.falseBlock = 0;
        this.targetBlock = 0;
        this.allocType = new MIRType("void", false, 0);
        this.basePtr = result;  // dummy
        this.indexValue = result;  // dummy
    }
}

// Factory functions for MIRInst variants

function createBinaryInst(op: string, result: MIRValue, left: MIRValue, right: MIRValue): MIRInst {
    let inst = new MIRInst("Binary", result);
    inst.binaryOp = op;
    inst.leftOperand = left;
    inst.rightOperand = right;
    return inst;
}

function createLoadInst(result: MIRValue, address: MIRValue): MIRInst {
    let inst = new MIRInst("Load", result);
    inst.address = address;
    return inst;
}

function createStoreInst(value: MIRValue, address: MIRValue): MIRInst {
    let voidReg = createRegister(new MIRType("void", false, 0), 0);
    let inst = new MIRInst("Store", voidReg);
    inst.value = value;
    inst.address = address;
    return inst;
}

@unsafe function createCallInst(result: MIRValue, callee: string, args: Array<MIRValue>): MIRInst {
    let inst = new MIRInst("Call", result);
    class_incref(args);
    inst.callee = callee;
    inst.callArgs = args;
    return inst;
}

function createReturnInst(value: MIRValue): MIRInst {
    let voidReg = createRegister(new MIRType("void", false, 0), 0);
    let inst = new MIRInst("Return", voidReg);
    inst.value = value;
    return inst;
}

function createBranchInst(condition: MIRValue, trueBlock: i32, falseBlock: i32): MIRInst {
    let voidReg = createRegister(new MIRType("void", false, 0), 0);
    let inst = new MIRInst("Branch", voidReg);
    inst.condition = condition;
    inst.trueBlock = trueBlock;
    inst.falseBlock = falseBlock;
    return inst;
}

function createJumpInst(targetBlock: i32): MIRInst {
    let voidReg = createRegister(new MIRType("void", false, 0), 0);
    let inst = new MIRInst("Jump", voidReg);
    inst.targetBlock = targetBlock;
    return inst;
}

function createAllocaInst(result: MIRValue, allocType: MIRType): MIRInst {
    let inst = new MIRInst("Alloca", result);
    inst.allocType = allocType;
    return inst;
}

function createGetElementPtrInst(result: MIRValue, base: MIRValue, index: MIRValue): MIRInst {
    let inst = new MIRInst("GetElementPtr", result);
    inst.basePtr = base;
    inst.indexValue = index;
    return inst;
}

function createIncrefInst(value: MIRValue): MIRInst {
    let voidReg = createRegister(new MIRType("void", false, 0), 0);
    let inst = new MIRInst("Incref", voidReg);
    inst.value = value;
    return inst;
}

function createDecrefInst(value: MIRValue): MIRInst {
    let voidReg = createRegister(new MIRType("void", false, 0), 0);
    let inst = new MIRInst("Decref", voidReg);
    inst.value = value;
    return inst;
}

function createIntToPtrInst(result: MIRValue, value: MIRValue): MIRInst {
    let inst = new MIRInst("IntToPtr", result);
    inst.value = value;
    return inst;
}

function createPtrToIntInst(result: MIRValue, value: MIRValue): MIRInst {
    let inst = new MIRInst("PtrToInt", result);
    inst.value = value;
    return inst;
}

// MIR Basic Block

class MIRBasicBlock {
    public id: i32;
    public label: string;
    public instructions: Array<MIRInst>;

    constructor(id: i32, label: string) {
        this.id = id;
        this.label = label;
        this.instructions = new Array<MIRInst>();
    }
}

// MIR Function

class MIRFunction {
    public name: string;
    public returnType: MIRType;
    public params: Array<MIRValue>;
    public blocks: Array<MIRBasicBlock>;
    public nextRegId: i32;
    public nextBlockId: i32;

    constructor(name: string, returnType: MIRType) {
        this.name = name;
        this.returnType = returnType;
        this.params = new Array<MIRValue>();
        this.blocks = new Array<MIRBasicBlock>();
        this.nextRegId = 0;
        this.nextBlockId = 0;
    }

    public createBlock(label: string): i32 {
        let block = new MIRBasicBlock(this.nextBlockId, label);
        let blockId = this.nextBlockId;
        this.nextBlockId = this.nextBlockId + 1;
        this.blocks.push(block);
        return blockId;
    }

    public createRegister(valueType: MIRType): MIRValue {
        let reg = createRegister(valueType, this.nextRegId);
        this.nextRegId = this.nextRegId + 1;
        return reg;
    }
}

// MIR Module

class MIRModule {
    public name: string;
    public functions: Array<MIRFunction>;
    public globals: Array<MIRValue>;

    constructor(name: string) {
        this.name = name;
        this.functions = new Array<MIRFunction>();
        this.globals = new Array<MIRValue>();
    }
}


// ===== From lexer.tsn =====






class Lexer {
    private source: string;
    private sourceLength: i32;
    private pos: i32;
    private line: i32;
    private column: i32;

    constructor(source: string) {
        this.source = source;
        this.sourceLength = source.length;
        this.pos = 0;
        this.line = 1;
        this.column = 1;
    }

    tokenize(): Array_Token {
        log("--- Lexer.tokenize: start");
        let tokens = new Array_Token();

        while (this.pos < this.sourceLength) {
            this.skipWhitespaceAndComments();
            if (this.pos >= this.sourceLength) {
                break;
            }

            let token = this.nextToken();
            tokens.push(token as ptr);
        }

        log("--- Lexer.tokenize: scan complete, adding EOF");
        tokens.push(new Token(TokenKind.EOF, "", this.line, this.column) as ptr);
        log("--- Lexer.tokenize: success");
        return tokens;
    }

    private nextToken(): Token {
        let line = this.line;
        let column = this.column;
        let ch = this.current();

        if (this.isDigit(ch)) {
            return this.readNumber(line, column);
        }

        if (this.isAlpha(ch)) {
            return this.readIdentifierOrKeyword(line, column);
        }

        if (ch == 34 || ch == 39) { // '"' || "'"
            return this.readString(ch, line, column);
        }

        if (ch == 64) { // '@'
            this.advance();
            return new Token(TokenKind.At, "@", line, column);
        }
        if (ch == 40) { // '('
            this.advance();
            return new Token(TokenKind.LParen, "(", line, column);
        }
        if (ch == 41) { // ')'
            this.advance();
            return new Token(TokenKind.RParen, ")", line, column);
        }
        if (ch == 123) { // '{'
            this.advance();
            return new Token(TokenKind.LBrace, "{", line, column);
        }
        if (ch == 125) { // '}'
            this.advance();
            return new Token(TokenKind.RBrace, "}", line, column);
        }
        if (ch == 91) { // '['
            this.advance();
            return new Token(TokenKind.LBracket, "[", line, column);
        }
        if (ch == 93) { // ']'
            this.advance();
            return new Token(TokenKind.RBracket, "]", line, column);
        }
        if (ch == 58) { // ':'
            this.advance();
            return new Token(TokenKind.Colon, ":", line, column);
        }
        if (ch == 59) { // ';'
            this.advance();
            return new Token(TokenKind.Semicolon, ";", line, column);
        }
        if (ch == 44) { // ','
            this.advance();
            return new Token(TokenKind.Comma, ",", line, column);
        }
        if (ch == 46) { // '.'
            this.advance();
            return new Token(TokenKind.Dot, ".", line, column);
        }
        if (ch == 61) { // '='
            this.advance();
            if (this.current() == 61) { // '=='
                this.advance();
                return new Token(TokenKind.EqualEqual, "==", line, column);
            }
            return new Token(TokenKind.Equal, "=", line, column);
        }
        if (ch == 33) { // '!'
            this.advance();
            if (this.current() == 61) { // '!='
                this.advance();
                return new Token(TokenKind.BangEqual, "!=", line, column);
            }
            return new Token(TokenKind.Bang, "!", line, column);
        }
        if (ch == 60) { // '<'
            this.advance();
            if (this.current() == 61) { // '<='
                this.advance();
                return new Token(TokenKind.LessEqual, "<=", line, column);
            }
            return new Token(TokenKind.Less, "<", line, column);
        }
        if (ch == 62) { // '>'
            this.advance();
            if (this.current() == 61) { // '>='
                this.advance();
                return new Token(TokenKind.GreaterEqual, ">=", line, column);
            }
            return new Token(TokenKind.Greater, ">", line, column);
        }
        if (ch == 43) { // '+'
            this.advance();
            return new Token(TokenKind.Plus, "+", line, column);
        }
        if (ch == 45) { // '-'
            this.advance();
            return new Token(TokenKind.Minus, "-", line, column);
        }
        if (ch == 42) { // '*'
            this.advance();
            return new Token(TokenKind.Star, "*", line, column);
        }
        if (ch == 47) { // '/'
            this.advance();
            return new Token(TokenKind.Slash, "/", line, column);
        }
        if (ch == 37) { // '%'
            this.advance();
            return new Token(TokenKind.Percent, "%", line, column);
        }
        if (ch == 38) { // '&'
            this.advance();
            if (this.current() == 38) { // '&&'
                this.advance();
                return new Token(TokenKind.AmpAmp, "&&", line, column);
            }
            return new Token(TokenKind.Amp, "&", line, column);
        }
        if (ch == 124) { // '|'
            this.advance();
            if (this.current() == 124) { // '||'
                this.advance();
                return new Token(TokenKind.PipePipe, "||", line, column);
            }
            return new Token(TokenKind.Pipe, "|", line, column);
        }
        if (ch == 94) { // '^'
            this.advance();
            return new Token(TokenKind.Caret, "^", line, column);
        }
        if (ch == 126) { // '~'
            this.advance();
            return new Token(TokenKind.Tilde, "~", line, column);
        }
        if (ch == 63) { // '?'
            this.advance();
            return new Token(TokenKind.Question, "?", line, column);
        }


        this.advance();
        return new Token(TokenKind.Unknown, "?", line, column);
    }

    private readNumber(line: i32, column: i32): Token {
        let start = this.pos;

        while (this.pos < this.sourceLength && this.isDigit(this.current())) {
            this.advance();
        }

        if (this.pos < this.sourceLength && this.current() == 46 && this.isDigit(this.peek())) { // '.'
            this.advance();
            while (this.pos < this.sourceLength && this.isDigit(this.current())) {
                this.advance();
            }
        }

        let text = this.source.slice(start, this.pos);
        return new Token(TokenKind.Number, text, line, column) as Token;
    }

    private readIdentifierOrKeyword(line: i32, column: i32): Token {
        let start = this.pos;

        while (this.pos < this.sourceLength && (this.isAlpha(this.current()) || this.isDigit(this.current()))) {
            this.advance();
        }

        let text = this.source.slice(start, this.pos);
        return new Token(this.getKeywordKind(text), text, line, column) as Token;
    }

    private readString(quote: i32, line: i32, column: i32): Token {
        let start = this.pos;
        this.advance();

        let text = "";
        while (this.pos < this.sourceLength && this.current() != quote) {
            if (this.current() == 92) { // '\\'
                this.advance();
                if (this.pos < this.sourceLength) {
                    let esc = this.current();
                    if (esc == 110) { // 'n'
                        text = text + "\n";
                    } else if (esc == 114) { // 'r'
                        text = text + "\r";
                    } else if (esc == 116) { // 't'
                        text = text + "\t";
                    } else if (esc == 48) { // '0'
                        text = text + "\0";
                    } else if (esc == 92) { // '\\'
                        text = text + "\\";
                    } else if (esc == 34) { // '"'
                        text = text + "\"";
                    } else if (esc == 39) { // '\''
                        text = text + "'";
                    } else {
                        text = text + "\\";
                        text = text + this.source.slice(this.pos, this.pos + 1);
                    }
                    this.advance();
                }
            } else {
                text = text + this.source.slice(this.pos, this.pos + 1);
                this.advance();
            }
        }

        if (this.current() == quote) {
            this.advance();
        }

        return new Token(TokenKind.String, text, line, column) as Token;
    }

    private getKeywordKind(text: string): i32 {
        if (text == "import") return TokenKind.Import;
        if (text == "export") return TokenKind.Export;
        if (text == "public") return TokenKind.Public;
        if (text == "private") return TokenKind.Private;
        if (text == "protected") return TokenKind.Protected;
        if (text == "static") return TokenKind.Static;
        if (text == "async") return TokenKind.Async;
        if (text == "from") return TokenKind.From;
        if (text == "as") return TokenKind.As;
        if (text == "extends") return TokenKind.Extends;
        if (text == "declare") return TokenKind.Declare;
        if (text == "function") return TokenKind.Function;
        if (text == "class") return TokenKind.Class;
        if (text == "constructor") return TokenKind.Constructor;
        if (text == "let") return TokenKind.Let;
        if (text == "const") return TokenKind.Const;
        if (text == "return") return TokenKind.Return;
        if (text == "if") return TokenKind.If;
        if (text == "else") return TokenKind.Else;
        if (text == "while") return TokenKind.While;
        if (text == "for") return TokenKind.For;
        if (text == "break") return TokenKind.Break;
        if (text == "continue") return TokenKind.Continue;
        if (text == "new") return TokenKind.New;
        if (text == "this") return TokenKind.This;
        return TokenKind.Identifier;
    }

    private skipWhitespaceAndComments(): void {
        while (this.pos < this.sourceLength) {
            let ch = this.current();

            if (ch == 32 || ch == 9 || ch == 13) { // ' ', '\t', '\r'
                this.advance();
                continue;
            }

            if (ch == 10) { // '\n'
                this.pos = this.pos + 1;
                this.line = this.line + 1;
                this.column = 1;
                continue;
            }

            if (ch == 47 && this.peek() == 47) { // '//'
                while (this.pos < this.sourceLength && this.current() != 10) {
                    this.advance();
                }
                continue;
            }

            if (ch == 47 && this.peek() == 42) { // '/*'
                this.advance();
                this.advance();
                while (this.pos < this.sourceLength) {
                    if (this.current() == 42 && this.peek() == 47) { // '*/'
                        this.advance();
                        this.advance();
                        break;
                    }
                    if (this.current() == 10) {
                        this.pos = this.pos + 1;
                        this.line = this.line + 1;
                        this.column = 1;
                    } else {
                        this.advance();
                    }
                }
                continue;
            }

            break;
        }
    }

    private current(): i32 {
        if (this.pos >= this.sourceLength) return -1;
        let ch = this.source.charCodeAt(this.pos);
        return ch;
    }

    private peek(): i32 {
        if (this.pos + 1 >= this.sourceLength) return -1;
        return this.source.charCodeAt(this.pos + 1);
    }

    private advance(): void {
        if (this.pos < this.sourceLength) {
            this.pos = this.pos + 1;
            this.column = this.column + 1;
        }
    }

    private isDigit(ch: i32): bool {
        return ch >= 48 && ch <= 57; // '0'-'9'
    }

    private isAlpha(ch: i32): bool {
        return (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || ch == 95; // 'a'-'z', 'A'-'Z', '_'
    }
}


// ===== From ast-parser.tsn =====

declare function print_i32(n: i32): void;




class ASTParser {
    private tokens: Array<Token>;
    private pos: i32;

    @unsafe private pushDecl(arr: Array<Declaration>, item: Declaration): void {
        log("--- pushDecl: enter");
        if (item != null) {
            log("--- pushDecl: incref item");
            class_incref(item);
        }
        log("--- pushDecl: calling arr.push");
        arr.push(item);
        log("--- pushDecl: done");
    }

    @unsafe private pushParam(arr: Array<ParameterInfo>, item: ParameterInfo): void {
        if (item != null) class_incref(item);
        arr.push(item);
    }

    @unsafe private pushMember(arr: Array<ClassMemberDecl>, item: ClassMemberDecl): void {
        if (item != null) class_incref(item);
        arr.push(item);
    }

    @unsafe private pushStmt(arr: Array<Stmt>, item: Stmt): void {
        if (item != null) class_incref(item);
        arr.push(item);
    }

    @unsafe private pushExpr(arr: Array<Expr>, item: Expr): void {
        if (item != null) class_incref(item);
        arr.push(item);
    }

    @unsafe constructor(tokens: Array<Token>) {
        log("--- ASTParser.constructor: start");
        this.tokens = tokens;
        this.pos = 0;
        log("--- ASTParser.constructor: end");
    }

    public parse(): Program {
        let declarations = new Array<Declaration>();
        
        // Inline isAtEnd() to avoid vtable issues
        while (this.pos < this.tokens.length) {
            let t = this.tokens.get(this.pos);
            if (t == null || t.kind == TokenKind.EOF) {
                break;
            }
            let decl = this.parseDeclaration();
            if (decl != null) {
                declarations.push(decl);
            }
        }
        
        let prog = new Program(declarations);
        class_incref(prog);
        class_incref(prog);
        return prog;
    }

    @unsafe private parseDeclaration(): Declaration {
        let isExported = this.matchKind(TokenKind.Export);
        let isDeclare = this.matchKind(TokenKind.Declare);
        
        if (this.matchKind(TokenKind.Import)) {
            return this.parseImportDecl();
        }
        
        if (this.matchKind(TokenKind.Function)) {
            return this.parseFunctionDecl(isExported, isDeclare);
        }
        
        if (this.matchKind(TokenKind.Class)) {
            return this.parseClassDecl(isExported, isDeclare);
        }
        
        if (!this.isAtEnd()) {
            this.advance();
        }
        return null as Declaration;
    }

    @unsafe private parseImportDecl(): Declaration {
        log("--- parseImportDecl: start");
        let defaultImport = "";
        let namespaceImport = "";
        
        if (this.peekKind() == TokenKind.Identifier) {
            log("--- parseImportDecl: default import branch");
            let lex = this.advanceLexeme();
            defaultImport = lex;
            class_incref(defaultImport);
            this.matchKind(TokenKind.Comma);
        }
        
        if (this.matchKind(TokenKind.LBrace)) {
            log("--- parseImportDecl: named import branch");
            while (!this.check(TokenKind.RBrace) && !this.isAtEnd()) {
                this.advance();
                if (!this.matchKind(TokenKind.Comma)) break;
            }
            this.matchKind(TokenKind.RBrace);
        } else if (this.matchKind(TokenKind.Star)) {
            log("--- parseImportDecl: namespace import branch");
            this.matchKind(TokenKind.As);
            log("--- parseImportDecl: about to advance for alias");
            let lex = this.advanceLexeme();
            namespaceImport = lex;
            class_incref(namespaceImport);
            log("--- parseImportDecl: assigned to namespaceImport");
        }
        
        log("--- parseImportDecl: matching From");
        this.matchKind(TokenKind.From);
        log("--- parseImportDecl: From matched, checking String token");
        let source = "";
        if (this.peekKind() == TokenKind.String) {
            let lex = this.advanceLexeme();
            source = lex;
            class_incref(source);
        }
        log("--- parseImportDecl: matching Semicolon");
        this.matchKind(TokenKind.Semicolon);
        log("--- parseImportDecl: creating Declaration");
        
        return new Declaration("ImportDecl", source, defaultImport, namespaceImport, "", new Array<ClassMemberDecl>(), null as Stmt);
    }

    @unsafe private parseFunctionDecl(isExported: bool, isDeclare: bool): Declaration {
        let name = "";
        if (this.peekKind() == TokenKind.Identifier) {
            name = this.advanceLexeme();
        }
        
        if (this.matchKind(TokenKind.Less)) {
            this.skipUntil(TokenKind.Greater);
            this.matchKind(TokenKind.Greater);
        }
        
        let params = new Array<ParameterInfo>();
        if (this.matchKind(TokenKind.LParen)) {
            log("--- ASTParser.parseFunctionDecl: parsing params");
            while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                let pName = this.advanceLexeme();
                let pType = "";
                if (this.matchKind(TokenKind.Colon)) pType = this.parseTypeText();
                this.pushParam(params, new ParameterInfo(pName, pType, false));
                if (!this.matchKind(TokenKind.Comma)) break;
            }
            this.matchKind(TokenKind.RParen);
        }
        
        let retType = "void";
        if (this.matchKind(TokenKind.Colon)) {
            retType = this.parseTypeText();
        }
        log("--- ASTParser.parseFunctionDecl: retType =");
        log(retType);
        
        let body: Stmt = null as Stmt;
        if (isDeclare) {
            this.matchKind(TokenKind.Semicolon);
        } else {
            log("--- ASTParser.parseFunctionDecl: parsing block body");
            body = this.parseBlockStmt();
        }
        
        let decl = new Declaration("FunctionDecl", name, retType, "", "", new Array<ClassMemberDecl>(), body);
        class_incref(params);
        decl.params = params;
        log("--- ASTParser.parseFunctionDecl: decl successfully created");
        return decl;
    }

    @unsafe private parseClassDecl(isExported: bool, isDeclare: bool): Declaration {
        let name = "";
        if (this.peekKind() == TokenKind.Identifier) {
            name = this.advanceLexeme();
        }
        
        if (this.matchKind(TokenKind.Less)) {
            this.skipUntil(TokenKind.Greater);
            this.matchKind(TokenKind.Greater);
        }
        
        let baseClass = "";
        if (this.matchKind(TokenKind.Extends)) {
            if (this.peekKind() == TokenKind.Identifier) {
                baseClass = this.advanceLexeme();
            }
        }
        
        let members = new Array<ClassMemberDecl>();
        if (this.matchKind(TokenKind.LBrace)) {
            while (!this.check(TokenKind.RBrace) && !this.isAtEnd()) {
                this.pushMember(members, this.parseClassMember());
            }
            this.matchKind(TokenKind.RBrace);
        }
        
        let decl = new Declaration("ClassDecl", name, "", "", "", members, null as Stmt);
        decl.baseClass = baseClass;
        return decl;
    }

    @unsafe private parseClassMember(): ClassMemberDecl {
        let isPublic = false;
        let isPrivate = false;
        let isProtected = false;
        let isStatic = false;
        
        while (true) {
            let k = this.peekKind();
            if (k == TokenKind.Public) { isPublic = true; this.advance(); }
            else if (k == TokenKind.Private) { isPrivate = true; this.advance(); }
            else if (k == TokenKind.Protected) { isProtected = true; this.advance(); }
            else if (k == TokenKind.Static) { isStatic = true; this.advance(); }
            else break;
        }

        // Skip 'function' keyword if present (for method declarations inside class)
        let isFunctionKeyword = this.matchKind(TokenKind.Function);
        let isConstructor = this.matchKind(TokenKind.Constructor);
        let name = "";
        if (!isConstructor) {
            name = this.advanceLexeme();
        } else {
            name = "constructor";
        }

        let params = new Array<ParameterInfo>();
        if (this.matchKind(TokenKind.LParen)) {
            while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                let pName = this.advanceLexeme();
                let pType = "";
                if (this.matchKind(TokenKind.Colon)) pType = this.parseTypeText();
                this.pushParam(params, new ParameterInfo(pName, pType, false));
                if (!this.matchKind(TokenKind.Comma)) break;
            }
            this.matchKind(TokenKind.RParen);
        }

        let typeText = "";
        if (this.matchKind(TokenKind.Colon)) {
            typeText = this.parseTypeText();
        }

        let body: Stmt = null as Stmt;
        let hasBody = false;
        if (this.peekKind() == TokenKind.LBrace) {
            body = this.parseBlockStmt();
            hasBody = true;
        } else {
            this.matchKind(TokenKind.Semicolon);
        }

        let kind: string = "FieldDecl";
        if (hasBody) {
            if (isConstructor) {
                kind = "ConstructorDecl";
            } else {
                kind = "MethodDecl";
            }
        }
        
        let m = new ClassMemberDecl(kind, name, "", isPublic, isPrivate, isProtected, isStatic, false, isConstructor, "", new Array<string>(), "", params, "", typeText, "", typeText, hasBody, 0, 0, 0, 0, 0, 0, 0, body);
        return m;
    }

    @unsafe private parseBlockStmt(): BlockStmt {
        log("--- ASTParser.parseBlockStmt: entering");
        this.matchKind(TokenKind.LBrace);
        log("--- ASTParser.parseBlockStmt: LBrace matched");
        let statements = new Array<Stmt>();
        log("--- ASTParser.parseBlockStmt: statements array created");
        while (!this.check(TokenKind.RBrace) && !this.isAtEnd()) {
            let oldPos = this.pos;
            log("--- ASTParser.parseBlockStmt: parsing statement");
            this.pushStmt(statements, this.parseStatement());
            log("--- ASTParser.parseBlockStmt: statement parsed");
            if (this.pos == oldPos) {
                log("parseBlockStmt: ERROR - pos did not advance, kind:");
                print_i32(this.peekKind());
                this.advance();
            }
        }
        log("--- ASTParser.parseBlockStmt: loop ended");
        this.matchKind(TokenKind.RBrace);
        log("--- ASTParser.parseBlockStmt: RBrace matched");
        let resBlock = new BlockStmt(statements);
        log("--- ASTParser.parseBlockStmt: BlockStmt successfully created");
        class_incref(resBlock);
        class_incref(resBlock);
        return resBlock;
    }

    @unsafe private parseStatement(): Stmt {
        if (this.matchKind(TokenKind.Let) || this.matchKind(TokenKind.Const)) {
            return this.parseVarDeclStmt();
        }
        if (this.matchKind(TokenKind.Return)) {
            let expr: Expr = null as Expr;
            if (!this.check(TokenKind.Semicolon)) expr = this.parseExpression();
            this.matchKind(TokenKind.Semicolon);
            return new ReturnStmt(expr);
        }
        if (this.matchKind(TokenKind.If)) {
            this.matchKind(TokenKind.LParen);
            let cond = this.parseExpression();
            this.matchKind(TokenKind.RParen);
            let then = this.parseStatement();
            let els: Stmt = null as Stmt;
            if (this.matchKind(TokenKind.Else)) els = this.parseStatement();
            return new IfStmt(cond, then, els);
        }
        if (this.matchKind(TokenKind.While)) {
            this.matchKind(TokenKind.LParen);
            let cond = this.parseExpression();
            this.matchKind(TokenKind.RParen);
            let body = this.parseStatement();
            return new WhileStmt(cond, body);
        }
        if (this.check(TokenKind.LBrace)) {
            return this.parseBlockStmt();
        }
        
        if (this.check(TokenKind.RBrace) || this.check(TokenKind.Semicolon) || this.isAtEnd()) {
            if (this.matchKind(TokenKind.Semicolon)) {
                return new ExprStmt(null as Expr);
            }
            return new ExprStmt(null as Expr);
        }
        
        let expr = this.parseExpression();
        this.matchKind(TokenKind.Semicolon);
        return new ExprStmt(expr);
    }

    @unsafe private parseVarDeclStmt(): VarDeclStmt {
        let name = this.advanceLexeme();
        let typeText = "";
        if (this.matchKind(TokenKind.Colon)) typeText = this.parseTypeText();
        let init: Expr = null as Expr;
        if (this.matchKind(TokenKind.Equal)) init = this.parseExpression();
        this.matchKind(TokenKind.Semicolon);
        return new VarDeclStmt(name, typeText, init, false);
    }

    @unsafe private parseExpression(): Expr {
        return this.parseAssignment();
    }

    @unsafe private parseAssignment(): Expr {
        let left = this.parseEquality();
        if (this.matchKind(TokenKind.Equal)) {
            let right = this.parseAssignment();
            return new BinaryExpr("=", left, right);
        }
        return left;
    }

    @unsafe private parseEquality(): Expr {
        let left = this.parseComparison();
        while (this.peekKind() == TokenKind.EqualEqual || this.peekKind() == TokenKind.BangEqual) {
            let op = this.advanceLexeme();
            let right = this.parseComparison();
            left = new BinaryExpr(op, left, right);
        }
        return left;
    }

    @unsafe private parseComparison(): Expr {
        let left = this.parseAdditive();
        while (this.peekKind() == TokenKind.Less || this.peekKind() == TokenKind.Greater || this.peekKind() == TokenKind.LessEqual || this.peekKind() == TokenKind.GreaterEqual) {
            let op = this.advanceLexeme();
            let right = this.parseAdditive();
            left = new BinaryExpr(op, left, right);
        }
        return left;
    }

    @unsafe private parseAdditive(): Expr {
        let left = this.parseMultiplicative();
        while (this.peekKind() == TokenKind.Plus || this.peekKind() == TokenKind.Minus) {
            let op = this.advanceLexeme();
            let right = this.parseMultiplicative();
            left = new BinaryExpr(op, left, right);
        }
        return left;
    }

    @unsafe private parseMultiplicative(): Expr {
        let left = this.parseUnary();
        while (this.peekKind() == TokenKind.Star || this.peekKind() == TokenKind.Slash) {
            let op = this.advanceLexeme();
            let right = this.parseUnary();
            left = new BinaryExpr(op, left, right);
        }
        return left;
    }

    @unsafe private parseUnary(): Expr {
        if (this.matchKind(TokenKind.Bang) || this.matchKind(TokenKind.Minus)) {
            let op = this.previousLexeme();
            let operand = this.parseUnary();
            return new UnaryExpr(op, operand, true);
        }
        return this.parsePostfix();
    }

    @unsafe private parsePostfix(): Expr {
        let expr = this.parsePrimary();
        while (true) {
            if (this.matchKind(TokenKind.LParen)) {
                let args = new Array<Expr>();
                while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                    this.pushExpr(args, this.parseExpression());
                    if (!this.matchKind(TokenKind.Comma)) break;
                }
                this.matchKind(TokenKind.RParen);
                expr = new CallExpr(expr, args, new Array<string>());
            } else if (this.matchKind(TokenKind.Dot)) {
                let name = this.advanceLexeme();
                expr = new MemberExpr(expr, name);
            } else if (this.matchKind(TokenKind.LBracket)) {
                let index = this.parseExpression();
                this.matchKind(TokenKind.RBracket);
                expr = new IndexExpr(expr, index);
            } else break;
        }
        return expr;
    }

    @unsafe private parsePrimary(): Expr {
        if (this.matchKind(TokenKind.Number)) return new NumberLiteral(this.previousLexeme());
        if (this.matchKind(TokenKind.String)) return new StringLiteral(this.previousLexeme());
        if (this.matchKind(TokenKind.Identifier)) return new IdentifierExpr(this.previousLexeme());
        if (this.matchKind(TokenKind.This)) return new ThisExpr();
        if (this.matchKind(TokenKind.New)) {
            let name = this.advanceLexeme();
            // Parse generic type arguments: Array<Token>
            let typeArgs = new Array<string>();
            if (this.matchKind(TokenKind.Less)) {
                while (!this.check(TokenKind.Greater) && !this.isAtEnd()) {
                    if (this.peek().kind == TokenKind.Identifier) {
                        typeArgs.push(this.advanceLexeme());
                    }
                    if (!this.matchKind(TokenKind.Comma)) break;
                }
                this.matchKind(TokenKind.Greater);
            }
            let args = new Array<Expr>();
            if (this.matchKind(TokenKind.LParen)) {
                while (!this.check(TokenKind.RParen) && !this.isAtEnd()) {
                    this.pushExpr(args, this.parseExpression());
                    if (!this.matchKind(TokenKind.Comma)) break;
                }
                this.matchKind(TokenKind.RParen);
            }
            return new NewExpr(name, args, typeArgs);
        }
        if (this.matchKind(TokenKind.LParen)) {
            let expr = this.parseExpression();
            this.matchKind(TokenKind.RParen);
            return expr;
        }
        
        if (!this.isAtEnd() && !this.check(TokenKind.Semicolon) && !this.check(TokenKind.RBrace)) {
            this.advance();
        }
        return null as Expr;
    }

    @unsafe private parseTypeText(): string {
        let res = "";
        let parenDepth = 0;
        let angleDepth = 0;
        while (!this.isAtEnd()) {
            let k = this.peekKind();
            if (parenDepth == 0 && angleDepth == 0) {
                if (k == TokenKind.RParen || k == TokenKind.Comma || k == TokenKind.RBrace || k == TokenKind.Semicolon || k == TokenKind.Equal || k == TokenKind.LBrace) break;
            }
            if (k == TokenKind.LParen) parenDepth = parenDepth + 1;
            if (k == TokenKind.RParen) parenDepth = parenDepth - 1;
            if (k == TokenKind.Less) angleDepth = angleDepth + 1;
            if (k == TokenKind.Greater) angleDepth = angleDepth - 1;
            
            let lex = this.advanceLexeme();
            res = res + lex;
        }
        return res;
    }

    @unsafe private skipUntil(kind: i32): void {
        while (!this.isAtEnd() && !this.check(kind)) this.advance();
    }

    @unsafe private matchKind(kind: i32): bool {
        if (this.check(kind)) { 
            this.pos = this.pos + 1; 
            return true; 
        }
        return false;
    }

    @unsafe private check(kind: i32): bool {
        if (this.tokens == null) { return false; }
        if (this.isAtEnd()) return kind == TokenKind.EOF;
        let t = this.tokens.get(this.pos);
        if (t == null) { return false; }
        return t.kind == kind;
    }

    @unsafe private advance(): Token {
        if (this.tokens == null) {
            log("--- ASTParser.advance: ERROR - tokens is NULL!");
            return null as Token;
        }
        let t = this.tokens.get(this.pos);
        if (this.pos < this.tokens.length) {
            this.pos = this.pos + 1;
        }
        return t;
    }

    @unsafe private advanceLexeme(): string {
        if (this.tokens == null) { return ""; }
        let t = this.tokens.get(this.pos);
        if (this.pos < this.tokens.length) {
            this.pos = this.pos + 1;
        }
        if (t == null) { return ""; }
        let lex = t.lexeme;
        if (lex == null) { return ""; }
        class_incref(lex);
        class_incref(lex);
        return lex;
    }

    @unsafe private previousLexeme(): string {
        if (this.tokens == null) { return ""; }
        let t = this.tokens.get(this.pos - 1);
        if (t == null) { return ""; }
        class_incref(t);
        let lex = t.lexeme;
        if (lex == null) { return ""; }
        class_incref(lex);
        class_incref(lex);
        return lex;
    }

    @unsafe private peekKind(): i32 {
        if (this.tokens == null) { return TokenKind.EOF; }
        if (this.pos >= this.tokens.length) { return TokenKind.EOF; }
        let t = this.tokens.get(this.pos);
        if (t == null) { return TokenKind.EOF; }
        return t.kind;
    }

    @unsafe private isAtEnd(): bool {
        if (this.tokens == null) {
            log("--- ASTParser.isAtEnd: ERROR - tokens is NULL!");
            return true;
        }
        if (this.pos >= this.tokens.length) {
            return true;
        }
        let t = this.tokens.get(this.pos);
        if (t == null) return true;
        return t.kind == TokenKind.EOF;
    }

    @unsafe private peek(): Token {
        return this.tokens.get(this.pos);
    }

    @unsafe private previous(): Token {
        return this.tokens.get(this.pos - 1);
    }
}


// ===== From mir-builder-flat.tsn =====

declare function print_i32(n: i32): void;







// Class Registry: Lưu thông tin metadata của các class
class ClassFieldInfo {
    public name: string;
    public typeText: string;
    public offset: i32;
    public offsetStr: string;
    public index: i32;

    constructor(name: string, typeText: string, index: i32) {
        this.name = name;
        this.typeText = typeText;
        this.index = index;
        this.offset = 0; // Sẽ được tính toán sau
        this.offsetStr = "0";
    }
}

class ClassMethodInfo {
    public name: string;
    public index: i32;

    constructor(name: string, index: i32) {
        this.name = name;
        this.index = index;
    }
}

class ClassInfo {
    public name: string;
    public fields: Array<ClassFieldInfo>;
    public methods: Array<ClassMethodInfo>;
    public size: i32;
    public sizeStr: string;

    constructor(name: string) {
        this.name = name;
        this.fields = new Array<ClassFieldInfo>();
        this.methods = new Array<ClassMethodInfo>();
        this.size = 8; // Bắt đầu với 8 bytes cho vtable pointer
        this.sizeStr = "8";
    }

    public addField(field: ClassFieldInfo): void {
        this.fields.push(field);
    }

    public addMethod(method: ClassMethodInfo): void {
        this.methods.push(method);
    }

    public getFieldByName(name: string): ClassFieldInfo {
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let f = this.fields.get(i);
            if (f.name == name) {
                return f;
            }
        }
        return null as ClassFieldInfo;
    }

    public getFieldIndex(fieldName: string): i32 {
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let f = this.fields.get(i);
            if (f.name == fieldName) {
                return f.index;
            }
        }
        return -1;
    }

    public getFieldOffset(fieldName: string): i32 {
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let f = this.fields.get(i);
            if (f.name == fieldName) {
                return f.offset;
            }
        }
        return -1;
    }

    public getMethodIndex(methodName: string): i32 {
        for (let i = 0; i < this.methods.length; i = i + 1) {
            let m = this.methods.get(i);
            if (m.name == methodName) {
                return m.index;
            }
        }
        return -1;
    }

    public computeFieldOffsets(): void {
        log("ClassInfo.computeFieldOffsets for " + this.name);
        let currentOffset = 8; // Offset 0 là vtable pointer
        let currentOffsetStr = "8";
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let field = this.fields.get(i);
            field.offset = currentOffset;
            field.offsetStr = currentOffsetStr;
            
            // Tính kích thước của field dựa trên type
            let fieldSize = 8; // Mặc định là 8 bytes (pointer hoặc i64)
            if (field.typeText == "i32") fieldSize = 4;
            else if (field.typeText == "i16") fieldSize = 2;
            else if (field.typeText == "i8") fieldSize = 1;
            else if (field.typeText == "bool") fieldSize = 1;
            else if (field.typeText == "f32") fieldSize = 4;
            else if (field.typeText == "f64") fieldSize = 8;
            else if (field.typeText == "i64") fieldSize = 8;
            
            currentOffset = currentOffset + fieldSize;
            // Update offset string using lookup
            if (currentOffset == 9) currentOffsetStr = "9";
            else if (currentOffset == 10) currentOffsetStr = "10";
            else if (currentOffset == 12) currentOffsetStr = "12";
            else if (currentOffset == 16) currentOffsetStr = "16";
            else if (currentOffset == 20) currentOffsetStr = "20";
            else if (currentOffset == 24) currentOffsetStr = "24";
            else if (currentOffset == 28) currentOffsetStr = "28";
            else if (currentOffset == 32) currentOffsetStr = "32";
            else if (currentOffset == 36) currentOffsetStr = "36";
            else if (currentOffset == 40) currentOffsetStr = "40";
            else if (currentOffset == 44) currentOffsetStr = "44";
            else if (currentOffset == 48) currentOffsetStr = "48";
            else if (currentOffset == 56) currentOffsetStr = "56";
            else if (currentOffset == 64) currentOffsetStr = "64";
            else if (currentOffset == 72) currentOffsetStr = "72";
            else if (currentOffset == 80) currentOffsetStr = "80";
            else if (currentOffset == 88) currentOffsetStr = "88";
            else if (currentOffset == 96) currentOffsetStr = "96";
            else if (currentOffset == 104) currentOffsetStr = "104";
            else if (currentOffset == 112) currentOffsetStr = "112";
            else if (currentOffset == 120) currentOffsetStr = "120";
            else if (currentOffset == 128) currentOffsetStr = "128";
            else currentOffsetStr = "256"; // fallback for very large structs
        }
        this.size = currentOffset;
        // Update size string using lookup
        if (currentOffset == 8) this.sizeStr = "8";
        else if (currentOffset == 9) this.sizeStr = "9";
        else if (currentOffset == 10) this.sizeStr = "10";
        else if (currentOffset == 12) this.sizeStr = "12";
        else if (currentOffset == 16) this.sizeStr = "16";
        else if (currentOffset == 20) this.sizeStr = "20";
        else if (currentOffset == 24) this.sizeStr = "24";
        else if (currentOffset == 28) this.sizeStr = "28";
        else if (currentOffset == 32) this.sizeStr = "32";
        else if (currentOffset == 36) this.sizeStr = "36";
        else if (currentOffset == 40) this.sizeStr = "40";
        else if (currentOffset == 48) this.sizeStr = "48";
        else if (currentOffset == 56) this.sizeStr = "56";
        else if (currentOffset == 64) this.sizeStr = "64";
        else if (currentOffset == 72) this.sizeStr = "72";
        else if (currentOffset == 80) this.sizeStr = "80";
        else if (currentOffset == 96) this.sizeStr = "96";
        else if (currentOffset == 128) this.sizeStr = "128";
        else this.sizeStr = "256"; // fallback for very large structs
        log("ClassInfo: total size = ");
        print_i32(this.size);
    }
}

class MIRBuilder {
    private module: MIRModule;
    private currentFunction: MIRFunction;
    private currentBlockId: i32;
    private entryBlockId: i32;
    private locals: Array<string>;
    private localAddrs: Array<MIRValue>;
    private paramNames: Array<string>;
    private paramTypeTexts: Array<string>;
    private classRegistry: Array<ClassInfo>;
    private classNames: Array<string>;
    private currentClassName: string;
    private importedLocalNames: Array<string>;
    private importedMangledNames: Array<string>;

    constructor(moduleName: string) {
        this.module = new MIRModule(moduleName);
        this.currentFunction = null;
        this.currentBlockId = -1;
        this.entryBlockId = -1;
        this.locals = new Array<string>();
        this.localAddrs = new Array<MIRValue>();
        this.paramNames = new Array<string>();
        this.paramTypeTexts = new Array<string>();
        this.classRegistry = new Array<ClassInfo>();
        this.classNames = new Array<string>();
        this.currentClassName = "";
        this.importedLocalNames = new Array<string>();
        this.importedMangledNames = new Array<string>();
    }

    public build(program: Program): MIRModule {
        log("MIRBuilder.build: start");
        
        // Phase 1: Collect class metadata
        log("MIRBuilder.build: Phase 1 - Collecting class metadata");
        for (let i = 0; i < program.declarations.length; i = i + 1) {
            let decl = program.declarations.get(i);
            if (decl.kind == "ClassDecl") {
                this.collectClassMetadata(decl);
            }
        }
        
        // Phase 1.5: Add hardcoded imported class info
        log("MIRBuilder.build: Phase 1.5 - Adding hardcoded classes");
        
        // Token class from ast.tsn
        let tokenClass = new ClassInfo("Token");
        let tokenKindField = new ClassFieldInfo("kind", "i32", 0);
        tokenKindField.offset = 8;
        tokenKindField.offsetStr = "8";
        tokenClass.fields.push(tokenKindField);
        let tokenLexemeField = new ClassFieldInfo("lexeme", "string", 1);
        tokenLexemeField.offset = 12;
        tokenLexemeField.offsetStr = "12";
        tokenClass.fields.push(tokenLexemeField);
        let tokenLineField = new ClassFieldInfo("line", "i32", 2);
        tokenLineField.offset = 20;
        tokenLineField.offsetStr = "20";
        tokenClass.fields.push(tokenLineField);
        let tokenColumnField = new ClassFieldInfo("column", "i32", 3);
        tokenColumnField.offset = 24;
        tokenColumnField.offsetStr = "24";
        tokenClass.fields.push(tokenColumnField);
        let tokenInitMethod = new ClassMethodInfo("init", 0);
        tokenClass.addMethod(tokenInitMethod);
        tokenClass.size = 28;
        tokenClass.sizeStr = "28";
        this.classRegistry.push(tokenClass);
        this.classNames.push("Token");
        
        // Lexer class from lexer.tsn
        let lexerClass = new ClassInfo("Lexer");
        let lexerSourceField = new ClassFieldInfo("source", "string", 0);
        lexerSourceField.offset = 8;
        lexerSourceField.offsetStr = "8";
        lexerClass.fields.push(lexerSourceField);
        let lexerInitMethod = new ClassMethodInfo("init", 0);
        lexerClass.addMethod(lexerInitMethod);
        let lexerTokenizeMethod = new ClassMethodInfo("tokenize", 1);
        lexerClass.addMethod(lexerTokenizeMethod);
        lexerClass.size = 16;
        lexerClass.sizeStr = "16";
        this.classRegistry.push(lexerClass);
        this.classNames.push("Lexer");
        
        // ASTParser class from ast-parser.tsn
        let astParserClass = new ClassInfo("ASTParser");
        let parserTokensField = new ClassFieldInfo("tokens", "Array", 0);
        parserTokensField.offset = 8;
        parserTokensField.offsetStr = "8";
        astParserClass.fields.push(parserTokensField);
        let parserPosField = new ClassFieldInfo("pos", "i32", 1);
        parserPosField.offset = 16;
        parserPosField.offsetStr = "16";
        astParserClass.fields.push(parserPosField);
        let parserInitMethod = new ClassMethodInfo("init", 0);
        astParserClass.addMethod(parserInitMethod);
        let parserParseMethod = new ClassMethodInfo("parse", 1);
        astParserClass.addMethod(parserParseMethod);
        let parserParseDeclarationMethod = new ClassMethodInfo("parseDeclaration", 2);
        astParserClass.addMethod(parserParseDeclarationMethod);
        astParserClass.size = 24;
        astParserClass.sizeStr = "24";
        this.classRegistry.push(astParserClass);
        this.classNames.push("ASTParser");
        
        // Symbol class from semantics.tsn
        let symbolClass = new ClassInfo("Symbol");
        let symbolNameField = new ClassFieldInfo("name", "string", 0);
        symbolNameField.offset = 8;
        symbolNameField.offsetStr = "8";
        symbolClass.fields.push(symbolNameField);
        let symKindField = new ClassFieldInfo("symKind", "string", 1);
        symKindField.offset = 16;
        symKindField.offsetStr = "16";
        symbolClass.fields.push(symKindField);
        let symTypeField = new ClassFieldInfo("symType", "string", 2);
        symTypeField.offset = 24;
        symTypeField.offsetStr = "24";
        symbolClass.fields.push(symTypeField);
        let symMembersField = new ClassFieldInfo("members", "Scope", 3);
        symMembersField.offset = 32;
        symMembersField.offsetStr = "32";
        symbolClass.fields.push(symMembersField);
        let symbolInitMethod = new ClassMethodInfo("init", 0);
        symbolClass.addMethod(symbolInitMethod);
        symbolClass.size = 40;
        symbolClass.sizeStr = "40";
        this.classRegistry.push(symbolClass);
        this.classNames.push("Symbol");
        
        // Scope class from semantics.tsn
        let scopeClass = new ClassInfo("Scope");
        let scopeSymbolsField = new ClassFieldInfo("symbols", "Array", 0);
        scopeSymbolsField.offset = 8;
        scopeSymbolsField.offsetStr = "8";
        scopeClass.fields.push(scopeSymbolsField);
        let scopeParentField = new ClassFieldInfo("parent", "Scope", 1);
        scopeParentField.offset = 16;
        scopeParentField.offsetStr = "16";
        scopeClass.fields.push(scopeParentField);
        let scopeInitMethod = new ClassMethodInfo("init", 0);
        scopeClass.addMethod(scopeInitMethod);
        let scopeDefineMethod = new ClassMethodInfo("define", 1);
        scopeClass.addMethod(scopeDefineMethod);
        let scopeResolveMethod = new ClassMethodInfo("resolve", 2);
        scopeClass.addMethod(scopeResolveMethod);
        scopeClass.size = 24;
        scopeClass.sizeStr = "24";
        this.classRegistry.push(scopeClass);
        this.classNames.push("Scope");
        
        // Array class from std:array (generic, but we'll use Array as a generic type)
        let arrayClass = new ClassInfo("Array");
        let arrayDataField = new ClassFieldInfo("data", "ptr", 0);
        arrayDataField.offset = 8;
        arrayDataField.offsetStr = "8";
        arrayClass.fields.push(arrayDataField);
        let arrayLenField = new ClassFieldInfo("length", "i32", 1);
        arrayLenField.offset = 16;
        arrayLenField.offsetStr = "16";
        arrayClass.fields.push(arrayLenField);
        let arrayCapField = new ClassFieldInfo("cap", "i32", 2);
        arrayCapField.offset = 20;
        arrayCapField.offsetStr = "20";
        arrayClass.fields.push(arrayCapField);
        let getPushMethod = new ClassMethodInfo("get", 0);
        arrayClass.addMethod(getPushMethod);
        let pushMethod = new ClassMethodInfo("push", 1);
        arrayClass.addMethod(pushMethod);
        let lengthMethod = new ClassMethodInfo("length", 2);
        arrayClass.addMethod(lengthMethod);
        arrayClass.size = 24;
        arrayClass.sizeStr = "24";
        this.classRegistry.push(arrayClass);
        this.classNames.push("Array");
        
        // MIRType class from mir-flat.tsn
        let mirtypeClass = new ClassInfo("MIRType");
        let mirtypeNameField = new ClassFieldInfo("name", "string", 0);
        mirtypeNameField.offset = 8;
        mirtypeNameField.offsetStr = "8";
        mirtypeClass.fields.push(mirtypeNameField);
        let mirtypeIsPointerField = new ClassFieldInfo("isPointer", "bool", 1);
        mirtypeIsPointerField.offset = 16;
        mirtypeIsPointerField.offsetStr = "16";
        mirtypeClass.fields.push(mirtypeIsPointerField);
        let mirtypeSizeField = new ClassFieldInfo("size", "i32", 2);
        mirtypeSizeField.offset = 20;
        mirtypeSizeField.offsetStr = "20";
        mirtypeClass.fields.push(mirtypeSizeField);
        let mirtypeInitMethod = new ClassMethodInfo("init", 0);
        mirtypeClass.addMethod(mirtypeInitMethod);
        mirtypeClass.size = 24;
        mirtypeClass.sizeStr = "24";
        this.classRegistry.push(mirtypeClass);
        this.classNames.push("MIRType");
        
        // MIRValue class from mir-flat.tsn
        let mirvalueClass = new ClassInfo("MIRValue");
        let mirvkindField = new ClassFieldInfo("kind", "string", 0);
        mirvkindField.offset = 8;
        mirvkindField.offsetStr = "8";
        mirvalueClass.fields.push(mirvkindField);
        let mirvvalueTypeField = new ClassFieldInfo("valueType", "MIRType", 1);
        mirvvalueTypeField.offset = 16;
        mirvvalueTypeField.offsetStr = "16";
        mirvalueClass.fields.push(mirvvalueTypeField);
        let mirvnameField = new ClassFieldInfo("name", "string", 2);
        mirvnameField.offset = 24;
        mirvnameField.offsetStr = "24";
        mirvalueClass.fields.push(mirvnameField);
        let mirvconstantValueField = new ClassFieldInfo("constantValue", "string", 3);
        mirvconstantValueField.offset = 32;
        mirvconstantValueField.offsetStr = "32";
        mirvalueClass.fields.push(mirvconstantValueField);
        let mirvregisterIdField = new ClassFieldInfo("registerId", "i32", 4);
        mirvregisterIdField.offset = 40;
        mirvregisterIdField.offsetStr = "40";
        mirvalueClass.fields.push(mirvregisterIdField);
        let mirvglobalNameField = new ClassFieldInfo("globalName", "string", 5);
        mirvglobalNameField.offset = 44;
        mirvglobalNameField.offsetStr = "44";
        mirvalueClass.fields.push(mirvglobalNameField);
        let mirvalueInitMethod = new ClassMethodInfo("init", 0);
        mirvalueClass.addMethod(mirvalueInitMethod);
        mirvalueClass.size = 52;
        mirvalueClass.sizeStr = "52";
        this.classRegistry.push(mirvalueClass);
        this.classNames.push("MIRValue");
        
        // MIRInst class from mir-flat.tsn (simplified: only main fields)
        let mirstClass = new ClassInfo("MIRInst");
        let mirstopcodeField = new ClassFieldInfo("opcode", "string", 0);
        mirstopcodeField.offset = 8;
        mirstopcodeField.offsetStr = "8";
        mirstClass.fields.push(mirstopcodeField);
        let mirstresultField = new ClassFieldInfo("result", "MIRValue", 1);
        mirstresultField.offset = 16;
        mirstresultField.offsetStr = "16";
        mirstClass.fields.push(mirstresultField);
        let mirstInitMethod = new ClassMethodInfo("init", 0);
        mirstClass.addMethod(mirstInitMethod);
        mirstClass.size = 24;
        mirstClass.sizeStr = "24";
        this.classRegistry.push(mirstClass);
        this.classNames.push("MIRInst");
        
        // MIRBasicBlock class from mir-flat.tsn
        let mirbbClass = new ClassInfo("MIRBasicBlock");
        let mirbbidField = new ClassFieldInfo("id", "i32", 0);
        mirbbidField.offset = 8;
        mirbbidField.offsetStr = "8";
        mirbbClass.fields.push(mirbbidField);
        let mirbblabelField = new ClassFieldInfo("label", "string", 1);
        mirbblabelField.offset = 12;
        mirbblabelField.offsetStr = "12";
        mirbbClass.fields.push(mirbblabelField);
        let mirbinstrsField = new ClassFieldInfo("instructions", "Array", 2);
        mirbinstrsField.offset = 20;
        mirbinstrsField.offsetStr = "20";
        mirbbClass.fields.push(mirbinstrsField);
        let mirbbInitMethod = new ClassMethodInfo("init", 0);
        mirbbClass.addMethod(mirbbInitMethod);
        mirbbClass.size = 28;
        mirbbClass.sizeStr = "28";
        this.classRegistry.push(mirbbClass);
        this.classNames.push("MIRBasicBlock");
        
        // MIRFunction class from mir-flat.tsn
        let mirfnClass = new ClassInfo("MIRFunction");
        let mirfnameField = new ClassFieldInfo("name", "string", 0);
        mirfnameField.offset = 8;
        mirfnameField.offsetStr = "8";
        mirfnClass.fields.push(mirfnameField);
        let mirfreturnTypeField = new ClassFieldInfo("returnType", "MIRType", 1);
        mirfreturnTypeField.offset = 16;
        mirfreturnTypeField.offsetStr = "16";
        mirfnClass.fields.push(mirfreturnTypeField);
        let mirfparamsField = new ClassFieldInfo("params", "Array", 2);
        mirfparamsField.offset = 24;
        mirfparamsField.offsetStr = "24";
        mirfnClass.fields.push(mirfparamsField);
        let mirfblocksField = new ClassFieldInfo("blocks", "Array", 3);
        mirfblocksField.offset = 32;
        mirfblocksField.offsetStr = "32";
        mirfnClass.fields.push(mirfblocksField);
        let mirfnextRegIdField = new ClassFieldInfo("nextRegId", "i32", 4);
        mirfnextRegIdField.offset = 40;
        mirfnextRegIdField.offsetStr = "40";
        mirfnClass.fields.push(mirfnextRegIdField);
        let mirfnextBlockIdField = new ClassFieldInfo("nextBlockId", "i32", 5);
        mirfnextBlockIdField.offset = 44;
        mirfnextBlockIdField.offsetStr = "44";
        mirfnClass.fields.push(mirfnextBlockIdField);
        let mirfInitMethod = new ClassMethodInfo("init", 0);
        mirfnClass.addMethod(mirfInitMethod);
        let mirfcreateBlockMethod = new ClassMethodInfo("createBlock", 1);
        mirfnClass.addMethod(mirfcreateBlockMethod);
        let mirfcreateRegisterMethod = new ClassMethodInfo("createRegister", 2);
        mirfnClass.addMethod(mirfcreateRegisterMethod);
        mirfnClass.size = 48;
        mirfnClass.sizeStr = "48";
        this.classRegistry.push(mirfnClass);
        this.classNames.push("MIRFunction");
        
        // ClassFieldInfo class
        let classFieldInfoClass = new ClassInfo("ClassFieldInfo");
        let cfnameField = new ClassFieldInfo("name", "string", 0);
        cfnameField.offset = 8;
        cfnameField.offsetStr = "8";
        classFieldInfoClass.fields.push(cfnameField);
        let cftypeTextField = new ClassFieldInfo("typeText", "string", 1);
        cftypeTextField.offset = 16;
        cftypeTextField.offsetStr = "16";
        classFieldInfoClass.fields.push(cftypeTextField);
        let cfoffsetField = new ClassFieldInfo("offset", "i32", 2);
        cfoffsetField.offset = 24;
        cfoffsetField.offsetStr = "24";
        classFieldInfoClass.fields.push(cfoffsetField);
        let cfoffsetStrField = new ClassFieldInfo("offsetStr", "string", 3);
        cfoffsetStrField.offset = 28;
        cfoffsetStrField.offsetStr = "28";
        classFieldInfoClass.fields.push(cfoffsetStrField);
        let cfindexField = new ClassFieldInfo("index", "i32", 4);
        cfindexField.offset = 36;
        cfindexField.offsetStr = "36";
        classFieldInfoClass.fields.push(cfindexField);
        let cfInitMethod = new ClassMethodInfo("init", 0);
        classFieldInfoClass.addMethod(cfInitMethod);
        classFieldInfoClass.size = 40;
        classFieldInfoClass.sizeStr = "40";
        this.classRegistry.push(classFieldInfoClass);
        this.classNames.push("ClassFieldInfo");
        
        // ClassMethodInfo class
        let classMethodInfoClass = new ClassInfo("ClassMethodInfo");
        let cmnameField = new ClassFieldInfo("name", "string", 0);
        cmnameField.offset = 8;
        cmnameField.offsetStr = "8";
        classMethodInfoClass.fields.push(cmnameField);
        let cmindexField = new ClassFieldInfo("index", "i32", 1);
        cmindexField.offset = 16;
        cmindexField.offsetStr = "16";
        classMethodInfoClass.fields.push(cmindexField);
        let cmInitMethod = new ClassMethodInfo("init", 0);
        classMethodInfoClass.addMethod(cmInitMethod);
        classMethodInfoClass.size = 20;
        classMethodInfoClass.sizeStr = "20";
        this.classRegistry.push(classMethodInfoClass);
        this.classNames.push("ClassMethodInfo");
        
        // ClassInfo class
        let classInfoClass = new ClassInfo("ClassInfo");
        let cinameField = new ClassFieldInfo("name", "string", 0);
        cinameField.offset = 8;
        cinameField.offsetStr = "8";
        classInfoClass.fields.push(cinameField);
        let cifieldsField = new ClassFieldInfo("fields", "Array", 1);
        cifieldsField.offset = 16;
        cifieldsField.offsetStr = "16";
        classInfoClass.fields.push(cifieldsField);
        let cimethodsField = new ClassFieldInfo("methods", "Array", 2);
        cimethodsField.offset = 24;
        cimethodsField.offsetStr = "24";
        classInfoClass.fields.push(cimethodsField);
        let cisizeField = new ClassFieldInfo("size", "i32", 3);
        cisizeField.offset = 32;
        cisizeField.offsetStr = "32";
        classInfoClass.fields.push(cisizeField);
        let cisizeStrField = new ClassFieldInfo("sizeStr", "string", 4);
        cisizeStrField.offset = 36;
        cisizeStrField.offsetStr = "36";
        classInfoClass.fields.push(cisizeStrField);
        let ciInitMethod = new ClassMethodInfo("init", 0);
        classInfoClass.addMethod(ciInitMethod);
        let ciAddFieldMethod = new ClassMethodInfo("addField", 1);
        classInfoClass.addMethod(ciAddFieldMethod);
        let ciAddMethodMethod = new ClassMethodInfo("addMethod", 2);
        classInfoClass.addMethod(ciAddMethodMethod);
        let ciGetFieldByNameMethod = new ClassMethodInfo("getFieldByName", 3);
        classInfoClass.addMethod(ciGetFieldByNameMethod);
        let ciGetFieldIndexMethod = new ClassMethodInfo("getFieldIndex", 4);
        classInfoClass.addMethod(ciGetFieldIndexMethod);
        let ciGetFieldOffsetMethod = new ClassMethodInfo("getFieldOffset", 5);
        classInfoClass.addMethod(ciGetFieldOffsetMethod);
        let ciGetMethodIndexMethod = new ClassMethodInfo("getMethodIndex", 6);
        classInfoClass.addMethod(ciGetMethodIndexMethod);
        let ciComputeFieldOffsetsMethod = new ClassMethodInfo("computeFieldOffsets", 7);
        classInfoClass.addMethod(ciComputeFieldOffsetsMethod);
        classInfoClass.size = 44;
        classInfoClass.sizeStr = "44";
        this.classRegistry.push(classInfoClass);
        this.classNames.push("ClassInfo");
        
        // Phase 2: Compute field offsets for all classes (skip Token - already computed)
        log("MIRBuilder.build: Phase 2 - Computing field offsets");
        for (let i = 0; i < this.classRegistry.length; i = i + 1) {
            let classInfo = this.classRegistry.get(i);
            if (classInfo.name != "Token") {
                classInfo.computeFieldOffsets();
            }
        }
        
        // Phase 2.5: Process imports and build symbol mappings
        log("MIRBuilder.build: Phase 2.5 - Using hardcoded mappings in CallExpr (arrays don't work)");
        
        // Phase 3: Build functions and methods
        log("MIRBuilder.build: Phase 3 - Building functions");
        for (let i = 0; i < program.declarations.length; i = i + 1) {
            this.buildDeclaration(program.declarations.get(i));
        }
        
        log("MIRBuilder.build: complete");
        return this.module;
    }

    private buildDeclaration(decl: Declaration): void {
        if (decl.kind == "FunctionDecl") {
            // Skip function declarations without body (external/declare functions)
            if (decl.body != null) {
                this.buildFunction(decl);
            }
        } else if (decl.kind == "ClassDecl") {
            this.buildClass(decl);
        }
    }

    private collectClassMetadata(decl: Declaration): void {
        log("MIRBuilder.collectClassMetadata: " + decl.name);
        
        let classInfo = new ClassInfo(decl.name);
        
        // Collect fields and methods from class members
        if (decl.members != null) {
            let fieldIndex = 0;
            for (let i = 0; i < decl.members.length; i = i + 1) {
                let member = decl.members.get(i);
                
                if (member.kind == "FieldDecl") {
                    // Thu thập thông tin field
                    let fieldInfo = new ClassFieldInfo(member.name, member.typeText, fieldIndex);
                    classInfo.addField(fieldInfo);
                    log("  Field: " + member.name + " : " + member.typeText);
                    fieldIndex = fieldIndex + 1;
                } else if (member.kind == "MethodDecl" || member.kind == "ConstructorDecl") {
                    // Thu thập tên method
                    let methodInfo = new ClassMethodInfo(member.name, classInfo.methods.length);
                    classInfo.addMethod(methodInfo);
                    log("  Method: " + member.name);
                }
            }
        }
        
        // Lưu vào registry
        this.classRegistry.push(classInfo);
        this.classNames.push(decl.name);
        log("MIRBuilder: Registered class " + decl.name);
    }

    private getClassInfo(className: string): ClassInfo {
        for (let i = 0; i < this.classNames.length; i = i + 1) {
            if (this.classNames.get(i) == className) {
                return this.classRegistry.get(i);
            }
        }
        return null as ClassInfo;
    }

    private buildFunction(decl: Declaration): void {
        log("MIRBuilder.buildFunction: " + decl.name);
        log("MIRBuilder.buildFunction: reading detailA");
        let detailA = decl.detailA;
        log("MIRBuilder.buildFunction: detailA read = " + detailA);
        
        // Clear locals from previous function
        this.clearLocals();
        
        // Parse return type from detailA (e.g., "i32", "void")
        let returnType = this.parseType(decl.detailA);
        log("MIRBuilder.buildFunction: returnType parsed");
        let func = this.createFunction(decl.name, returnType);
        log("MIRBuilder.buildFunction: function created");
        
        // Add parameters
        log("MIRBuilder.buildFunction: params.length = ");
        print_i32(decl.params.length);
        // Reset param names for this function
        this.paramNames = new Array<string>();
        this.paramTypeTexts = new Array<string>();
        for (let i = 0; i < decl.params.length; i = i + 1) {
            let param = decl.params.get(i);
            let paramType = this.parseType(param.typeText);
            let paramReg = func.createRegister(paramType);
            // Track param name and type text; func.params gets ownership of paramReg
            this.paramNames.push(param.name);
            this.paramTypeTexts.push(param.typeText);
            func.params.push(paramReg);
        }
        
        log("MIRBuilder.buildFunction: checking body");
        // Build function body if it exists
        if (decl.body != null) {
            log("MIRBuilder.buildFunction: body exists, analyzing");
            this.analyzeStatement(decl.body);
            
            // Check if current block has a terminator
            let currentBlock = this.getCurrentBlock();
            let hasTerminator = false;
            if (currentBlock.instructions.length > 0) {
                let lastInst = currentBlock.instructions.get(currentBlock.instructions.length - 1);
                if (lastInst.opcode == "Return" || lastInst.opcode == "Branch" || lastInst.opcode == "Jump") {
                    hasTerminator = true;
                }
            }
            if (!hasTerminator) {
                if (returnType.name == "void") {
                    let voidVal = this.createConstant("0", new MIRType("void", false, 0));
                    this.createReturn(voidVal);
                } else {
                    let defaultVal = this.createConstant("0", returnType);
                    this.createReturn(defaultVal);
                }
            }
        } else {
            // No body - create default return
            if (returnType.name == "void") {
                let voidVal = this.createConstant("0", new MIRType("void", false, 0));
                this.createReturn(voidVal);
            } else {
                let defaultVal = this.createConstant("0", returnType);
                this.createReturn(defaultVal);
            }
        }
        
        this.module.functions.push(func);
    }
    
    private parseType(typeText: string): MIRType {
        if (typeText == "i32") return new MIRType("i32", false, 4);
        if (typeText == "i64") return new MIRType("i64", false, 8);
        if (typeText == "i8") return new MIRType("i8", false, 1);
        if (typeText == "i16") return new MIRType("i16", false, 2);
        if (typeText == "f32") return new MIRType("f32", false, 4);
        if (typeText == "f64") return new MIRType("f64", false, 8);
        if (typeText == "bool") return new MIRType("i32", false, 4); // TSN bool is i32
        if (typeText == "void") return new MIRType("void", false, 0);
        if (typeText == "string") return new MIRType("string", true, 8);
        if (typeText == "ptr") return new MIRType("ptr", true, 8);
        // Unknown types are reference types (objects/classes) - represented as ptr
        return new MIRType(typeText, true, 8);
    }

    public createFunction(name: string, returnType: MIRType): MIRFunction {
        // Basic name mangling for top-level functions in self-hosting
        let mangledName = name;
        if (name != "main" && name != "log" && name != "readText" && name != "writeText" && name != "print_i32" && name != "tsn_get_argc" && name != "tsn_get_argv" && name != "tsn_alloc" && name != "tsn_strlen" && name != "tsn_write_i32" && name != "tsn_memcpy" && name != "debug_log_i32" && name != "debug_log_i64" && name != "debug_log_ptr") {
            if (this.currentClassName == "") {
                mangledName = "_T." + name + "$P";
            }
        }
        
        let func = new MIRFunction(mangledName, returnType);
        this.currentFunction = func;
        let entryId = func.createBlock("entry");
        this.currentBlockId = entryId;
        this.entryBlockId = entryId;
        return func;
    }

    public getModule(): MIRModule {
        return this.module;
    }

    private analyzeStatement(stmt: Stmt): void {
        log("analyzeStatement: enter, kind = " + stmt.kind);
        if (stmt.kind == "BlockStmt") {
            log("analyzeStatement: BlockStmt, casting");
            let block = stmt as BlockStmt;
            log("analyzeStatement: cast done, reading statements");
            let stmts = block.statements;
            log("analyzeStatement: statements read, getting length");
            let len = stmts.length;
            log("analyzeStatement: BlockStmt, statements.length = ");
            print_i32(len);
            for (let i = 0; i < block.statements.length; i = i + 1) {
                log("analyzeStatement: processing statement index = ");
                print_i32(i);
                this.analyzeStatement(block.statements.get(i));
            }
        } else if (stmt.kind == "VarDeclStmt") {
            log("analyzeStatement: VarDeclStmt, casting");
            let varDecl = stmt as VarDeclStmt;
            log("analyzeStatement: VarDeclStmt, analyzing init expr");
            let val = this.analyzeExpression(varDecl.init);
            log("analyzeStatement: VarDeclStmt, expr analyzed");
            // Skip void-typed variables (no storage needed)
            if (val.valueType.name != "void") {
                // Allocate space for the variable
                let addr = this.createAlloca(val.valueType);
                this.createStore(val, addr);
                // Add to symbol table
                this.addLocal(varDecl.name, addr);
            }
        } else if (stmt.kind == "ExprStmt") {
            log("analyzeStatement: ExprStmt, casting");
            let exprStmt = stmt as ExprStmt;
            // Skip empty statements (e.g., standalone semicolons)
            if (exprStmt.expr == null) {
                log("analyzeStatement: ExprStmt is empty, skipping");
            } else {
                log("analyzeStatement: ExprStmt, analyzing expr");
                this.analyzeExpression(exprStmt.expr);
            }
            log("analyzeStatement: ExprStmt, done");
        } else if (stmt.kind == "ReturnStmt") {
            let retStmt = stmt as ReturnStmt;
            let val: MIRValue = null;
            if (retStmt.value == null) {
                val = this.createConstant("0", this.currentFunction.returnType);
            } else {
                val = this.analyzeExpression(retStmt.value);
            }
            this.createReturn(val);
        } else if (stmt.kind == "IfStmt") {
            let ifStmt = stmt as IfStmt;
            let cond = this.analyzeExpression(ifStmt.condition);
            let thenId = this.createBasicBlock("if.then");
            let elseId = this.createBasicBlock("if.else");
            let mergeId = this.createBasicBlock("if.merge");

            this.createBranch(cond, thenId, elseId);

            this.setInsertPoint(thenId);
            this.analyzeStatement(ifStmt.thenBranch);
            this.createJump(mergeId);

            this.setInsertPoint(elseId);
            if (ifStmt.elseBranch != null) {
                this.analyzeStatement(ifStmt.elseBranch);
            }
            this.createJump(mergeId);

            this.setInsertPoint(mergeId);
        } else if (stmt.kind == "WhileStmt") {
            let whileStmt = stmt as WhileStmt;
            let condId = this.createBasicBlock("while.cond");
            let bodyId = this.createBasicBlock("while.body");
            let endId = this.createBasicBlock("while.end");

            this.createJump(condId);
            this.setInsertPoint(condId);
            let cond = this.analyzeExpression(whileStmt.condition);
            this.createBranch(cond, bodyId, endId);

            this.setInsertPoint(bodyId);
            this.analyzeStatement(whileStmt.body);
            this.createJump(condId);

            this.setInsertPoint(endId);
        }
    }

    private analyzeExpression(expr: Expr): MIRValue {
        if (expr == null) {
            log("analyzeExpression: expr is NULL!");
            return this.createConstant("0", new MIRType("i32", false, 4));
        }
        log("analyzeExpression: expr.kind = " + expr.kind);
        if (expr.kind == "NumberLiteral") {
            let lit = expr as NumberLiteral;
            // Check if it's a float
            if (lit.value.indexOf(".") != -1) {
                return this.createConstant(lit.value, new MIRType("f32", false, 4));
            }
            return this.createConstant(lit.value, new MIRType("i32", false, 4));
        } else if (expr.kind == "StringLiteral") {
            let lit = expr as StringLiteral;
            return this.createConstant(lit.value, new MIRType("string", true, 8));
        } else if (expr.kind == "BooleanLiteral") {
            let lit = expr as BooleanLiteral;
            let val = "0";
            if (lit.value) {
                val = "1";
            }
            return this.createConstant(val, new MIRType("bool", false, 1));
        } else if (expr.kind == "NullLiteral") {
            // null is a pointer constant
            return this.createConstant("0", new MIRType("ptr", true, 8));
        } else if (expr.kind == "BinaryExpr") {
            let bin = expr as BinaryExpr;
            // Handle assignment separately
            if (bin.operator == "=") {
                // Left side: identifier (local variable)
                if (bin.left.kind == "Identifier") {
                    let id = bin.left as IdentifierExpr;
                    let addr = this.findLocal(id.name);
                    if (addr != null) {
                        let right = this.analyzeExpression(bin.right);
                        this.createStore(right, addr);
                        return right;
                    }
                }
                // Left side: MemberExpr (this.field = value)
                if (bin.left.kind == "MemberExpr") {
                    let mem = bin.left as MemberExpr;
                    let objVal = this.analyzeExpression(mem.object);
                    let classInfo = this.getClassInfo(this.currentClassName);
                    if (classInfo != null) {
                        let fieldInfo = classInfo.getFieldByName(mem.member);
                        if (fieldInfo != null) {
                            let right = this.analyzeExpression(bin.right);
                            let fieldType = this.parseType(fieldInfo.typeText);
                            let fieldPtr = this.createFieldPtr(objVal, fieldInfo.offsetStr, fieldType);
                            this.createStore(right, fieldPtr);
                            return right;
                        }
                    }
                }
                // Fallback: just evaluate right side
                return this.analyzeExpression(bin.right);
            }
            
            // Handle "as" cast operator
            if (bin.operator == "as") {
                let value = this.analyzeExpression(bin.left);
                // Right side is the target type (Identifier like "string", "ptr", "i32", "i64")
                if (bin.right.kind == "Identifier") {
                    let targetTypeName = (bin.right as IdentifierExpr).name;
                    let targetType = this.parseType(targetTypeName);
                    
                    // If value is already the target type, no cast needed
                    if (value.valueType.name == targetType.name) {
                        return value;
                    }
                    
                    // Create cast instruction
                    return this.createCast(value, targetType);
                }
                // Fallback: return value as-is
                return value;
            }
            
            let left = this.analyzeExpression(bin.left);
            let right = this.analyzeExpression(bin.right);
            return this.createBinary(bin.operator, left, right);
        } else if (expr.kind == "Identifier") {
            let id = expr as IdentifierExpr;
            log("analyzeExpression: Identifier name = " + id.name);
            // Special case: null is a pointer constant
            if (id.name == "null") {
                return this.createConstant("0", new MIRType("ptr", true, 8));
            }
            // Look up variable in symbol table
            // First check if it's a function parameter (accessed by register id directly, no load needed)
            let paramIdx = this.findParamIndex(id.name);
            log("analyzeExpression: Identifier paramIdx = ");
            print_i32(paramIdx);
            if (paramIdx >= 0) {
                // Re-create the param register by index (same id as when it was created: params are r0, r1, ...)
                let typeText = this.paramTypeTexts.get(paramIdx);
                log("analyzeExpression: Identifier typeText = " + typeText);
                let paramType = this.parseType(typeText);
                log("analyzeExpression: Identifier paramType parsed");
                log("analyzeExpression: Identifier calling createRegister with paramIdx = ");
                print_i32(paramIdx);
                let reg = createRegister(paramType, paramIdx);
                log("analyzeExpression: Identifier createRegister returned");
                return reg;
            }
            let addr = this.findLocal(id.name);
            log("analyzeExpression: Identifier findLocal returned");
            if (addr != null) {
                log("analyzeExpression: Identifier loading from addr");
                // Load the value from the address
                return this.createLoad(addr);
            }
            log("analyzeExpression: Identifier not found, returning dummy");
            // If not found, return a dummy constant
            return this.createConstant("0", new MIRType("i32", false, 4));
        } else if (expr.kind == "CallExpr") {
            log("analyzeExpression: processing CallExpr");
            let call = expr as CallExpr;
            if (call.args == null) {
                log("CallExpr error: args is NULL!");
            } else {
                log("CallExpr args length =");
                print_i32(call.args.length);
            }
            let args = new Array<MIRValue>();
            for (let i = 0; i < call.args.length; i = i + 1) {
                log("CallExpr: analyzing arg index =");
                print_i32(i);
                args.push(this.analyzeExpression(call.args.get(i)));
            }
            log("CallExpr: args analyzed");
            let calleeName = "unknown";
            if (call.callee == null) {
                log("CallExpr error: callee is NULL!");
            } else {
                log("CallExpr: callee.kind = " + call.callee.kind);
                if (call.callee.kind == "Identifier") {
                    let calleeId = call.callee as IdentifierExpr;
                    calleeName = calleeId.name;
                    
                    // Map common runtime functions to mangled names for compatibility
                    if (calleeName == "log") calleeName = "_T.log$P.ptr";
                    else if (calleeName == "readText") calleeName = "_T.readText$P.ptr";
                    else if (calleeName == "writeText") calleeName = "_T.writeText$P.ptr.ptr";
                    else if (calleeName == "print_i32") calleeName = "print_i32";
                    else if (calleeName == "tsn_get_argc") calleeName = "tsn_get_argc";
                    else if (calleeName == "tsn_get_argv") calleeName = "tsn_get_argv";
                    else if (calleeName == "tsn_alloc") calleeName = "tsn_alloc";
                    else if (calleeName == "tsn_strlen") calleeName = "tsn_strlen";
                    else if (calleeName == "tsn_memcpy") calleeName = "tsn_memcpy";
                    else if (calleeName == "debug_log_i32") calleeName = "debug_log_i32";
                    else if (calleeName == "debug_log_i64") calleeName = "debug_log_i64";
                    else if (calleeName == "debug_log_ptr") calleeName = "debug_log_ptr";
                    else if (calleeName == "class_incref") calleeName = "class_incref";
                    else if (calleeName == "class_decref") calleeName = "class_decref";
                    else if (calleeName != "main") {
                        // Mangling for regular top-level functions
                        calleeName = "_T." + calleeName + "$P";
                    }
                } else if (call.callee.kind == "MemberExpr") {
                    // Handle qualified calls like memory.offset() or method calls like obj.method()
                    let memberExpr = call.callee as MemberExpr;
                    calleeName = memberExpr.member;
                    log("CallExpr: MemberExpr callee, member = " + calleeName);
                    
                    // Check if this is a method call on an object (obj.method() or this.method())
                    if (memberExpr.object.kind == "ThisExpr") {
                        // Method call on this: this.method() -> ClassName.method(this, args)
                        log("CallExpr: detected this.method() call");
                        let fullMethodName = this.currentClassName + "." + calleeName;
                        // Get 'this' pointer (always first parameter, r0)
                        let thisParam = this.currentFunction.params.get(0);
                        // Insert thisParam as first argument
                        let methodArgs = new Array<MIRValue>();
                        methodArgs.push(thisParam);
                        for (let i = 0; i < args.length; i = i + 1) {
                            methodArgs.push(args.get(i));
                        }
                        // Determine return type - default to ptr
                        let methodReturnType = new MIRType("ptr", true, 8);
                        if (calleeName == "analyzeStatement") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeExpression") { methodReturnType = new MIRType("ptr", true, 8); }
                        else if (calleeName == "analyzeReturn") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeDeclaration") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeFunction") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeClass") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeMethod") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeBlock") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeVarDecl") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeExprStmt") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeIf") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeWhile") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "analyzeFor") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "collectGlobalSymbol") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "collectClassMembers") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "enterScope") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "exitScope") { methodReturnType = new MIRType("void", false, 0); }
                        else if (calleeName == "getCurrentBlock") { methodReturnType = new MIRType("ptr", true, 8); }
                        return this.createCall(fullMethodName, methodArgs, methodReturnType);
                    } else if (memberExpr.object.kind == "Identifier") {
                        let objId = memberExpr.object as IdentifierExpr;
                        let objAddr = this.findLocal(objId.name);
                        if (objAddr != null) {
                            // This is a local variable, likely an object instance
                            // Look up which class has this method
                            log("CallExpr: checking if " + objId.name + " is an object with method " + calleeName);
                            let foundClassName = "";
                            for (let i = 0; i < this.classNames.length; i = i + 1) {
                                let className = this.classNames.get(i);
                                let classInfo = this.getClassInfo(className);
                                if (classInfo != null) {
                                    let methodIdx = classInfo.getMethodIndex(calleeName);
                                    if (methodIdx >= 0) {
                                        foundClassName = className;
                                    }
                                }
                            }
                            
                            // If not found by registry lookup, check for common Array methods
                            if (foundClassName == "") {
                                if (calleeName == "push" || calleeName == "get" || calleeName == "length" || calleeName == "indexOf") {
                                    foundClassName = "Array";
                                    log("CallExpr: assuming Array method for " + calleeName);
                                }
                            }
                            
                            if (foundClassName != "") {
                                // This is a method call: obj.method(args) -> ClassName.method(obj, args)
                                log("CallExpr: detected method call, class = " + foundClassName);
                                let fullMethodName = foundClassName + "." + calleeName;
                                // Load the object from local variable
                                let objPtr = this.createLoad(objAddr);
                                // Insert objPtr as first argument (this)
                                let methodArgs = new Array<MIRValue>();
                                methodArgs.push(objPtr);
                                for (let i = 0; i < args.length; i = i + 1) {
                                    methodArgs.push(args.get(i));
                                }
                                // Determine return type (comprehensive inference for method calls)
                                let methodReturnType = new MIRType("void", false, 0);
                                // ClassInfo methods
                                if (calleeName == "getFieldByName") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "getFieldIndex") { methodReturnType = new MIRType("i32", false, 4); }
                                else if (calleeName == "getFieldOffset") { methodReturnType = new MIRType("i32", false, 4); }
                                else if (calleeName == "getMethodIndex") { methodReturnType = new MIRType("i32", false, 4); }
                                else if (calleeName == "addField") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "addMethod") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "computeFieldOffsets") { methodReturnType = new MIRType("void", false, 0); }
                                // Scope methods
                                else if (calleeName == "define") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "resolve") { methodReturnType = new MIRType("ptr", true, 8); }
                                // Array methods
                                else if (calleeName == "get") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "push") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "length") { methodReturnType = new MIRType("i32", false, 4); }
                                else if (calleeName == "indexOf") { methodReturnType = new MIRType("i32", false, 4); }
                                // Lexer methods
                                else if (calleeName == "tokenize") { methodReturnType = new MIRType("ptr", true, 8); }
                                // ASTParser methods
                                else if (calleeName == "parse") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "parseDeclaration") { methodReturnType = new MIRType("ptr", true, 8); }
                                // Result/Optional methods
                                else if (calleeName == "isOk") { methodReturnType = new MIRType("i32", false, 4); }
                                else if (calleeName == "value") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "build") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "generate") { methodReturnType = new MIRType("ptr", true, 8); }
                                // MIRBuilder/helper methods
                                else if (calleeName == "getCurrentBlock") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "analyzeExpression") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "analyzeStatement") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "createRegister") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createLoad") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createBinary") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createFieldPtr") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "parseType") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createCall") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createAlloca") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createStore") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "createIntToPtr") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createPtrToInt") { methodReturnType = new MIRType("i64", false, 8); }
                                // MIRCodegen methods
                                else if (calleeName == "emitType") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "emitValue") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "emitInstruction") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "byteToHex") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "hexDigit") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "recursiveJoin") { methodReturnType = new MIRType("ptr", true, 8); }
                                // Common getters that return primitives
                                else if (calleeName == "getCount" || calleeName == "getValue" || calleeName == "getExtra") {
                                    methodReturnType = new MIRType("i32", false, 4);
                                }
                                return this.createCall(fullMethodName, methodArgs, methodReturnType);
                            }
                        }
                    }
                    
                    // Special case: ptr.get() with no args = pointer dereference
                    if (calleeName == "get" && call.args.length == 0) {
                        log("CallExpr: detected ptr.get() dereference pattern");
                        let ptrValue = this.analyzeExpression(memberExpr.object);
                        // Determine result type from context - default to i32
                        let resultType = new MIRType("i32", false, 4);
                        let resultReg = this.currentFunction.createRegister(resultType);
                        let loadInst = createLoadInst(resultReg, ptrValue);
                        this.getCurrentBlock().instructions.push(loadInst);
                        return resultReg;
                    }
                }
            }
            log("CallExpr: calling createCall for " + calleeName);
            // Hardcode return types for known functions
            // Default to ptr (most functions return objects), override for known primitives
            let returnType = new MIRType("ptr", true, 8);
            // FFI functions that return pointers
            if (calleeName == "GetProcessHeap") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "tsn_HeapAlloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "tsn_HeapReAlloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "HeapAlloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "GetStdHandle") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "CreateFileA") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "ArgsIterator") { returnType = new MIRType("ptr", true, 8); }
            // Memory allocation functions
            else if (calleeName == "alloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "allocate") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "allocOwned") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "offset") { returnType = new MIRType("ptr", true, 8); }
            // Array/collection methods that return elements (assume ptr for objects)
            else if (calleeName == "get") { returnType = new MIRType("ptr", true, 8); }
            // Result/Option methods
            else if (calleeName == "value") { returnType = new MIRType("ptr", true, 8); }
            // Lexer methods
            else if (calleeName == "tokenize") { returnType = new MIRType("ptr", true, 8); }
            // MIR factory functions (all return ptr to MIRValue or MIRInst objects)
            else if (calleeName == "createConstant") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createRegister") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createGlobal") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createBinaryInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createLoadInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createStoreInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createCallInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createReturnInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createBranchInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createJumpInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createAllocaInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createGetElementPtrInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createIncrefInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createDecrefInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createIntToPtrInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createPtrToIntInst") { returnType = new MIRType("i64", false, 8); }
            // MIRCodegen methods
            else if (calleeName == "collectStringLiterals") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "emitHeader") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "emitGlobals") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "emitFunctions") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "emitStringLiteralDefinition") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "emitType") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "joinOutput") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "recursiveJoin") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "getString") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "byteToHex") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "hexDigit") { returnType = new MIRType("ptr", true, 8); }
            // Array methods (generic arrays assumed to contain ptr objects for now)
            else if (calleeName == "get") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "push") { returnType = new MIRType("void", false, 0); }
            // ClassInfo methods
            else if (calleeName == "getFieldByName") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "getFieldIndex") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "getFieldOffset") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "getMethodIndex") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "addField") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "addMethod") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "computeFieldOffsets") { returnType = new MIRType("void", false, 0); }
            // MIRBuilder helper methods
            else if (calleeName == "getCurrentBlock") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "findLocal") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "addLocal") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "findParamIndex") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "getClassInfo") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createRegister") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createAlloca") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createLoad") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createStore") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "parseType") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createBinary") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createFieldPtr") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createLoadTyped") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createConstant") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createCall") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createIntToPtr") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createPtrToInt") { returnType = new MIRType("i64", false, 8); }
            else if (calleeName == "analyzeExpression") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "analyzeStatement") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "buildFunction") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "buildClass") { returnType = new MIRType("void", false, 0); }
            // String manipulation functions
            else if (calleeName == "cstringToString") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "tsn_get_argv") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "tsn_alloc") { returnType = new MIRType("ptr", true, 8); }
            // Functions returning i32
            else if (calleeName == "tsn_strlen") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "tsn_write_i32") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "tsn_memcpy") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "WriteFile") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "ReadFile") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "CloseHandle") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "print_i32") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "log") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "charCodeAt") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "createBlock") { returnType = new MIRType("i32", false, 4); }
            // Parser/Compiler functions
            else if (calleeName == "parse") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "codegen") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "compile") { returnType = new MIRType("ptr", true, 8); }
            
            // Hardcoded import mapping (arrays/fields don't work with Level 1→Level 3 compilation)
            let actualName = calleeName;
            if (calleeName == "add") {
                actualName = "_T.add$P.i32.i32";
            } else if (calleeName == "multiply") {
                actualName = "_T.multiply$P.i32.i32";
            } else if (calleeName == "push" || calleeName == "get" || calleeName == "length" || calleeName == "indexOf") {
                // Special case: if we see these bare method names, assume they're Array methods
                actualName = "Array." + calleeName;
                log("CallExpr: assuming Array method: " + calleeName + " -> " + actualName);
            } else if (calleeName == "createBlock" || calleeName == "createRegister") {
                // Assume these are MIRFunction methods
                actualName = "MIRFunction." + calleeName;
                log("CallExpr: assuming MIRFunction method: " + calleeName + " -> " + actualName);
            } else if (calleeName == "charCodeAt" || calleeName == "slice" || calleeName == "substring") {
                // Assume these are String methods
                actualName = "string." + calleeName;
                log("CallExpr: assuming String method: " + calleeName + " -> " + actualName);
            } else if (calleeName == "unknown") {
                // Return dummy constant instead of calling unknown
                log("CallExpr: detected unknown call, returning dummy");
                return this.createConstant("0", new MIRType("ptr", true, 8));
            }
            log("CallExpr: mapped " + calleeName + " -> " + actualName);
            return this.createCall(actualName, args, returnType);
        } else if (expr.kind == "NewExpr") {
            log("analyzeExpression: processing NewExpr");
            let newExpr = expr as NewExpr;
            
            // Handle generic types: Array<Token> -> Array_Token
            let actualClassName = newExpr.className;
            if (newExpr.typeArgs.length > 0) {
                log("analyzeExpression: NewExpr has typeArgs");
                actualClassName = newExpr.className + "_";
                for (let i = 0; i < newExpr.typeArgs.length; i = i + 1) {
                    if (i > 0) {
                        actualClassName = actualClassName + "_";
                    }
                    actualClassName = actualClassName + newExpr.typeArgs.get(i);
                }
                log("analyzeExpression: NewExpr generic type mangled to: " + actualClassName);
            }
            
            // Look up class info to get size
            let classInfo = this.getClassInfo(actualClassName);
            if (classInfo == null) {
                log("analyzeExpression: NewExpr class not found: " + actualClassName);
                return this.createConstant("0", new MIRType("ptr", true, 8));
            }
            
            // Allocate object: call _T.alloc$P.i64(size)
            log("analyzeExpression: NewExpr allocating size = " + classInfo.sizeStr);
            let sizeVal = this.createConstant(classInfo.sizeStr, new MIRType("i64", false, 8));
            let allocArgs = new Array<MIRValue>();
            allocArgs.push(sizeVal);
            let objPtr = this.createCall("_T.alloc$P.i64", allocArgs, new MIRType("ptr", true, 8));
            
            // TODO: Initialize VTable pointer at offset 0 (skip for now)
            
            // Call constructor if it exists: ClassName.init(objPtr, ...args)
            // NOTE: Skip calling init for now - constructors are not defined in Level 7
            // let constructorName = actualClassName + ".init";
            // log("analyzeExpression: NewExpr calling constructor " + constructorName);
            // let ctorArgs = new Array<MIRValue>();
            // ctorArgs.push(objPtr);
            // for (let i = 0; i < newExpr.args.length; i = i + 1) {
            //     ctorArgs.push(this.analyzeExpression(newExpr.args.get(i)));
            // }
            // this.createCall(constructorName, ctorArgs, new MIRType("void", false, 0));
            // Return the allocated object pointer
            return objPtr;
        } else if (expr.kind == "ThisExpr") {
            // 'this' -> register %r0 (first param of method)
            log("analyzeExpression: ThisExpr -> r0");
            return createRegister(new MIRType("ptr", true, 8), 0);
        } else if (expr.kind == "MemberExpr") {
            // Field access: obj.field -> load from field pointer
            log("analyzeExpression: MemberExpr");
            let mem = expr as MemberExpr;
            if (mem.object == null) {
                log("analyzeExpression: MemberExpr with null object, returning dummy value");
                return this.createConstant("0", new MIRType("ptr", true, 8));
            }
            let objVal = this.analyzeExpression(mem.object);
            
            // Determine the class name from the object
            let className = this.currentClassName; // default to current class for 'this' access
            
            // If object is an Identifier, look up its type text to get the actual class name
            if (mem.object.kind == "Identifier") {
                let id = mem.object as IdentifierExpr;
                let paramIdx = this.findParamIndex(id.name);
                if (paramIdx >= 0) {
                    // It's a parameter - get its type text which has the class name
                    className = this.paramTypeTexts.get(paramIdx);
                    log("analyzeExpression: MemberExpr on parameter, type: " + className);
                }
                // TODO: also check locals if we had a working local variable type tracking
            }
            
            let classInfo = this.getClassInfo(className);
            let fieldInfo = null as FieldInfo;
            if (classInfo != null) {
                fieldInfo = classInfo.getFieldByName(mem.member);
            }
            
            // Heuristic: if field not found, try guessing the class from field name
            if (fieldInfo == null) {
                log("analyzeExpression: MemberExpr trying heuristic for field: " + mem.member);
                if (mem.member == "offset" || mem.member == "offsetStr") {
                    className = "ClassFieldInfo";
                } else if (mem.member == "index") {
                    className = "ClassFieldInfo"; // or ClassMethodInfo, try ClassFieldInfo first
                } else if (mem.member == "typeText") {
                    className = "ClassFieldInfo";
                } else if (mem.member == "name") {
                    className = "ClassFieldInfo"; // Could also be ClassMethodInfo or ClassInfo
                } else if (mem.member == "size" || mem.member == "sizeStr") {
                    className = "ClassInfo";
                } else if (mem.member == "fields" || mem.member == "methods") {
                    className = "ClassInfo";
                } else if (mem.member == "length") {
                    // Array.length is i32, return it directly at offset 16 (standard Array struct)
                    log("analyzeExpression: MemberExpr detected array.length, returning i32");
                    let objVal = this.analyzeExpression(mem.object);
                    let fieldType = new MIRType("i32", false, 4);
                    let fieldPtr = this.createFieldPtr(objVal, "16", fieldType);
                    return this.createLoadTyped(fieldPtr, fieldType);
                } else if (mem.member == "kind") {
                    // Token.kind is i32 at offset 8, Expr.kind is string at offset 0
                    // Try Token first (most common case in parser)
                    className = "Token";
                } else if (mem.member == "lexeme" || mem.member == "line" || mem.member == "column") {
                    className = "Token";
                } else if (mem.member == "value") {
                    // Could be NumberLiteral, StringLiteral, BooleanLiteral - try NumberLiteral first
                    className = "NumberLiteral";
                }
                classInfo = this.getClassInfo(className);
                if (classInfo != null) {
                    fieldInfo = classInfo.getFieldByName(mem.member);
                }
            }
            
            if (fieldInfo != null) {
                log("analyzeExpression: MemberExpr field found: " + mem.member);
                // Compute field type for load
                let fieldType = this.parseType(fieldInfo.typeText);
                // Get field pointer via ptrtoint + add + inttoptr
                let fieldPtr = this.createFieldPtr(objVal, fieldInfo.offsetStr, fieldType);
                // Load value from field pointer
                return this.createLoadTyped(fieldPtr, fieldType);
            }
            
            log("analyzeExpression: MemberExpr field not found: " + mem.member);
            // Special case: enum access like TokenKind.Import returns i32
            if (mem.object.kind == "Identifier") {
                let objId = mem.object as IdentifierExpr;
                // Check if object name suggests an enum (ends with Kind, Type, etc.)
                if (objId.name == "TokenKind" || objId.name == "NodeKind" || objId.name == "ExprKind") {
                    log("analyzeExpression: MemberExpr detected enum access, returning i32");
                    return this.createConstant("0", new MIRType("i32", false, 4));
                }
            }
            return this.createConstant("0", new MIRType("ptr", true, 8));
        }
        return this.createConstant("0", new MIRType("i32", false, 4));
    }

    public setInsertPoint(blockId: i32): void {
        this.currentBlockId = blockId;
    }

    private buildClass(decl: Declaration): void {
        log("MIRBuilder.buildClass: " + decl.name);
        for (let i = 0; i < decl.members.length; i = i + 1) {
            let m = decl.members.get(i);
            if (m.kind == "MethodDecl") {
                this.buildMethod(decl.name, m);
            }
        }
    }

    private buildMethod(className: string, member: ClassMemberDecl): void {
        let fullName = className + "." + member.name;
        log("MIRBuilder.buildMethod: " + fullName);
        // Set current class context for 'this' access
        log("MIRBuilder.buildMethod: setting currentClassName");
        this.currentClassName = className;
        log("MIRBuilder.buildMethod: clearing locals");
        // Clear locals from previous function
        this.clearLocals();

        log("MIRBuilder.buildMethod: parsing returnType, typeText = " + member.returnTypeText);
        let returnType = this.parseType(member.returnTypeText);
        let func = this.createFunction(fullName, returnType);
        
        // Add implicit 'this' parameter as the first parameter
        log("MIRBuilder.buildMethod: adding implicit 'this'");
        let thisType = new MIRType("ptr", true, 8);
        let thisReg = func.createRegister(thisType);
        this.paramNames.push("this");
        this.paramTypeTexts.push(className); // Store class name as type text for 'this'
        func.params.push(thisReg);

        // Add regular parameters
        if (member.params != null) {
            for (let i = 0; i < member.params.length; i = i + 1) {
                let param = member.params.get(i);
                let paramType = this.parseType(param.typeText);
                let paramReg = func.createRegister(paramType);
                this.paramNames.push(param.name);
                this.paramTypeTexts.push(param.typeText);
                func.params.push(paramReg);
            }
        }
        
        // Build method body
        if (member.hasBody) {
            log("MIRBuilder.buildMethod: building body");
            this.analyzeStatement(member.body);
            
            // Default return if no terminator
            let currentBlock = this.getCurrentBlock();
            let hasTerminator = false;
            if (currentBlock.instructions.length > 0) {
                let lastInst = currentBlock.instructions.get(currentBlock.instructions.length - 1);
                if (lastInst.opcode == "Return" || lastInst.opcode == "Branch" || lastInst.opcode == "Jump") {
                    hasTerminator = true;
                }
            }
            if (!hasTerminator) {
                if (returnType.name == "void") {
                    this.createReturn(this.createConstant("0", new MIRType("void", false, 0)));
                } else {
                    this.createReturn(this.createConstant("0", returnType));
                }
            }
        } else {
            // Default return for empty methods
            if (returnType.name == "void") {
                this.createReturn(this.createConstant("0", new MIRType("void", false, 0)));
            } else {
                this.createReturn(this.createConstant("0", returnType));
            }
        }
        
        this.module.functions.push(func);
    }

    public createBasicBlock(label: string): i32 {
        return this.currentFunction.createBlock(label);
    }

    public createBinary(op: string, left: MIRValue, right: MIRValue): MIRRegister {
        // Comparison operators always return bool (i32 in TSN)
        let resultType = left.valueType;
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            resultType = new MIRType("i32", false, 4);
            // Type coercion: if comparing ptr with non-ptr, cast non-ptr to ptr
            if (left.valueType.isPointer && !right.valueType.isPointer) {
                let rightCasted = this.createIntToPtr(right);
                let result = this.currentFunction.createRegister(resultType);
                let inst = createBinaryInst(op, result, left, rightCasted);
                this.getCurrentBlock().instructions.push(inst);
                return result;
            } else if (!left.valueType.isPointer && right.valueType.isPointer) {
                let leftCasted = this.createIntToPtr(left);
                let result = this.currentFunction.createRegister(resultType);
                let inst = createBinaryInst(op, result, leftCasted, right);
                this.getCurrentBlock().instructions.push(inst);
                return result;
            }
        } else if (op == "+" || op == "-") {
            // String concatenation: if both operands are pointers and op is +, use string_concat
            if (op == "+" && left.valueType.isPointer && right.valueType.isPointer) {
                // Call _T.string_concat$P.ptr.ptr(left, right)
                let args = new Array<MIRValue>();
                args.push(left);
                args.push(right);
                let ptrType = new MIRType("ptr", true, 8);
                return this.createCall("_T.concat$P.ptr.ptr", args, ptrType);
            }
            // Pointer arithmetic: if one operand is ptr and other is int, perform i64-based pointer arithmetic
            if (left.valueType.isPointer && !right.valueType.isPointer) {
                let baseInt = this.createPtrToInt(left);
                // Cast right to i64 if needed
                let rightInt = right;
                if (right.valueType.name != "i64") {
                    rightInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
                    let sextInst = createBinaryInst("sext_hack", rightInt, right, right);
                    this.getCurrentBlock().instructions.push(sextInst);
                }
                let resultInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
                let inst = createBinaryInst(op, resultInt, baseInt, rightInt);
                this.getCurrentBlock().instructions.push(inst);
                return this.createIntToPtr(resultInt);
            } else if (!left.valueType.isPointer && right.valueType.isPointer) {
                if (op == "+") {
                    let baseInt = this.createPtrToInt(right);
                    // Cast left to i64 if needed
                    let leftInt = left;
                    if (left.valueType.name != "i64") {
                        leftInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
                        let sextInst = createBinaryInst("sext_hack", leftInt, left, left);
                        this.getCurrentBlock().instructions.push(sextInst);
                    }
                    let resultInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
                    let inst = createBinaryInst(op, resultInt, leftInt, baseInt);
                    this.getCurrentBlock().instructions.push(inst);
                    return this.createIntToPtr(resultInt);
                }
            }
        } else if (left.valueType.isPointer || right.valueType.isPointer) {
            let leftInt = left;
            if (left.valueType.isPointer) {
                leftInt = this.createPtrToInt(left);
            }
            let rightInt = right;
            if (right.valueType.isPointer) {
                rightInt = this.createPtrToInt(right);
            }
            let resultInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
            let inst = createBinaryInst(op, resultInt, leftInt, rightInt);
            this.getCurrentBlock().instructions.push(inst);
            return this.createIntToPtr(resultInt);
        }
        let result = this.currentFunction.createRegister(resultType);
        let inst = createBinaryInst(op, result, left, right);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createCast(value: MIRValue, targetType: MIRType): MIRValue {
        // Handle casting between different types
        // i32 -> ptr: inttoptr
        if (!value.valueType.isPointer && targetType.isPointer) {
            return this.createIntToPtr(value);
        }
        // ptr -> i32/i64: ptrtoint, then wrap back to ptr to maintain ptr return type
        if (value.valueType.isPointer && !targetType.isPointer) {
            let ptrInt = this.createPtrToInt(value);
            // Wrap i64 back to ptr so return type is consistent
            return this.createIntToPtr(ptrInt);
        }
        // i32 -> i64: sext, then wrap to ptr
        if (value.valueType.name == "i32" && targetType.name == "i64") {
            let result = this.currentFunction.createRegister(targetType);
            let sextInst = createBinaryInst("sext_hack", result, value, value);
            this.getCurrentBlock().instructions.push(sextInst);
            return this.createIntToPtr(result);
        }
        // For now, treat other casts as no-op or return value with new type annotation
        // This handles string/ptr aliases
        if (targetType.isPointer && value.valueType.isPointer) {
            // Both are pointers, just return the value
            return value;
        }
        // Same type or compatible: return as-is
        return value;
    }

    public createLoad(address: MIRValue): MIRRegister {
        // Determine the value type stored at address
        // The alloca register type name tells us the element type
        let addrType = address.valueType;
        let elemName = addrType.name;
        // Primitives: load returns the primitive value
        let isPrim = false;
        if (elemName == "i32") isPrim = true;
        else if (elemName == "i64") isPrim = true;
        else if (elemName == "i8") isPrim = true;
        else if (elemName == "i16") isPrim = true;
        else if (elemName == "f32") isPrim = true;
        else if (elemName == "f64") isPrim = true;
        else if (elemName == "bool") isPrim = true;
        let resultType = new MIRType(elemName, false, addrType.size);
        if (!isPrim) {
            // Reference/pointer types (string, class, Array, ptr) load as ptr
            resultType = new MIRType(elemName, true, 8);
        }
        let result = this.currentFunction.createRegister(resultType);
        let inst = createLoadInst(result, address);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createLoadTyped(address: MIRValue, loadType: MIRType): MIRRegister {
        // Load with explicit type (used for field access where we know the field type)
        let result = this.currentFunction.createRegister(loadType);
        let inst = createLoadInst(result, address);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createStore(value: MIRValue, address: MIRValue): void {
        let inst = createStoreInst(value, address);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createFieldPtr(thisVal: MIRValue, offsetStr: string, fieldType: MIRType): MIRRegister {
        // Generate field pointer via ptrtoint + add + inttoptr
        // %base_int = ptrtoint ptr %this to i64
        let baseInt = this.createPtrToInt(thisVal);
        // %field_int = add i64 %base_int, <offsetStr>
        let offsetConst = this.createConstant(offsetStr, new MIRType("i64", false, 8));
        let fieldIntReg = this.currentFunction.createRegister(new MIRType("i64", false, 8));
        let addInst = createBinaryInst("+", fieldIntReg, baseInt, offsetConst);
        this.getCurrentBlock().instructions.push(addInst);
        // %field_ptr = inttoptr i64 %field_int to ptr
        let fieldPtr = this.createIntToPtr(fieldIntReg);
        return fieldPtr;
    }

    public createCall(callee: string, args: Array<MIRValue>, returnType: MIRType): MIRRegister {
        let result = this.currentFunction.createRegister(returnType);
        let inst = createCallInst(result, callee, args);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createReturn(value: MIRValue): void {
        let inst = createReturnInst(value);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createBranch(condition: MIRValue, trueBlock: i32, falseBlock: i32): void {
        let inst = createBranchInst(condition, trueBlock, falseBlock);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createJump(targetBlock: i32): void {
        let inst = createJumpInst(targetBlock);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createAlloca(allocType: MIRType): MIRRegister {
        let result = this.currentFunction.createRegister(new MIRType(allocType.name, true, 8));
        let inst = createAllocaInst(result, allocType);
        
        // Insert into entry block BEFORE any terminator (Branch/Jump/Return)
        let entryBlock = this.currentFunction.blocks.get(this.entryBlockId);
        let insertPos = entryBlock.instructions.length;
        
        // Find first terminator position
        for (let i = 0; i < entryBlock.instructions.length; i = i + 1) {
            let existingInst = entryBlock.instructions.get(i);
            if (existingInst.opcode == "Branch" || existingInst.opcode == "Jump" || existingInst.opcode == "Return") {
                insertPos = i;
                break;
            }
        }
        
        // Shift instructions after insertPos and insert alloca
        let tempArray = new Array<MIRInst>();
        for (let i = 0; i < insertPos; i = i + 1) {
            tempArray.push(entryBlock.instructions.get(i));
        }
        tempArray.push(inst);
        for (let i = insertPos; i < entryBlock.instructions.length; i = i + 1) {
            tempArray.push(entryBlock.instructions.get(i));
        }
        
        // Replace instructions array
        entryBlock.instructions = tempArray;
        return result;
    }

    public createIncref(value: MIRValue): void {
        let inst = createIncrefInst(value);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createDecref(value: MIRValue): void {
        let inst = createDecrefInst(value);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createConstant(value: string, valueType: MIRType): MIRConstant {
        return createConstant(valueType, value);
    }

    public createIntToPtr(value: MIRValue): MIRRegister {
        // Cast integer to pointer using inttoptr instruction
        log("createIntToPtr: start");
        let result = this.currentFunction.createRegister(new MIRType("ptr", true, 8));
        log("createIntToPtr: register created");
        let inst = createIntToPtrInst(result, value);
        log("createIntToPtr: instruction created");
        this.getCurrentBlock().instructions.push(inst);
        log("createIntToPtr: instruction pushed");
        return result;
    }

    public createPtrToInt(value: MIRValue): MIRRegister {
        // Cast pointer to integer using ptrtoint instruction
        let result = this.currentFunction.createRegister(new MIRType("i64", false, 8));
        let inst = createPtrToIntInst(result, value);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    private getCurrentBlock(): MIRBasicBlock {
        return this.currentFunction.blocks.get(this.currentBlockId);
    }
    
    private addLocal(name: string, addr: MIRValue): void {
        this.locals.push(name);
        this.localAddrs.push(addr);
    }
    
    private findLocal(name: string): MIRValue {
        let i = 0;
        while (i < this.locals.length) {
            if (this.locals.get(i) == name) {
                return this.localAddrs.get(i);
            }
            i = i + 1;
        }
        return null as MIRValue;
    }

    private findParamIndex(name: string): i32 {
        let i = 0;
        while (i < this.paramNames.length) {
            if (this.paramNames.get(i) == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    
    private clearLocals(): void {
        log("MIRBuilder.clearLocals: start");
        this.locals = new Array<string>();
        log("MIRBuilder.clearLocals: locals reset");
        this.localAddrs = new Array<MIRValue>();
        log("MIRBuilder.clearLocals: localAddrs reset");
        this.paramNames = new Array<string>();
        log("MIRBuilder.clearLocals: paramNames reset");
        this.paramTypeTexts = new Array<string>();
        log("MIRBuilder.clearLocals: done");
    }

    private processImports(program: Program): void {
        log("processImports: using hardcoded mappings for test-helper.tsn");
        
        // Hardcoded mappings for test-helper.tsn
        this.importedLocalNames.push("add");
        this.importedMangledNames.push("_T.add$P.i32.i32");
        this.importedLocalNames.push("multiply");
        this.importedMangledNames.push("_T.multiply$P.i32.i32");
        
        log("processImports: added mappings, count = " + this.importedLocalNames.length);
    }
}


// ===== From mir-codegen-flat.tsn =====

declare function print_i32(n: i32): void;
// LLVM IR Codegen from MIR





class MIRCodegen {
    private output: Array<string>;
    private module: MIRModule;
    private stringLiterals: Array<string>;

    constructor(module: MIRModule) {
        this.module = module;
        this.output = new Array<string>();
        this.stringLiterals = new Array<string>();
    }

    public generate(): string {
        this.collectStringLiterals();

        this.emitHeader();
        
        // Emit globals and functions first (may add strings to stringLiterals)
        this.emitGlobals();
        this.emitFunctions();
        
        // Now emit all string literals (including any added during codegen)
        let i = 0;
        while (i < this.stringLiterals.length) {
            let strVal = this.getString(this.stringLiterals, i);
            this.emitStringLiteralDefinition(i, strVal);
            i = i + 1;
        }
        
        return this.joinOutput();
    }

    private emitHeader(): void {
        this.output.push("; Generated LLVM IR from MIR\n");
        this.output.push("; Module: ");
        this.output.push(this.module.name);
        this.output.push("\n\n");

        // Dynamic scanner for external call instructions
        let definedFuncs = new Array<string>();
        let i = 0;
        while (i < this.module.functions.length) {
            definedFuncs.push(this.module.functions.get(i).name);
            i = i + 1;
        }

        let extCallees = new Array<string>();
        let extDecls = new Array<string>();

        let fIdx = 0;
        while (fIdx < this.module.functions.length) {
            let f = this.module.functions.get(fIdx);
            let bIdx = 0;
            while (bIdx < f.blocks.length) {
                let b = f.blocks.get(bIdx);
                let instIdx = 0;
                while (instIdx < b.instructions.length) {
                    let inst = b.instructions.get(instIdx);
                    if (inst.opcode == "Call") {
                        let callInst = inst;
                        let callee = callInst.callee;
                        // Check if it is external
                        let isDefined = false;
                        let k = 0;
                        while (k < definedFuncs.length) {
                            if (definedFuncs.get(k) == callee) {
                                isDefined = true;
                            }
                            k = k + 1;
                        }
                        if (!isDefined) {
                            // Check if already in extCallees
                            let alreadyAdded = false;
                            let m = 0;
                            while (m < extCallees.length) {
                                if (extCallees.get(m) == callee) {
                                    alreadyAdded = true;
                                }
                                m = m + 1;
                            }
                            if (!alreadyAdded) {
                                extCallees.push(callee);
                                let declStr = "declare " + this.emitType(callInst.result.valueType) + " @" + callee + "(";
                                let argIdx = 0;
                                while (argIdx < callInst.callArgs.length) {
                                    if (argIdx > 0) {
                                        declStr = declStr + ", ";
                                    }
                                    declStr = declStr + this.emitType(callInst.callArgs.get(argIdx).valueType);
                                    argIdx = argIdx + 1;
                                }
                                declStr = declStr + ")\n";
                                extDecls.push(declStr);
                            }
                        }
                    }
                    instIdx = instIdx + 1;
                }
                bIdx = bIdx + 1;
            }
            fIdx = fIdx + 1;
        }

        // Hardcoded external runtime declarations
        this.output.push("declare ptr @addressof(ptr)\n");
        this.output.push("declare ptr @_T.alloc$P.i64(i64)\n");
        this.output.push("declare void @_T.free$P.void(ptr)\n");
        this.output.push("declare ptr @_T.string_concat$P.ptr.ptr(ptr, ptr)\n");
        this.output.push("declare i32 @_T.string_equals$P.ptr.ptr(ptr, ptr)\n");
        this.output.push("declare void @tsn_incref(ptr)\n");
        this.output.push("declare void @tsn_decref(ptr)\n");

        // Output all scanned external declarations
        let extIdx = 0;
        while (extIdx < extDecls.length) {
            let callee = extCallees.get(extIdx);
            let isBuiltIn = false;
            if (callee == "addressof" || callee == "tsn_incref" || callee == "tsn_decref") {
                isBuiltIn = true;
            }
            if (callee == "_T.alloc$P.i64" || callee == "_T.free$P.void") {
                isBuiltIn = true;
            }
            if (callee == "_T.string_concat$P.ptr.ptr" || callee == "_T.string_equals$P.ptr.ptr") {
                isBuiltIn = true;
            }

            if (!isBuiltIn) {
                this.output.push(extDecls.get(extIdx));
            }
            extIdx = extIdx + 1;
        }
        this.output.push("\n");
    }

    private emitGlobals(): void {
        let i = 0;
        while (i < this.module.globals.length) {
            let global = this.module.globals.get(i);
            this.emitGlobal(global);
            i = i + 1;
        }
    }

    private emitGlobal(global: MIRValue): void {
        this.output.push("@");
        this.output.push(global.name);
        this.output.push(" = global ");
        this.output.push(this.emitType(global.valueType));
        this.output.push(" zeroinitializer\n");
    }

    private emitFunctions(): void {
        let i = 0;
        while (i < this.module.functions.length) {
            let func = this.module.functions.get(i);
            this.emitFunction(func);
            i = i + 1;
        }
    }

    private emitFunction(func: MIRFunction): void {
        this.output.push("\n");
        this.output.push("define ");
        this.output.push(this.emitType(func.returnType));
        this.output.push(" @");
        this.output.push(func.name);
        this.output.push("(");
        this.emitParams(func);
        this.output.push(") {\n");
        
        this.emitBlocks(func);
        
        this.output.push("}\n");
    }

    private emitParams(func: MIRFunction): void {
        let i = 0;
        while (i < func.params.length) {
            if (i > 0) {
                this.output.push(", ");
            }
            let param = func.params.get(i);
            this.output.push(this.emitType(param.valueType));
            this.output.push(" ");
            this.output.push(this.emitValue(param));
            i = i + 1;
        }
    }

    private emitBlocks(func: MIRFunction): void {
        let i = 0;
        while (i < func.blocks.length) {
            let block = func.blocks.get(i);
            this.emitBlock(block);
            i = i + 1;
        }
    }

    private emitBlock(block: MIRBasicBlock): void {
        this.output.push("bb");
        this.output.push(this.idToStr(block.id));
        this.output.push(":");
        if (block.label != "") {
            this.output.push(" ; ");
            this.output.push(block.label);
        }
        this.output.push("\n");
        
        let i = 0;
        while (i < block.instructions.length) {
            let inst = block.instructions.get(i);
            this.output.push("  ");
            this.emitInstruction(inst);
            i = i + 1;
        }
    }

    private emitInstruction(inst: MIRInst): void {
        if (inst.opcode == "Binary") {
            this.emitBinaryInst(inst);
        } else if (inst.opcode == "Load") {
            this.emitLoadInst(inst);
        } else if (inst.opcode == "Store") {
            this.emitStoreInst(inst);
        } else if (inst.opcode == "Call") {
            this.emitCallInst(inst);
        } else if (inst.opcode == "Return") {
            this.emitReturnInst(inst);
        } else if (inst.opcode == "Branch") {
            this.emitBranchInst(inst);
        } else if (inst.opcode == "Jump") {
            this.emitJumpInst(inst);
        } else if (inst.opcode == "Alloca") {
            this.emitAllocaInst(inst);
        } else if (inst.opcode == "GetElementPtr") {
            this.emitGetElementPtrInst(inst);
        } else if (inst.opcode == "Incref") {
            this.emitIncrefInst(inst);
        } else if (inst.opcode == "Decref") {
            this.emitDecrefInst(inst);
        } else if (inst.opcode == "IntToPtr") {
            this.emitIntToPtrInst(inst);
        } else if (inst.opcode == "PtrToInt") {
            this.emitPtrToIntInst(inst);
        }
    }

    private emitBinaryInst(inst: MIRInst): void {
        // Special case: sext_hack for sign-extending i32 to i64
        if (inst.binaryOp == "sext_hack") {
            this.output.push(this.emitValue(inst.result));
            this.output.push(" = sext ");
            this.output.push(this.emitType(inst.leftOperand.valueType));
            this.output.push(" ");
            this.output.push(this.emitValue(inst.leftOperand));
            this.output.push(" to ");
            this.output.push(this.emitType(inst.result.valueType));
            this.output.push("\n");
            return;
        }

        let leftVal = this.emitValue(inst.leftOperand);
        let rightVal = this.emitValue(inst.rightOperand);
        let operandType = inst.leftOperand.valueType;
        if (inst.rightOperand.valueType.isPointer) {
            operandType = inst.rightOperand.valueType;
        }

        let isArithmetic = inst.binaryOp == "+" || inst.binaryOp == "-" || inst.binaryOp == "*" || inst.binaryOp == "/" || inst.binaryOp == "%" || inst.binaryOp == "&" || inst.binaryOp == "|" || inst.binaryOp == "^" || inst.binaryOp == "<<" || inst.binaryOp == ">>";
        
        if (operandType.isPointer && isArithmetic) {
            // Fix: LLVM add/sub etc do not support pointers directly.
            // If operandType is pointer and it's an arithmetic operation, use ptrtoint.
            let leftI64 = leftVal;
            if (inst.leftOperand.valueType.isPointer) {
                leftI64 = leftVal + "_i64";
                this.output.push(leftI64);
                this.output.push(" = ptrtoint ptr ");
                this.output.push(leftVal);
                this.output.push(" to i64\n  ");
            }
            let rightI64 = rightVal;
            if (inst.rightOperand.valueType.isPointer) {
                rightI64 = rightVal + "_i64";
                this.output.push(rightI64);
                this.output.push(" = ptrtoint ptr ");
                this.output.push(rightVal);
                this.output.push(" to i64\n  ");
            }

            let resI64 = this.emitValue(inst.result) + "_i64";
            this.output.push(resI64);
            this.output.push(" = ");
            if (inst.binaryOp == "+") this.output.push("add ");
            else if (inst.binaryOp == "-") this.output.push("sub ");
            else if (inst.binaryOp == "*") this.output.push("mul ");
            else if (inst.binaryOp == "/") this.output.push("sdiv ");
            else if (inst.binaryOp == "%") this.output.push("srem ");
            else if (inst.binaryOp == "&") this.output.push("and ");
            else if (inst.binaryOp == "|") this.output.push("or ");
            else if (inst.binaryOp == "^") this.output.push("xor ");
            else if (inst.binaryOp == "<<") this.output.push("shl ");
            else if (inst.binaryOp == ">>") this.output.push("ashr ");
            
            this.output.push("i64 ");
            this.output.push(leftI64);
            this.output.push(", ");
            this.output.push(rightI64);
            this.output.push("\n  ");
            
            this.output.push(this.emitValue(inst.result));
            this.output.push(" = inttoptr i64 ");
            this.output.push(resI64);
            this.output.push(" to ptr\n");
            return;
        }

        // Comparison operators - emit icmp (returns i1), then zext to i32
        if (inst.binaryOp == "==" || inst.binaryOp == "!=" || inst.binaryOp == "<" || inst.binaryOp == ">" || inst.binaryOp == "<=" || inst.binaryOp == ">=") {
            let tempResult = this.emitValue(inst.result) + "_i1";
            this.output.push(tempResult);
            this.output.push(" = ");
            if (inst.binaryOp == "==") this.output.push("icmp eq ");
            else if (inst.binaryOp == "!=") this.output.push("icmp ne ");
            else if (inst.binaryOp == "<") this.output.push("icmp slt ");
            else if (inst.binaryOp == ">") this.output.push("icmp sgt ");
            else if (inst.binaryOp == "<=") this.output.push("icmp sle ");
            else if (inst.binaryOp == ">=") this.output.push("icmp sge ");
            this.output.push(this.emitType(operandType));
            this.output.push(" ");
            this.output.push(leftVal);
            this.output.push(", ");
            this.output.push(rightVal);
            this.output.push("\n  ");
            // zext i1 to i32
            this.output.push(this.emitValue(inst.result));
            this.output.push(" = zext i1 ");
            this.output.push(tempResult);
            this.output.push(" to i32\n");
            return;
        }

        this.output.push(this.emitValue(inst.result));
        this.output.push(" = ");
        
        // Arithmetic operators
        if (inst.binaryOp == "+") {
            this.output.push("add ");
        } else if (inst.binaryOp == "-") {
            this.output.push("sub ");
        } else if (inst.binaryOp == "*") {
            this.output.push("mul ");
        } else if (inst.binaryOp == "/") {
            this.output.push("sdiv ");
        } else if (inst.binaryOp == "%") {
            this.output.push("srem ");
        }
        // Logical operators
        else if (inst.binaryOp == "&&") {
            this.output.push("and ");
        } else if (inst.binaryOp == "||") {
            this.output.push("or ");
        } else if (inst.binaryOp == "^") {
            this.output.push("xor ");
        }
        // Bitwise operators
        else if (inst.binaryOp == "&") {
            this.output.push("and ");
        } else if (inst.binaryOp == "|") {
            this.output.push("or ");
        } else if (inst.binaryOp == "<<") {
            this.output.push("shl ");
        } else if (inst.binaryOp == ">>") {
            this.output.push("ashr ");
        } else {
            this.output.push("add "); // fallback
        }
        
        this.output.push(this.emitType(operandType));
        this.output.push(" ");
        this.output.push(leftVal);
        this.output.push(", ");
        this.output.push(rightVal);
        this.output.push("\n");
    }

    private emitLoadInst(inst: MIRInst): void {
        this.output.push(this.emitValue(inst.result));
        this.output.push(" = load ");
        this.output.push(this.emitType(inst.result.valueType));
        this.output.push(", ptr ");
        this.output.push(this.emitValue(inst.address));
        this.output.push("\n");
    }

    private emitStoreInst(inst: MIRInst): void {
        this.output.push("store ");
        this.output.push(this.emitType(inst.value.valueType));
        this.output.push(" ");
        this.output.push(this.emitValue(inst.value));
        this.output.push(", ptr ");
        this.output.push(this.emitValue(inst.address));
        this.output.push("\n");
    }

    private emitCallInst(inst: MIRInst): void {
        if (inst.result.valueType.name != "void") {
            this.output.push(this.emitValue(inst.result));
            this.output.push(" = ");
        }
        this.output.push("call ");
        this.output.push(this.emitType(inst.result.valueType));
        this.output.push(" @");
        this.output.push(inst.callee);
        this.output.push("(");
        for (let i = 0; i < inst.callArgs.length; i = i + 1) {
            if (i > 0) this.output.push(", ");
            let arg = inst.callArgs.get(i);
            this.output.push(this.emitType(arg.valueType));
            this.output.push(" ");
            this.output.push(this.emitValue(arg));
        }
        this.output.push(")\n");
    }

    private emitReturnInst(inst: MIRInst): void {
        this.output.push("ret ");
        this.output.push(this.emitType(inst.value.valueType));
        if (inst.value.valueType.name != "void") {
            this.output.push(" ");
            this.output.push(this.emitValue(inst.value));
        }
        this.output.push("\n");
    }

    private emitBranchInst(inst: MIRInst): void {
        let condType = inst.condition.valueType;
        let condStr = this.emitValue(inst.condition);
        // If condition is pointer or null, coerce it to i1 properly
        if (condStr == "null") {
            condStr = "false";
        } else if (condType.isPointer) {
            let boolReg = "%cond_ptr_bool_" + this.idToStr(inst.trueBlock);
            this.output.push(boolReg);
            this.output.push(" = icmp ne ptr ");
            this.output.push(condStr);
            this.output.push(", null\n");
            condStr = boolReg;
        } else if (condType.name != "bool") {
            let truncReg = "%cond_trunc_" + this.idToStr(inst.trueBlock);
            this.output.push(truncReg);
            this.output.push(" = trunc ");
            this.output.push(this.emitType(condType));
            this.output.push(" ");
            this.output.push(condStr);
            this.output.push(" to i1\n");
            condStr = truncReg;
        }
        this.output.push("br i1 ");
        this.output.push(condStr);
        this.output.push(", label %bb");
        this.output.push(this.idToStr(inst.trueBlock));
        this.output.push(", label %bb");
        this.output.push(this.idToStr(inst.falseBlock));
        this.output.push("\n");
    }

    private emitJumpInst(inst: MIRInst): void {
        this.output.push("br label %bb");
        this.output.push(this.idToStr(inst.targetBlock));
        this.output.push("\n");
    }

    private emitAllocaInst(inst: MIRInst): void {
        this.output.push(this.emitValue(inst.result));
        this.output.push(" = alloca ");
        this.output.push(this.emitType(inst.allocType));
        this.output.push("\n");
    }

    private emitGetElementPtrInst(inst: MIRInst): void {
        this.output.push(this.emitValue(inst.result));
        this.output.push(" = getelementptr ");
        this.output.push(this.emitType(inst.basePtr.valueType));
        this.output.push(", ptr ");
        this.output.push(this.emitValue(inst.basePtr));
        this.output.push(", i32 ");
        this.output.push(this.emitValue(inst.indexValue));
        this.output.push("\n");
    }

    private emitIncrefInst(inst: MIRInst): void {
        this.output.push("call void @tsn_incref(ptr ");
        this.output.push(this.emitValue(inst.value));
        this.output.push(")\n");
    }

    private emitDecrefInst(inst: MIRInst): void {
        this.output.push("call void @tsn_decref(ptr ");
        this.output.push(this.emitValue(inst.value));
        this.output.push(")\n");
    }

    private emitIntToPtrInst(inst: MIRInst): void {
        this.output.push(this.emitValue(inst.result));
        this.output.push(" = inttoptr ");
        this.output.push(this.emitType(inst.value.valueType));
        this.output.push(" ");
        this.output.push(this.emitValue(inst.value));
        this.output.push(" to ptr\n");
    }

    private emitPtrToIntInst(inst: MIRInst): void {
        this.output.push(this.emitValue(inst.result));
        this.output.push(" = ptrtoint ptr ");
        this.output.push(this.emitValue(inst.value));
        this.output.push(" to i64\n");
    }

    private emitType(t: MIRType): string {
        if (t.isPointer) {
            return "ptr";
        }
        
        // Primitive types
        if (t.name == "i32") return "i32";
        if (t.name == "i64") return "i64";
        if (t.name == "i8") return "i8";
        if (t.name == "i16") return "i16";
        if (t.name == "f32") return "float";
        if (t.name == "f64") return "double";
        if (t.name == "bool") return "i1";
        if (t.name == "void") return "void";
        
        // Reference types (all pointers in LLVM)
        if (t.name == "string") return "ptr";
        if (t.name == "Array") return "ptr";
        
        // Struct types - use %TypeName format
        return "%" + t.name;
    }

    private emitValue(v: MIRValue): string {
        if (v.kind == "Constant") {
            let c = v;
            if (c.valueType.name == "string") {
                let idx = this.findStringLiteral(c.constantValue);
                if (idx == 0 - 1) {
                    // String not found, add it to the list
                    idx = this.stringLiterals.length;
                    this.stringLiterals.push(c.constantValue);
                }
                return "@.str." + this.idToStr(idx);
            }
            if (c.valueType.isPointer && c.constantValue == "0") {
                return "null";
            }
            return c.constantValue;
        }
        if (v.kind == "Register") {
            let r = v;
            return "%r" + this.idToStr(r.registerId);
        }
        if (v.kind == "Global") {
            let g = v;
            return "@" + g.globalName;
        }
        return "%unknown";
    }

    private idToStr(id: i32): string {
        // Convert integer to string
        if (id == 0) return "0";
        
        let isNegative = false;
        if (id < 0) {
            isNegative = true;
            id = 0 - id;
        }
        
        let digits = "";
        while (id > 0) {
            let digit = id % 10;
            if (digit == 0) digits = "0" + digits;
            else if (digit == 1) digits = "1" + digits;
            else if (digit == 2) digits = "2" + digits;
            else if (digit == 3) digits = "3" + digits;
            else if (digit == 4) digits = "4" + digits;
            else if (digit == 5) digits = "5" + digits;
            else if (digit == 6) digits = "6" + digits;
            else if (digit == 7) digits = "7" + digits;
            else if (digit == 8) digits = "8" + digits;
            else if (digit == 9) digits = "9" + digits;
            id = id / 10;
        }
        
        if (isNegative) {
            return "-" + digits;
        }
        return digits;
    }

    @unsafe private pushString(arr: Array<string>, item: string): void {
        class_incref(item);
        arr.push(item);
    }

    @unsafe private getString(arr: Array<string>, index: i32): string {
        let res = arr.get(index);
        class_incref(res);
        return res;
    }

    @unsafe private findStringLiteral(s: string): i32 {
        let i = 0;
        while (i < this.stringLiterals.length) {
            let item = this.getString(this.stringLiterals, i);
            if (item == s) {
                return i;
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    private collectStringLiterals(): void {
        log("--- collectStringLiterals: start");
        log("--- functions.length: " + this.idToStr(this.module.functions.length));
        let i = 0;
        while (i < this.module.functions.length) {
            log("--- functions get index " + this.idToStr(i));
            let func = this.module.functions.get(i);
            log("--- functions got " + func.name);
            this.collectFuncStrings(func);
            i = i + 1;
        }
        log("--- collectStringLiterals: end");
    }

    private collectFuncStrings(func: MIRFunction): void {
        log("--- collectFuncStrings: start for " + func.name);
        log("--- blocks.length: " + this.idToStr(func.blocks.length));
        let i = 0;
        while (i < func.blocks.length) {
            log("--- blocks get index " + this.idToStr(i));
            let block = func.blocks.get(i);
            log("--- block instructions length: " + this.idToStr(block.instructions.length));
            this.collectBlockStrings(block);
            i = i + 1;
        }
        log("--- collectFuncStrings: end");
    }

    private collectBlockStrings(block: MIRBasicBlock): void {
        let i = 0;
        while (i < block.instructions.length) {
            log("--- inst get index " + this.idToStr(i));
            let inst = block.instructions.get(i);
            log("--- inst opcode: " + inst.opcode);
            this.collectInstStrings(inst);
            i = i + 1;
        }
    }

    private collectInstStrings(inst: MIRInst): void {
        if (inst.opcode == "Binary") {
            let bin = inst;
            this.checkAndAddString(bin.leftOperand);
            this.checkAndAddString(bin.rightOperand);
        } else if (inst.opcode == "Store") {
            let st = inst;
            this.checkAndAddString(st.value);
        } else if (inst.opcode == "Call") {
            let cl = inst;
            if (cl.callArgs != null) {
                let i = 0;
                while (i < cl.callArgs.length) {
                    this.checkAndAddString(cl.callArgs.get(i));
                    i = i + 1;
                }
            }
        } else if (inst.opcode == "Return") {
            let rt = inst;
            this.checkAndAddString(rt.value);
        } else if (inst.opcode == "Branch") {
            let br = inst;
            this.checkAndAddString(br.condition);
        } else if (inst.opcode == "Incref") {
            let inc = inst;
            this.checkAndAddString(inc.value);
        } else if (inst.opcode == "Decref") {
            let dec = inst;
            this.checkAndAddString(dec.value);
        }
    }

    private checkAndAddString(v: MIRValue): void {
        if (v == null) return;
        if (v.kind == "Constant") {
            let c = v;
            if (c.valueType.name == "string") {
                let idx = this.findStringLiteral(c.constantValue);
                if (idx < 0) {
                    this.pushString(this.stringLiterals, c.constantValue);
                }
            }
        }
    }

    private escapeString(s: string): string {
        let res = "";
        let i = 0;
        while (i < s.length) {
            let ch = s.charCodeAt(i);
            if (ch == 10) {
                res = res + "\\0A";
            } else if (ch == 13) {
                res = res + "\\0D";
            } else if (ch == 9) {
                res = res + "\\09";
            } else if (ch == 34) {
                res = res + "\\22";
            } else if (ch == 92) {
                res = res + "\\5C";
            } else if (ch >= 32 && ch <= 126) {
                res = res + s.slice(i, i + 1);
            } else {
                res = res + "\\" + this.byteToHex(ch);
            }
            i = i + 1;
        }
        return res;
    }

    private byteToHex(b: i32): string {
        let high = (b / 16) % 16;
        let low = b % 16;
        return this.hexDigit(high) + this.hexDigit(low);
    }

    private hexDigit(d: i32): string {
        if (d == 0) return "0";
        if (d == 1) return "1";
        if (d == 2) return "2";
        if (d == 3) return "3";
        if (d == 4) return "4";
        if (d == 5) return "5";
        if (d == 6) return "6";
        if (d == 7) return "7";
        if (d == 8) return "8";
        if (d == 9) return "9";
        if (d == 10) return "A";
        if (d == 11) return "B";
        if (d == 12) return "C";
        if (d == 13) return "D";
        if (d == 14) return "E";
        if (d == 15) return "F";
        return "0";
    }

    private emitStringLiteralDefinition(idx: i32, s: string): void {
        let len = s.length;
        let lenPlusOne = len + 1;
        let escaped = this.escapeString(s);
        
        this.output.push("@.str.");
        this.output.push(this.idToStr(idx));
        this.output.push(" = private unnamed_addr constant { i32, i32, [");
        this.output.push(this.idToStr(lenPlusOne));
        this.output.push(" x i8] } { i32 -1, i32 ");
        this.output.push(this.idToStr(len));
        this.output.push(", [");
        this.output.push(this.idToStr(lenPlusOne));
        this.output.push(" x i8] c\"");
        this.output.push(escaped);
        this.output.push("\\00\" }, align 8\n");
    }

    private joinOutput(): string {
        if (this.output.length == 0) return "";
        return this.recursiveJoin(0, this.output.length);
    }

    private recursiveJoin(start: i32, end: i32): string {
        let count = end - start;
        if (count == 0) return "";
        if (count == 1) return this.output.get(start);
        
        let mid = start + (count / 2);
        let left = this.recursiveJoin(start, mid);
        let right = this.recursiveJoin(mid, end);
        return left + right;
    }
}

function main_codegen(): i32 {
    log("MIR Codegen test");
    return 0;
}



