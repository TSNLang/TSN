declare function print_i32(n: i32): void;
import { Array } from "std:array";
import { log } from "std:console";
import { MIRModule, MIRFunction, MIRBasicBlock, MIRType, MIRValue, MIRRegister, MIRConstant, MIRGlobal, MIRInst, MIRBinaryInst, MIRLoadInst, MIRStoreInst, MIRCallInst, MIRReturnInst, MIRBranchInst, MIRJumpInst, MIRAllocaInst, MIRGetElementPtrInst, MIRIncrefInst, MIRDecrefInst, MIRIntToPtrInst, MIRPtrToIntInst } from "./mir.tsn";
import { Program, Declaration, ClassMemberDecl, Stmt, BlockStmt, VarDeclStmt, ExprStmt, ReturnStmt, IfStmt, WhileStmt, ForStmt, Expr, IdentifierExpr, NumberLiteral, StringLiteral, BooleanLiteral, CallExpr, BinaryExpr } from "./ast.tsn";

// Class Registry: Lưu thông tin metadata của các class
export class ClassFieldInfo {
    public name: string;
    public typeText: string;
    public offset: i32;
    public index: i32;

    constructor(name: string, typeText: string, index: i32) {
        this.name = name;
        this.typeText = typeText;
        this.index = index;
        this.offset = 0; // Sẽ được tính toán sau
    }
}

export class ClassMethodInfo {
    public name: string;
    public index: i32;

    constructor(name: string, index: i32) {
        this.name = name;
        this.index = index;
    }
}

export class ClassInfo {
    public name: string;
    public fields: Array<ClassFieldInfo>;
    public methods: Array<ClassMethodInfo>;
    public size: i32;

    constructor(name: string) {
        this.name = name;
        this.fields = new Array<ClassFieldInfo>();
        this.methods = new Array<ClassMethodInfo>();
        this.size = 8; // Bắt đầu với 8 bytes cho vtable pointer
    }

    public addField(field: ClassFieldInfo): void {
        this.fields.push(field);
    }

    public addMethod(method: ClassMethodInfo): void {
        this.methods.push(method);
    }

    public getFieldByName(name: string): ClassFieldInfo {
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let f = this.fields.get(i);
            if (f.name == name) {
                return f;
            }
        }
        return null as ClassFieldInfo;
    }

    public getFieldIndex(fieldName: string): i32 {
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let f = this.fields.get(i);
            if (f.name == fieldName) {
                return f.index;
            }
        }
        return -1;
    }

    public getFieldOffset(fieldName: string): i32 {
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let f = this.fields.get(i);
            if (f.name == fieldName) {
                return f.offset;
            }
        }
        return -1;
    }

    public getMethodIndex(methodName: string): i32 {
        for (let i = 0; i < this.methods.length; i = i + 1) {
            let m = this.methods.get(i);
            if (m.name == methodName) {
                return m.index;
            }
        }
        return -1;
    }

    public computeFieldOffsets(): void {
        log("ClassInfo.computeFieldOffsets for " + this.name);
        let currentOffset = 8; // Offset 0 là vtable pointer
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let field = this.fields.get(i);
            field.offset = currentOffset;
            
            // Tính kích thước của field dựa trên type
            let fieldSize = 8; // Mặc định là 8 bytes (pointer hoặc i64)
            if (field.typeText == "i32") fieldSize = 4;
            else if (field.typeText == "i16") fieldSize = 2;
            else if (field.typeText == "i8") fieldSize = 1;
            else if (field.typeText == "bool") fieldSize = 1;
            else if (field.typeText == "f32") fieldSize = 4;
            else if (field.typeText == "f64") fieldSize = 8;
            else if (field.typeText == "i64") fieldSize = 8;
            
            currentOffset = currentOffset + fieldSize;
        }
        this.size = currentOffset;
        log("ClassInfo: total size = ");
        print_i32(this.size);
    }
}

export class MIRBuilder {
    private module: MIRModule;
    private currentFunction: MIRFunction;
    private currentBlockId: i32;
    private locals: Array<string>;
    private localAddrs: Array<MIRValue>;
    private paramNames: Array<string>;
    private paramTypeTexts: Array<string>;
    private classRegistry: Array<ClassInfo>;
    private classNames: Array<string>;

    constructor(moduleName: string) {
        this.module = new MIRModule(moduleName);
        this.currentFunction = null;
        this.currentBlockId = -1;
        this.locals = new Array<string>();
        this.localAddrs = new Array<MIRValue>();
        this.paramNames = new Array<string>();
        this.paramTypeTexts = new Array<string>();
        this.classRegistry = new Array<ClassInfo>();
        this.classNames = new Array<string>();
    }

    public build(program: Program): MIRModule {
        log("MIRBuilder.build: start");
        
        // Phase 1: Collect class metadata
        log("MIRBuilder.build: Phase 1 - Collecting class metadata");
        for (let i = 0; i < program.declarations.length; i = i + 1) {
            let decl = program.declarations.get(i);
            if (decl.kind == "ClassDecl") {
                this.collectClassMetadata(decl);
            }
        }
        
        // Phase 2: Compute field offsets for all classes
        log("MIRBuilder.build: Phase 2 - Computing field offsets");
        for (let i = 0; i < this.classRegistry.length; i = i + 1) {
            let classInfo = this.classRegistry.get(i);
            classInfo.computeFieldOffsets();
        }
        
        // Phase 3: Build functions and methods
        log("MIRBuilder.build: Phase 3 - Building functions");
        for (let i = 0; i < program.declarations.length; i = i + 1) {
            this.buildDeclaration(program.declarations.get(i));
        }
        
        log("MIRBuilder.build: complete");
        return this.module;
    }

    private buildDeclaration(decl: Declaration): void {
        if (decl.kind == "FunctionDecl") {
            // Skip function declarations without body (external/declare functions)
            if (decl.body != null) {
                this.buildFunction(decl);
            }
        } else if (decl.kind == "ClassDecl") {
            this.buildClass(decl);
        }
    }

    private collectClassMetadata(decl: Declaration): void {
        log("MIRBuilder.collectClassMetadata: " + decl.name);
        
        let classInfo = new ClassInfo(decl.name);
        
        // Collect fields and methods from class members
        if (decl.members != null) {
            let fieldIndex = 0;
            for (let i = 0; i < decl.members.length; i = i + 1) {
                let member = decl.members.get(i);
                
                if (member.kind == "FieldDecl") {
                    // Thu thập thông tin field
                    let fieldInfo = new ClassFieldInfo(member.name, member.typeText, fieldIndex);
                    classInfo.addField(fieldInfo);
                    log("  Field: " + member.name + " : " + member.typeText);
                    fieldIndex = fieldIndex + 1;
                } else if (member.kind == "MethodDecl" || member.kind == "ConstructorDecl") {
                    // Thu thập tên method
                    let methodInfo = new ClassMethodInfo(member.name, classInfo.methods.length);
                    classInfo.addMethod(methodInfo);
                    log("  Method: " + member.name);
                }
            }
        }
        
        // Lưu vào registry
        this.classRegistry.push(classInfo);
        this.classNames.push(decl.name);
        log("MIRBuilder: Registered class " + decl.name);
    }

    private getClassInfo(className: string): ClassInfo {
        for (let i = 0; i < this.classNames.length; i = i + 1) {
            if (this.classNames.get(i) == className) {
                return this.classRegistry.get(i);
            }
        }
        return null as ClassInfo;
    }

    private buildFunction(decl: Declaration): void {
        log("MIRBuilder.buildFunction: " + decl.name);
        log("MIRBuilder.buildFunction: reading detailA");
        let detailA = decl.detailA;
        log("MIRBuilder.buildFunction: detailA read = " + detailA);
        
        // Clear locals from previous function
        this.clearLocals();
        
        // Parse return type from detailA (e.g., "i32", "void")
        let returnType = this.parseType(decl.detailA);
        log("MIRBuilder.buildFunction: returnType parsed");
        let func = this.createFunction(decl.name, returnType);
        log("MIRBuilder.buildFunction: function created");
        
        // Add parameters
        log("MIRBuilder.buildFunction: params.length = ");
        print_i32(decl.params.length);
        // Reset param names for this function
        this.paramNames = new Array<string>();
        this.paramTypeTexts = new Array<string>();
        for (let i = 0; i < decl.params.length; i = i + 1) {
            let param = decl.params.get(i);
            let paramType = this.parseType(param.typeText);
            let paramReg = func.createRegister(paramType);
            // Track param name and type text; func.params gets ownership of paramReg
            this.paramNames.push(param.name);
            this.paramTypeTexts.push(param.typeText);
            func.params.push(paramReg);
        }
        
        log("MIRBuilder.buildFunction: checking body");
        // Build function body if it exists
        if (decl.body != null) {
            log("MIRBuilder.buildFunction: body exists, analyzing");
            this.analyzeStatement(decl.body);
            
            // Check if current block has a terminator
            let currentBlock = this.getCurrentBlock();
            let hasTerminator = false;
            if (currentBlock.instructions.length > 0) {
                let lastInst = currentBlock.instructions.get(currentBlock.instructions.length - 1);
                if (lastInst.opcode == "Return" || lastInst.opcode == "Branch" || lastInst.opcode == "Jump") {
                    hasTerminator = true;
                }
            }
            if (!hasTerminator) {
                if (returnType.name == "void") {
                    let voidVal = this.createConstant("0", new MIRType("void", false, 0));
                    this.createReturn(voidVal);
                } else {
                    let defaultVal = this.createConstant("0", returnType);
                    this.createReturn(defaultVal);
                }
            }
        } else {
            // No body - create default return
            if (returnType.name == "void") {
                let voidVal = this.createConstant("0", new MIRType("void", false, 0));
                this.createReturn(voidVal);
            } else {
                let defaultVal = this.createConstant("0", returnType);
                this.createReturn(defaultVal);
            }
        }
        
        this.module.functions.push(func);
    }
    
    private parseType(typeText: string): MIRType {
        if (typeText == "i32") return new MIRType("i32", false, 4);
        if (typeText == "i64") return new MIRType("i64", false, 8);
        if (typeText == "i8") return new MIRType("i8", false, 1);
        if (typeText == "i16") return new MIRType("i16", false, 2);
        if (typeText == "f32") return new MIRType("f32", false, 4);
        if (typeText == "f64") return new MIRType("f64", false, 8);
        if (typeText == "bool") return new MIRType("bool", false, 1);
        if (typeText == "void") return new MIRType("void", false, 0);
        if (typeText == "string") return new MIRType("string", true, 8);
        if (typeText == "ptr") return new MIRType("ptr", true, 8);
        // Unknown types are reference types (objects/classes) - represented as ptr
        return new MIRType(typeText, true, 8);
    }

    public createFunction(name: string, returnType: MIRType): MIRFunction {
        let func = new MIRFunction(name, returnType);
        this.currentFunction = func;
        let entryId = func.createBlock("entry");
        this.currentBlockId = entryId;
        return func;
    }

    public getModule(): MIRModule {
        return this.module;
    }

    private analyzeStatement(stmt: Stmt): void {
        log("analyzeStatement: enter, kind = " + stmt.kind);
        if (stmt.kind == "BlockStmt") {
            log("analyzeStatement: BlockStmt, casting");
            let block = stmt as BlockStmt;
            log("analyzeStatement: cast done, reading statements");
            let stmts = block.statements;
            log("analyzeStatement: statements read, getting length");
            let len = stmts.length;
            log("analyzeStatement: BlockStmt, statements.length = ");
            print_i32(len);
            for (let i = 0; i < block.statements.length; i = i + 1) {
                log("analyzeStatement: processing statement index = ");
                print_i32(i);
                this.analyzeStatement(block.statements.get(i));
            }
        } else if (stmt.kind == "VarDeclStmt") {
            log("analyzeStatement: VarDeclStmt, casting");
            let varDecl = stmt as VarDeclStmt;
            log("analyzeStatement: VarDeclStmt, analyzing init expr");
            let val = this.analyzeExpression(varDecl.init);
            log("analyzeStatement: VarDeclStmt, expr analyzed");
            // Allocate space for the variable
            let addr = this.createAlloca(val.valueType);
            this.createStore(val, addr);
            // Add to symbol table
            this.addLocal(varDecl.name, addr);
        } else if (stmt.kind == "ExprStmt") {
            log("analyzeStatement: ExprStmt, casting");
            let exprStmt = stmt as ExprStmt;
            log("analyzeStatement: ExprStmt, analyzing expr");
            this.analyzeExpression(exprStmt.expr);
            log("analyzeStatement: ExprStmt, done");
        } else if (stmt.kind == "ReturnStmt") {
            let retStmt = stmt as ReturnStmt;
            let val: MIRValue = null;
            if (retStmt.value == null) {
                val = this.createConstant("0", this.currentFunction.returnType);
            } else {
                val = this.analyzeExpression(retStmt.value);
                // Type coercion: if return value type doesn't match function return type, cast it
                if (val.valueType.name != this.currentFunction.returnType.name) {
                    // If function returns bool but value is i32, truncate to i1
                    if (this.currentFunction.returnType.name == "bool" && val.valueType.name == "i32") {
                        let constValue = "0";
                        if (val.kind == "Constant") {
                            constValue = (val as MIRConstant).value;
                        }
                        val = this.createConstant(constValue, this.currentFunction.returnType);
                    }
                }
            }
            this.createReturn(val);
        } else if (stmt.kind == "IfStmt") {
            let ifStmt = stmt as IfStmt;
            let cond = this.analyzeExpression(ifStmt.condition);
            let thenId = this.createBasicBlock("if.then");
            let elseId = this.createBasicBlock("if.else");
            let mergeId = this.createBasicBlock("if.merge");

            this.createBranch(cond, thenId, elseId);

            this.setInsertPoint(thenId);
            this.analyzeStatement(ifStmt.thenBranch);
            this.createJump(mergeId);

            this.setInsertPoint(elseId);
            if (ifStmt.elseBranch != null) {
                this.analyzeStatement(ifStmt.elseBranch);
            }
            this.createJump(mergeId);

            this.setInsertPoint(mergeId);
        } else if (stmt.kind == "WhileStmt") {
            let whileStmt = stmt as WhileStmt;
            let condId = this.createBasicBlock("while.cond");
            let bodyId = this.createBasicBlock("while.body");
            let endId = this.createBasicBlock("while.end");

            this.createJump(condId);
            this.setInsertPoint(condId);
            let cond = this.analyzeExpression(whileStmt.condition);
            this.createBranch(cond, bodyId, endId);

            this.setInsertPoint(bodyId);
            this.analyzeStatement(whileStmt.body);
            this.createJump(condId);

            this.setInsertPoint(endId);
        }
    }

    private analyzeExpression(expr: Expr): MIRValue {
        if (expr == null) {
            log("analyzeExpression: expr is NULL!");
            return this.createConstant("0", new MIRType("i32", false, 4));
        }
        log("analyzeExpression: expr.kind = " + expr.kind);
        if (expr.kind == "NumberLiteral") {
            let lit = expr as NumberLiteral;
            // Check if it's a float
            if (lit.value.indexOf(".") != -1) {
                return this.createConstant(lit.value, new MIRType("f32", false, 4));
            }
            return this.createConstant(lit.value, new MIRType("i32", false, 4));
        } else if (expr.kind == "StringLiteral") {
            let lit = expr as StringLiteral;
            return this.createConstant(lit.value, new MIRType("string", true, 8));
        } else if (expr.kind == "BooleanLiteral") {
            let lit = expr as BooleanLiteral;
            let val = "0";
            if (lit.value) {
                val = "1";
            }
            return this.createConstant(val, new MIRType("bool", false, 1));
        } else if (expr.kind == "NullLiteral") {
            // null is a pointer constant
            return this.createConstant("0", new MIRType("ptr", true, 8));
        } else if (expr.kind == "BinaryExpr") {
            let bin = expr as BinaryExpr;
            // Handle assignment separately
            if (bin.operator == "=") {
                // Left side must be an identifier (variable name)
                if (bin.left.kind == "Identifier") {
                    let id = bin.left as IdentifierExpr;
                    let addr = this.findLocal(id.name);
                    if (addr != null) {
                        let right = this.analyzeExpression(bin.right);
                        this.createStore(right, addr);
                        return right;
                    }
                }
                // Fallback: just evaluate right side
                return this.analyzeExpression(bin.right);
            }
            let left = this.analyzeExpression(bin.left);
            let right = this.analyzeExpression(bin.right);
            return this.createBinary(bin.operator, left, right);
        } else if (expr.kind == "Identifier") {
            let id = expr as IdentifierExpr;
            // Special case: null is a pointer constant
            if (id.name == "null") {
                return this.createConstant("0", new MIRType("ptr", true, 8));
            }
            // Look up variable in symbol table
            // First check if it's a function parameter (accessed by register id directly, no load needed)
            let paramIdx = this.findParamIndex(id.name);
            if (paramIdx >= 0) {
                // Re-create the param register by index (same id as when it was created: params are r0, r1, ...)
                let typeText = this.paramTypeTexts.get(paramIdx);
                let paramType = this.parseType(typeText);
                return new MIRRegister(paramType, paramIdx);
            }
            let addr = this.findLocal(id.name);
            if (addr != null) {
                // Load the value from the address
                return this.createLoad(addr);
            }
            // If not found, return a dummy constant
            return this.createConstant("0", new MIRType("i32", false, 4));
        } else if (expr.kind == "CallExpr") {
            log("analyzeExpression: processing CallExpr");
            let call = expr as CallExpr;
            if (call.args == null) {
                log("CallExpr error: args is NULL!");
            } else {
                log("CallExpr args length =");
                print_i32(call.args.length);
            }
            let args = new Array<MIRValue>();
            for (let i = 0; i < call.args.length; i = i + 1) {
                log("CallExpr: analyzing arg index =");
                print_i32(i);
                args.push(this.analyzeExpression(call.args.get(i)));
            }
            log("CallExpr: args analyzed");
            let calleeName = "unknown";
            if (call.callee == null) {
                log("CallExpr error: callee is NULL!");
            } else {
                log("CallExpr: callee.kind = " + call.callee.kind);
                if (call.callee.kind == "Identifier") {
                    let calleeId = call.callee as IdentifierExpr;
                    calleeName = calleeId.name;
                } else if (call.callee.kind == "MemberExpr") {
                    // Handle qualified calls like memory.offset()
                    let memberExpr = call.callee as MemberExpr;
                    calleeName = memberExpr.member;
                    log("CallExpr: MemberExpr callee, member = " + calleeName);
                    
                    // Special case: ptr.get() with no args = pointer dereference
                    if (calleeName == "get" && call.args.length == 0) {
                        log("CallExpr: detected ptr.get() dereference pattern");
                        let ptrValue = this.analyzeExpression(memberExpr.object);
                        // Determine result type from context - default to i32
                        let resultType = new MIRType("i32", false, 4);
                        let resultReg = this.currentFunction.createRegister(resultType);
                        let loadInst = new MIRLoadInst(resultReg, ptrValue);
                        this.getCurrentBlock().instructions.push(loadInst);
                        return resultReg;
                    }
                }
            }
            log("CallExpr: calling createCall for " + calleeName);
            // Hardcode return types for known functions
            let returnType = new MIRType("i32", false, 4);
            // FFI functions that return pointers
            if (calleeName == "GetProcessHeap") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "tsn_HeapAlloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "tsn_HeapReAlloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "HeapAlloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "GetStdHandle") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "CreateFileA") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "ArgsIterator") { returnType = new MIRType("ptr", true, 8); }
            // Memory allocation functions
            else if (calleeName == "alloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "allocate") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "allocOwned") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "offset") { returnType = new MIRType("ptr", true, 8); }
            // Array/collection methods that return elements (assume ptr for objects)
            else if (calleeName == "get") { returnType = new MIRType("ptr", true, 8); }
            // Result/Option methods
            else if (calleeName == "value") { returnType = new MIRType("ptr", true, 8); }
            // Lexer methods
            else if (calleeName == "tokenize") { returnType = new MIRType("ptr", true, 8); }
            return this.createCall(calleeName, args, returnType);
        } else if (expr.kind == "NewExpr") {
            // new ClassName(...) returns a pointer to the object
            log("analyzeExpression: processing NewExpr");
            let newExpr = expr as NewExpr;
            let args = new Array<MIRValue>();
            for (let i = 0; i < newExpr.args.length; i = i + 1) {
                args.push(this.analyzeExpression(newExpr.args.get(i)));
            }
            // Call constructor (treated as regular function call)
            // Constructor returns ptr to allocated object
            return this.createCall(newExpr.className, args, new MIRType("ptr", true, 8));
        } else if (expr.kind == "MemberExpr") {
            // Field access: obj.field
            // Level 2 compiler limitation: we don't have class definitions,
            // so we can't properly compile field access
            // For now, just return a dummy ptr value
            // This will cause runtime errors but allows compilation to proceed
            log("analyzeExpression: MemberExpr not fully supported in Level 2");
            return this.createConstant("0", new MIRType("ptr", true, 8));
        }
        return this.createConstant("0", new MIRType("i32", false, 4));
    }

    public setInsertPoint(blockId: i32): void {
        this.currentBlockId = blockId;
    }

    private buildClass(decl: Declaration): void {
        log("MIRBuilder.buildClass: " + decl.name);
        for (let i = 0; i < decl.members.length; i = i + 1) {
            let m = decl.members.get(i);
            if (m.kind == "MethodDecl") {
                this.buildMethod(decl.name, m);
            }
        }
    }

    private buildMethod(className: string, member: ClassMemberDecl): void {
        let fullName = className + "." + member.name;
        log("MIRBuilder.buildMethod: " + fullName);
        // Clear locals from previous function
        this.clearLocals();

        let returnType = this.parseType(member.returnTypeText);
        let func = this.createFunction(fullName, returnType);
        
        // Add implicit 'this' parameter as the first parameter
        log("MIRBuilder.buildMethod: adding implicit 'this'");
        let thisType = new MIRType("ptr", true, 8);
        let thisReg = func.createRegister(thisType);
        this.paramNames.push("this");
        this.paramTypeTexts.push(className); // Store class name as type text for 'this'
        func.params.push(thisReg);

        // Add regular parameters
        if (member.params != null) {
            for (let i = 0; i < member.params.length; i = i + 1) {
                let param = member.params.get(i);
                let paramType = this.parseType(param.typeText);
                let paramReg = func.createRegister(paramType);
                this.paramNames.push(param.name);
                this.paramTypeTexts.push(param.typeText);
                func.params.push(paramReg);
            }
        }
        
        // Build method body
        if (member.hasBody) {
            log("MIRBuilder.buildMethod: building body");
            this.analyzeStatement(member.body);
            
            // Default return if no terminator
            let currentBlock = this.getCurrentBlock();
            let hasTerminator = false;
            if (currentBlock.instructions.length > 0) {
                let lastInst = currentBlock.instructions.get(currentBlock.instructions.length - 1);
                if (lastInst.opcode == "Return" || lastInst.opcode == "Branch" || lastInst.opcode == "Jump") {
                    hasTerminator = true;
                }
            }
            if (!hasTerminator) {
                if (returnType.name == "void") {
                    this.createReturn(this.createConstant("0", new MIRType("void", false, 0)));
                } else {
                    this.createReturn(this.createConstant("0", returnType));
                }
            }
        } else {
            // Default return for empty methods
            if (returnType.name == "void") {
                this.createReturn(this.createConstant("0", new MIRType("void", false, 0)));
            } else {
                this.createReturn(this.createConstant("0", returnType));
            }
        }
        
        this.module.functions.push(func);
    }

    public createBasicBlock(label: string): i32 {
        return this.currentFunction.createBlock(label);
    }

    public createBinary(op: string, left: MIRValue, right: MIRValue): MIRRegister {
        // Comparison operators always return bool (i1)
        let resultType = left.valueType;
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            resultType = new MIRType("bool", false, 1);
            // Type coercion: if comparing ptr with non-ptr, cast non-ptr to ptr
            if (left.valueType.isPointer && !right.valueType.isPointer) {
                let rightCasted = this.createIntToPtr(right);
                let result = this.currentFunction.createRegister(resultType);
                let inst = new MIRBinaryInst(op, result, left, rightCasted);
                this.getCurrentBlock().instructions.push(inst);
                return result;
            } else if (!left.valueType.isPointer && right.valueType.isPointer) {
                let leftCasted = this.createIntToPtr(left);
                let result = this.currentFunction.createRegister(resultType);
                let inst = new MIRBinaryInst(op, result, leftCasted, right);
                this.getCurrentBlock().instructions.push(inst);
                return result;
            }
        } else if (op == "+" || op == "-") {
            // String concatenation: if both operands are pointers and op is +, use string_concat
            if (op == "+" && left.valueType.isPointer && right.valueType.isPointer) {
                // Call _T.string_concat$P.ptr.ptr(left, right)
                let args = new Array<MIRValue>();
                args.push(left);
                args.push(right);
                let ptrType = new MIRType("ptr", true, 8);
                return this.createCall("_T.concat$P.ptr.ptr", args, ptrType);
            }
            // Pointer arithmetic: if one operand is ptr and other is int, perform i64-based pointer arithmetic
            if (left.valueType.isPointer && !right.valueType.isPointer) {
                let baseInt = this.createPtrToInt(left);
                let resultInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
                let inst = new MIRBinaryInst(op, resultInt, baseInt, right);
                this.getCurrentBlock().instructions.push(inst);
                return this.createIntToPtr(resultInt);
            } else if (!left.valueType.isPointer && right.valueType.isPointer) {
                if (op == "+") {
                    let baseInt = this.createPtrToInt(right);
                    let resultInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
                    let inst = new MIRBinaryInst(op, resultInt, left, baseInt);
                    this.getCurrentBlock().instructions.push(inst);
                    return this.createIntToPtr(resultInt);
                }
            }
        } else if (left.valueType.isPointer || right.valueType.isPointer) {
            let leftInt = left;
            if (left.valueType.isPointer) {
                leftInt = this.createPtrToInt(left);
            }
            let rightInt = right;
            if (right.valueType.isPointer) {
                rightInt = this.createPtrToInt(right);
            }
            let resultInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
            let inst = new MIRBinaryInst(op, resultInt, leftInt, rightInt);
            this.getCurrentBlock().instructions.push(inst);
            return this.createIntToPtr(resultInt);
        }
        let result = this.currentFunction.createRegister(resultType);
        let inst = new MIRBinaryInst(op, result, left, right);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createLoad(address: MIRValue): MIRRegister {
        // Determine the value type stored at address
        // The alloca register type name tells us the element type
        let addrType = address.valueType;
        let elemName = addrType.name;
        // Primitives: load returns the primitive value
        let isPrim = false;
        if (elemName == "i32") isPrim = true;
        else if (elemName == "i64") isPrim = true;
        else if (elemName == "i8") isPrim = true;
        else if (elemName == "i16") isPrim = true;
        else if (elemName == "f32") isPrim = true;
        else if (elemName == "f64") isPrim = true;
        else if (elemName == "bool") isPrim = true;
        let resultType = new MIRType(elemName, false, addrType.size);
        if (!isPrim) {
            // Reference/pointer types (string, class, Array, ptr) load as ptr
            resultType = new MIRType(elemName, true, 8);
        }
        let result = this.currentFunction.createRegister(resultType);
        let inst = new MIRLoadInst(result, address);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createStore(value: MIRValue, address: MIRValue): void {
        let inst = new MIRStoreInst(value, address);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createCall(callee: string, args: Array<MIRValue>, returnType: MIRType): MIRRegister {
        let result = this.currentFunction.createRegister(returnType);
        let inst = new MIRCallInst(result, callee, args);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createReturn(value: MIRValue): void {
        let inst = new MIRReturnInst(value);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createBranch(condition: MIRValue, trueBlock: i32, falseBlock: i32): void {
        let inst = new MIRBranchInst(condition, trueBlock, falseBlock);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createJump(targetBlock: i32): void {
        let inst = new MIRJumpInst(targetBlock);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createAlloca(allocType: MIRType): MIRRegister {
        let result = this.currentFunction.createRegister(new MIRType(allocType.name, true, 8));
        let inst = new MIRAllocaInst(result, allocType);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createIncref(value: MIRValue): void {
        let inst = new MIRIncrefInst(value);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createDecref(value: MIRValue): void {
        let inst = new MIRDecrefInst(value);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createConstant(value: string, valueType: MIRType): MIRConstant {
        return new MIRConstant(valueType, value);
    }

    public createIntToPtr(value: MIRValue): MIRRegister {
        // Cast integer to pointer using inttoptr instruction
        let result = this.currentFunction.createRegister(new MIRType("ptr", true, 8));
        let inst = new MIRIntToPtrInst(result, value);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createPtrToInt(value: MIRValue): MIRRegister {
        // Cast pointer to integer using ptrtoint instruction
        let result = this.currentFunction.createRegister(new MIRType("i64", false, 8));
        let inst = new MIRPtrToIntInst(result, value);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    private getCurrentBlock(): MIRBasicBlock {
        return this.currentFunction.blocks.get(this.currentBlockId);
    }
    
    private addLocal(name: string, addr: MIRValue): void {
        this.locals.push(name);
        this.localAddrs.push(addr);
    }
    
    private findLocal(name: string): MIRValue {
        let i = 0;
        while (i < this.locals.length) {
            if (this.locals.get(i) == name) {
                return this.localAddrs.get(i);
            }
            i = i + 1;
        }
        return null as MIRValue;
    }

    private findParamIndex(name: string): i32 {
        let i = 0;
        while (i < this.paramNames.length) {
            if (this.paramNames.get(i) == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    
    private clearLocals(): void {
        log("MIRBuilder.clearLocals: start");
        this.locals = new Array<string>();
        log("MIRBuilder.clearLocals: locals reset");
        this.localAddrs = new Array<MIRValue>();
        log("MIRBuilder.clearLocals: localAddrs reset");
        this.paramNames = new Array<string>();
        log("MIRBuilder.clearLocals: paramNames reset");
        this.paramTypeTexts = new Array<string>();
        log("MIRBuilder.clearLocals: done");
    }
}
