import { log, print_i32 } from "std:console";
import { Array } from "std:array";
import { 
    Program, Declaration, ClassMemberDecl,
    Stmt, BlockStmt, VarDeclStmt, ReturnStmt, IfStmt, WhileStmt, ForStmt, ExprStmt,
    Expr, BinaryExpr, UnaryExpr, IdentifierExpr, NumberLiteral, StringLiteral, BooleanLiteral,
    MemberExpr, CallExpr, NewExpr, ThisExpr, ArrayLiteral, ParameterInfo
} from "./ast.tsn";

export class Symbol {
    public name: string;
    public symKind: string; 
    public symType: string;
    public members: Scope;

    constructor(name: string, symKind: string, symType: string) {
        this.name = name;
        this.symKind = symKind;
        this.symType = symType;
        this.members = null;
    }
}

export class Scope {
    public symbols: Array<Symbol>;
    public parent: Scope;

    constructor(parent: Scope) {
        this.symbols = new Array<Symbol>();
        this.parent = parent;
    }

    public define(symbol: Symbol): void {
        this.symbols.push(symbol);
    }

    public resolve(name: string): Symbol {
        let syms_arr = this.symbols;
        if (syms_arr == null) return null as Symbol;
        let s_count = syms_arr.length;
        let si = 0;
        while (si < s_count) {
            let s = syms_arr.get(si);
            if (s.name == name) {
                return s;
            }
            si = si + 1;
        }
        
        if (this.parent != null) {
            return this.parent.resolve(name);
        }
        
        return null as Symbol;
    }
}

export class SemanticAnalyzer {
    private globalScope: Scope;
    private currentScope: Scope;
    private currentClassName: string;

    constructor() {
        this.globalScope = new Scope(null);
        this.currentScope = this.globalScope;
        this.currentClassName = "";
    }

    public analyze(program: Program): void {
        log("Semantics: starting analysis");
        
        let decls_arr = program.declarations;
        if (decls_arr == null) return;
        let d_count = decls_arr.length;
        
        let di = 0;
        while (di < d_count) {
            let d_item = decls_arr.get(di);
            this.collectGlobalSymbol(d_item);
            di = di + 1;
        }

        let dk = 0;
        while (dk < d_count) {
            let d_item2 = decls_arr.get(dk);
            this.collectClassMembers(d_item2);
            dk = dk + 1;
        }

        let dj = 0;
        while (dj < d_count) {
            let d_item3 = decls_arr.get(dj);
            this.analyzeDeclaration(d_item3);
            dj = dj + 1;
        }
        
        log("Semantics: analysis complete");
    }

    private collectGlobalSymbol(decl: Declaration): void {
        if (decl == null) return;
        let dk = decl.kind;
        let dn = decl.name;
        if (dk == "ClassDecl") {
            let sym = new Symbol(dn, "class", dn);
            sym.members = new Scope(null);
            this.globalScope.define(sym);
        } else if (dk == "FunctionDecl") {
            this.globalScope.define(new Symbol(dn, "func", "function"));
        }
    }

    private collectClassMembers(decl: Declaration): void {
        if (decl == null) return;
        if (decl.kind != "ClassDecl") return;

        let classSym = this.globalScope.resolve(decl.name);
        if (classSym == null) return;

        let members_arr = decl.members;
        if (members_arr == null) return;
        let m_count = members_arr.length;
        let mi = 0;
        while (mi < m_count) {
            let m_node = members_arr.get(mi);
            let mk = m_node.kind;
            let csm = classSym.members;
            if (mk == "FieldDecl") {
                csm.define(new Symbol(m_node.name, "prop", m_node.typeText));
            } else if (mk == "MethodDecl" || mk == "ConstructorDecl") {
                csm.define(new Symbol(m_node.name, "method", "function"));
            }
            mi = mi + 1;
        }
    }

    private analyzeDeclaration(decl_node: Declaration): void {
        if (decl_node == null) return;
        let dk = decl_node.kind;
        if (dk == "ClassDecl") {
            this.analyzeClass(decl_node);
        } else if (dk == "FunctionDecl") {
            this.analyzeFunction(decl_node);
        }
    }

    private analyzeClass(decl: Declaration): void {
        let dn = decl.name;
        log("Semantics: analyzing class " + dn);
        this.currentClassName = dn;
        let members_arr = decl.members;
        if (members_arr == null) return;
        let m_count = members_arr.length;
        let mi = 0;
        while (mi < m_count) {
            let m_node = members_arr.get(mi);
            if (m_node.kind == "MethodDecl" || m_node.kind == "ConstructorDecl") {
                this.analyzeMethod(m_node);
            }
            mi = mi + 1;
        }
        this.currentClassName = "";
    }

    private analyzeMethod(member: ClassMemberDecl): void {
        log("Semantics: analyzing method/constructor " + member.name);
        this.enterScope();
        if (this.currentClassName != "") {
            this.currentScope.define(new Symbol("this", "var", this.currentClassName));
        }
        let params_arr = member.params;
        if (params_arr != null) {
            let p_count = params_arr.length;
            let pIdx = 0;
            while (pIdx < p_count) {
                let p_param = params_arr.get(pIdx);
                this.currentScope.define(new Symbol(p_param.name, "param", p_param.typeText));
                pIdx = pIdx + 1;
            }
        }
        if (member.hasBody) {
            this.analyzeStatement(member.body);
        }
        this.exitScope();
    }

    private analyzeFunction(decl: Declaration): void {
        log("Semantics: analyzing function " + decl.name);
        this.enterScope();
        if (decl.body != null) {
            this.analyzeStatement(decl.body);
        }
        this.exitScope();
    }

    private analyzeStatement(stmt: Stmt): void {
        if (stmt == null) return;
        let sk = stmt.kind;
        if (sk == "BlockStmt") {
            this.analyzeBlock(stmt as BlockStmt);
        } else if (sk == "VarDeclStmt") {
            this.analyzeVarDecl(stmt as VarDeclStmt);
        } else if (sk == "ExprStmt") {
            this.analyzeExprStmt(stmt as ExprStmt);
        } else if (sk == "IfStmt") {
            this.analyzeIf(stmt as IfStmt);
        } else if (sk == "WhileStmt") {
            this.analyzeWhile(stmt as WhileStmt);
        } else if (sk == "ForStmt") {
            this.analyzeFor(stmt as ForStmt);
        } else if (sk == "ReturnStmt") {
            this.analyzeReturn(stmt as ReturnStmt);
        }
    }

    private analyzeBlock(b_stmt: BlockStmt): void {
        let stmts_arr = b_stmt.statements;
        if (stmts_arr == null) return;
        let b_count = stmts_arr.length;
        let bi = 0;
        while (bi < b_count) {
            this.analyzeStatement(stmts_arr.get(bi));
            bi = bi + 1;
        }
    }

    private analyzeVarDecl(v_node: VarDeclStmt): void {
        log("Semantics: analyzeVarDecl " + v_node.name);
        this.currentScope.define(new Symbol(v_node.name, "var", v_node.typeText));
        if (v_node.init != null) {
            this.analyzeExpression(v_node.init);
        }
    }

    private analyzeExprStmt(es_stmt: ExprStmt): void {
        this.analyzeExpression(es_stmt.expr);
    }

    private analyzeIf(s_if: IfStmt): void {
        this.analyzeExpression(s_if.condition);
        this.analyzeStatement(s_if.thenBranch);
        if (s_if.elseBranch != null) {
            this.analyzeStatement(s_if.elseBranch);
        }
    }

    private analyzeWhile(w_stmt: WhileStmt): void {
        this.analyzeExpression(w_stmt.condition);
        this.analyzeStatement(w_stmt.body);
    }

    private analyzeFor(f_stmt: ForStmt): void {
        this.enterScope();
        if (f_stmt.init != null) {
            this.analyzeStatement(f_stmt.init);
        }
        if (f_stmt.condition != null) {
            this.analyzeExpression(f_stmt.condition);
        }
        if (f_stmt.update != null) {
            this.analyzeExpression(f_stmt.update);
        }
        this.analyzeStatement(f_stmt.body);
        this.exitScope();
    }

    private analyzeReturn(r_stmt: ReturnStmt): void {
        if (r_stmt.value != null) {
            this.analyzeExpression(r_stmt.value);
        }
    }

    private analyzeExpression(expr: Expr): string {
        if (expr == null) return "void";
        
        let ek = expr.kind;
        if (ek == "NumberLiteral") return "i32";
        if (ek == "StringLiteral") return "string";
        if (ek == "BooleanLiteral") return "bool";
        
        if (ek == "IdentifierExpr") {
            let ident = expr as IdentifierExpr;
            let sym = this.currentScope.resolve(ident.name);
            if (sym == null) {
                log("Semantics Error: undefined identifier " + ident.name);
                return "unknown";
            }
            return sym.symType;
        }

        if (ek == "BinaryExpr") {
            let b = expr as BinaryExpr;
            let lt = this.analyzeExpression(b.left);
            let rt = this.analyzeExpression(b.right);
            return lt;
        }

        if (ek == "UnaryExpr") {
            let u = expr as UnaryExpr;
            return this.analyzeExpression(u.operand);
        }

        if (ek == "CallExpr") {
            let call_expr = expr as CallExpr;
            this.analyzeExpression(call_expr.callee);
            let call_args_arr = call_expr.args;
            if (call_args_arr != null) {
                let call_args_count = call_args_arr.length;
                let ci = 0;
                while (ci < call_args_count) {
                    this.analyzeExpression(call_args_arr.get(ci));
                    ci = ci + 1;
                }
            }
            return "unknown"; 
        }

        if (ek == "MemberExpr") {
            let mem_expr = expr as MemberExpr;
            let objType = this.analyzeExpression(mem_expr.object);
            let propName = mem_expr.member;
            
            let classSym = this.globalScope.resolve(objType);
            if (classSym != null) {
                let csm = classSym.members;
                if (csm != null) {
                    let propSym = csm.resolve(propName);
                    if (propSym != null) {
                        return propSym.symType;
                    }
                }
            }
            return "unknown";
        }

        if (ek == "NewExpr") {
            let new_expr = expr as NewExpr;
            let new_args_arr = new_expr.args;
            if (new_args_arr != null) {
                let new_args_count = new_args_arr.length;
                let ni = 0;
                while (ni < new_args_count) {
                    this.analyzeExpression(new_args_arr.get(ni));
                    ni = ni + 1;
                }
            }
            return new_expr.className;
        }

        if (ek == "ThisExpr") {
            if (this.currentClassName != "") {
                return this.currentClassName;
            }
            return "unknown";
        }

        if (ek == "ArrayLiteral") {
            return "Array";
        }

        return "unknown";
    }

    private enterScope(): void {
        this.currentScope = new Scope(this.currentScope);
    }

    private exitScope(): void {
        if (this.currentScope.parent != null) {
            this.currentScope = this.currentScope.parent;
        }
    }
}