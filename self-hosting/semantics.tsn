import { log, print_i32 } from "std:console";
import { Array } from "std:array";
import { 
    Program, Declaration, ClassMemberDecl,
    Stmt, BlockStmt, VarDeclStmt, ReturnStmt, IfStmt, WhileStmt, ForStmt, ExprStmt,
    Expr, BinaryExpr, UnaryExpr, IdentifierExpr, NumberLiteral, StringLiteral, BooleanLiteral,
    MemberExpr, CallExpr, NewExpr, ThisExpr
} from "./ast.tsn";

export class Symbol {
    public name: string;
    public symKind: string; 
    public symType: string;

    constructor(name: string, symKind: string, symType: string) {
        this.name = name;
        this.symKind = symKind;
        this.symType = symType;
    }
}

export class Scope {
    public symbols: Array<Symbol>;
    public parent: Scope;

    constructor(parent: Scope) {
        this.symbols = new Array<Symbol>();
        this.parent = parent;
    }

    public define(symbol: Symbol): void {
        this.symbols.push(symbol);
    }

    public resolve(name: string): Symbol {
        for (let i = 0; i < this.symbols.length; i = i + 1) {
            let sym = this.symbols.get(i);
            if (sym.name == name) {
                return sym;
            }
        }
        
        if (this.parent != null) {
            return this.parent.resolve(name);
        }
        
        return null;
    }
}

export class SemanticAnalyzer {
    private globalScope: Scope;
    private currentScope: Scope;
    private currentClassName: string;

    constructor() {
        this.globalScope = new Scope(null);
        this.currentScope = this.globalScope;
        this.currentClassName = "";
    }

    public analyze(program: Program): void {
        log("Semantics: starting analysis");
        
        // Pass 1: Collect global symbols
        for (let i = 0; i < program.declarations.length; i = i + 1) {
            this.collectGlobalSymbol(program.declarations.get(i));
        }

        // Pass 2: Full analysis
        for (let i = 0; i < program.declarations.length; i = i + 1) {
            this.analyzeDeclaration(program.declarations.get(i));
        }
        
        log("Semantics: analysis complete");
    }

    private collectGlobalSymbol(decl: Declaration): void {
        if (decl.kind == "ClassDecl") {
            this.globalScope.define(new Symbol(decl.name, "class", decl.name));
        } else if (decl.kind == "FunctionDecl") {
            this.globalScope.define(new Symbol(decl.name, "func", "function"));
        }
    }

    private analyzeDeclaration(decl: Declaration): void {
        if (decl.kind == "ClassDecl") {
            this.analyzeClass(decl);
        } else if (decl.kind == "FunctionDecl") {
            this.analyzeFunction(decl);
        }
    }

    private analyzeClass(decl: Declaration): void {
        log("Semantics: analyzing class " + decl.name);
        this.currentClassName = decl.name;
        // Collect members
        for (let i = 0; i < decl.members.length; i = i + 1) {
            let m = decl.members.get(i);
            if (m.kind == "MethodDecl" || m.kind == "ConstructorDecl") {
                this.analyzeMethod(m);
            }
        }
        this.currentClassName = "";
    }

    private analyzeMethod(member: ClassMemberDecl): void {
        log("Semantics: analyzing method/constructor " + member.name);
        this.enterScope();
        // Add 'this'
        if (this.currentClassName != "") {
            this.currentScope.define(new Symbol("this", "var", this.currentClassName));
        }
        // Add parameters
        for (let i = 0; i < member.params.length; i = i + 1) {
            let p = member.params.get(i);
            this.currentScope.define(new Symbol(p.name, "param", p.typeText));
        }

        // Analyze body if exists
        // Note: For simplicity, we assume we can reach the body.
        // In ast-parser.tsn, we might need to store the body BlockStmt in ClassMemberDecl
        // but currently ast.tsn ClassMemberDecl only has bodyStatementCount.
        // Let's stub this or keep it as is if body isn't directly accessible yet.
        
        this.exitScope();
    }

    private analyzeFunction(decl: Declaration): void {
        log("Semantics: analyzing function " + decl.name);
        this.enterScope();
        // Parameters and body analysis would go here
        this.exitScope();
    }

    private analyzeStatement(stmt: Stmt): void {
        if (stmt == null) return;

        if (stmt.kind == "BlockStmt") {
            let b = stmt as BlockStmt;
            this.analyzeBlock(b);
        } else if (stmt.kind == "VarDeclStmt") {
            let v = stmt as VarDeclStmt;
            let varType = v.typeText;
            this.currentScope.define(new Symbol(v.name, "var", varType));
            if (v.init != null) {
                this.analyzeExpression(v.init);
            }
        } else if (stmt.kind == "ExprStmt") {
            let es = stmt as ExprStmt;
            this.analyzeExpression(es.expr);
        } else if (stmt.kind == "IfStmt") {
            let s = stmt as IfStmt;
            this.analyzeExpression(s.condition);
            this.analyzeStatement(s.thenBranch);
            if (s.elseBranch != null) {
                this.analyzeStatement(s.elseBranch);
            }
        } else if (stmt.kind == "WhileStmt") {
            let w = stmt as WhileStmt;
            this.analyzeExpression(w.condition);
            this.analyzeStatement(w.body);
        } else if (stmt.kind == "ForStmt") {
            let f = stmt as ForStmt;
            this.enterScope();
            this.analyzeStatement(f.init);
            if (f.condition != null) this.analyzeExpression(f.condition);
            if (f.update != null) this.analyzeExpression(f.update);
            this.analyzeStatement(f.body);
            this.exitScope();
        } else if (stmt.kind == "ReturnStmt") {
            let r = stmt as ReturnStmt;
            if (r.value != null) {
                this.analyzeExpression(r.value);
            }
        }
    }

    private analyzeExpression(expr: Expr): string {
        if (expr == null) return "void";
        
        if (expr.kind == "NumberLiteral") return "i32";
        if (expr.kind == "StringLiteral") return "string";
        if (expr.kind == "BooleanLiteral") return "bool";
        
        if (expr.kind == "Identifier") {
            let idExpr = expr as IdentifierExpr;
            let name = idExpr.name;
            let sym = this.currentScope.resolve(name);
            if (sym == null) {
                log("Semantics Error: undefined identifier " + name);
                return "unknown";
            }
            return sym.symType;
        }

        if (expr.kind == "BinaryExpr") {
            let b = expr as BinaryExpr;
            let lt = this.analyzeExpression(b.left);
            let rt = this.analyzeExpression(b.right);
            // Simple type check: must match
            if (lt != rt && lt != "unknown" && rt != "unknown") {
                log("Semantics Warning: type mismatch in binary expr " + lt + " vs " + rt);
            }
            return lt;
        }

        if (expr.kind == "UnaryExpr") {
            let u = expr as UnaryExpr;
            return this.analyzeExpression(u.operand);
        }

        if (expr.kind == "CallExpr") {
            let c = expr as CallExpr;
            let calleeType = this.analyzeExpression(c.callee);
            for (let i = 0; i < c.args.length; i = i + 1) {
                this.analyzeExpression(c.args.get(i));
            }
            // In a real compiler, look up return type from calleeType
            return "unknown"; 
        }

        if (expr.kind == "MemberExpr") {
            let m = expr as MemberExpr;
            let objType = this.analyzeExpression(m.object);
            // For now, return unknown as we don't have a class registry yet
            return "unknown";
        }

        if (expr.kind == "NewExpr") {
            let n = expr as NewExpr;
            for (let i = 0; i < n.args.length; i = i + 1) {
                this.analyzeExpression(n.args.get(i));
            }
            return n.className;
        }

        if (expr.kind == "ThisExpr") {
            return this.currentClassName != "" ? this.currentClassName : "unknown";
        }

        if (expr.kind == "ArrayLiteral") {
            let a = expr as ArrayLiteral;
            for (let i = 0; i < a.elements.length; i = i + 1) {
                this.analyzeExpression(a.elements.get(i));
            }
            return "Array";
        }

        return "unknown";
    }

    private enterScope(): void {
        this.currentScope = new Scope(this.currentScope);
    }

    private exitScope(): void {
        if (this.currentScope.parent != null) {
            this.currentScope = this.currentScope.parent;
        }
    }
}
