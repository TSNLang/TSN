declare function print_i32(n: i32): void;

import { Array } from "std:array";
import { log } from "std:console";
import { readText } from "std:fs";
import { MIRModule, MIRFunction, MIRBasicBlock, MIRType, MIRValue, MIRInst, createRegister, createConstant, createGlobal, createBinaryInst, createLoadInst, createStoreInst, createCallInst, createReturnInst, createBranchInst, createJumpInst, createAllocaInst, createGetElementPtrInst, createIncrefInst, createDecrefInst, createIntToPtrInst, createPtrToIntInst } from "./mir-flat.tsn";
import { Program, Declaration, ClassMemberDecl, Stmt, BlockStmt, VarDeclStmt, ExprStmt, ReturnStmt, IfStmt, WhileStmt, ForStmt, Expr, IdentifierExpr, NumberLiteral, StringLiteral, BooleanLiteral, CallExpr, BinaryExpr, MemberExpr, NewExpr, ThisExpr } from "./ast.tsn";

// Class Registry: Lưu thông tin metadata của các class
export class ClassFieldInfo {
    public name: string;
    public typeText: string;
    public offset: i32;
    public offsetStr: string;
    public index: i32;

    constructor(name: string, typeText: string, index: i32) {
        this.name = name;
        this.typeText = typeText;
        this.index = index;
        this.offset = 0; // Sẽ được tính toán sau
        this.offsetStr = "0";
    }
}

export class ClassMethodInfo {
    public name: string;
    public index: i32;

    constructor(name: string, index: i32) {
        this.name = name;
        this.index = index;
    }
}

export class ClassInfo {
    public name: string;
    public fields: Array<ClassFieldInfo>;
    public methods: Array<ClassMethodInfo>;
    public size: i32;
    public sizeStr: string;

    constructor(name: string) {
        this.name = name;
        this.fields = new Array<ClassFieldInfo>();
        this.methods = new Array<ClassMethodInfo>();
        this.size = 8; // Bắt đầu với 8 bytes cho vtable pointer
        this.sizeStr = "8";
    }

    public addField(field: ClassFieldInfo): void {
        this.fields.push(field);
    }

    public addMethod(method: ClassMethodInfo): void {
        this.methods.push(method);
    }

    public getFieldByName(name: string): ClassFieldInfo {
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let f = this.fields.get(i);
            if (f.name == name) {
                return f;
            }
        }
        return null as ClassFieldInfo;
    }

    public getFieldIndex(fieldName: string): i32 {
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let f = this.fields.get(i);
            if (f.name == fieldName) {
                return f.index;
            }
        }
        return -1;
    }

    public getFieldOffset(fieldName: string): i32 {
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let f = this.fields.get(i);
            if (f.name == fieldName) {
                return f.offset;
            }
        }
        return -1;
    }

    public getMethodIndex(methodName: string): i32 {
        for (let i = 0; i < this.methods.length; i = i + 1) {
            let m = this.methods.get(i);
            if (m.name == methodName) {
                return m.index;
            }
        }
        return -1;
    }

    public computeFieldOffsets(): void {
        log("ClassInfo.computeFieldOffsets for " + this.name);
        let currentOffset = 8; // Offset 0 là vtable pointer
        let currentOffsetStr = "8";
        for (let i = 0; i < this.fields.length; i = i + 1) {
            let field = this.fields.get(i);
            field.offset = currentOffset;
            field.offsetStr = currentOffsetStr;
            
            // Tính kích thước của field dựa trên type
            let fieldSize = 8; // Mặc định là 8 bytes (pointer hoặc i64)
            if (field.typeText == "i32") fieldSize = 4;
            else if (field.typeText == "i16") fieldSize = 2;
            else if (field.typeText == "i8") fieldSize = 1;
            else if (field.typeText == "bool") fieldSize = 1;
            else if (field.typeText == "f32") fieldSize = 4;
            else if (field.typeText == "f64") fieldSize = 8;
            else if (field.typeText == "i64") fieldSize = 8;
            
            currentOffset = currentOffset + fieldSize;
            // Update offset string using lookup
            if (currentOffset == 9) currentOffsetStr = "9";
            else if (currentOffset == 10) currentOffsetStr = "10";
            else if (currentOffset == 12) currentOffsetStr = "12";
            else if (currentOffset == 16) currentOffsetStr = "16";
            else if (currentOffset == 20) currentOffsetStr = "20";
            else if (currentOffset == 24) currentOffsetStr = "24";
            else if (currentOffset == 28) currentOffsetStr = "28";
            else if (currentOffset == 32) currentOffsetStr = "32";
            else if (currentOffset == 36) currentOffsetStr = "36";
            else if (currentOffset == 40) currentOffsetStr = "40";
            else if (currentOffset == 44) currentOffsetStr = "44";
            else if (currentOffset == 48) currentOffsetStr = "48";
            else if (currentOffset == 56) currentOffsetStr = "56";
            else if (currentOffset == 64) currentOffsetStr = "64";
            else if (currentOffset == 72) currentOffsetStr = "72";
            else if (currentOffset == 80) currentOffsetStr = "80";
            else if (currentOffset == 88) currentOffsetStr = "88";
            else if (currentOffset == 96) currentOffsetStr = "96";
            else if (currentOffset == 104) currentOffsetStr = "104";
            else if (currentOffset == 112) currentOffsetStr = "112";
            else if (currentOffset == 120) currentOffsetStr = "120";
            else if (currentOffset == 128) currentOffsetStr = "128";
            else currentOffsetStr = "256"; // fallback for very large structs
        }
        this.size = currentOffset;
        // Update size string using lookup
        if (currentOffset == 8) this.sizeStr = "8";
        else if (currentOffset == 9) this.sizeStr = "9";
        else if (currentOffset == 10) this.sizeStr = "10";
        else if (currentOffset == 12) this.sizeStr = "12";
        else if (currentOffset == 16) this.sizeStr = "16";
        else if (currentOffset == 20) this.sizeStr = "20";
        else if (currentOffset == 24) this.sizeStr = "24";
        else if (currentOffset == 28) this.sizeStr = "28";
        else if (currentOffset == 32) this.sizeStr = "32";
        else if (currentOffset == 36) this.sizeStr = "36";
        else if (currentOffset == 40) this.sizeStr = "40";
        else if (currentOffset == 48) this.sizeStr = "48";
        else if (currentOffset == 56) this.sizeStr = "56";
        else if (currentOffset == 64) this.sizeStr = "64";
        else if (currentOffset == 72) this.sizeStr = "72";
        else if (currentOffset == 80) this.sizeStr = "80";
        else if (currentOffset == 96) this.sizeStr = "96";
        else if (currentOffset == 128) this.sizeStr = "128";
        else this.sizeStr = "256"; // fallback for very large structs
        log("ClassInfo: total size = ");
        print_i32(this.size);
    }
}

export class MIRBuilder {
    private module: MIRModule;
    private currentFunction: MIRFunction;
    private currentBlockId: i32;
    private entryBlockId: i32;
    private locals: Array<string>;
    private localAddrs: Array<MIRValue>;
    private paramNames: Array<string>;
    private paramTypeTexts: Array<string>;
    private classRegistry: Array<ClassInfo>;
    private classNames: Array<string>;
    private currentClassName: string;
    private importedLocalNames: Array<string>;
    private importedMangledNames: Array<string>;

    constructor(moduleName: string) {
        this.module = new MIRModule(moduleName);
        this.currentFunction = null;
        this.currentBlockId = -1;
        this.entryBlockId = -1;
        this.locals = new Array<string>();
        this.localAddrs = new Array<MIRValue>();
        this.paramNames = new Array<string>();
        this.paramTypeTexts = new Array<string>();
        this.classRegistry = new Array<ClassInfo>();
        this.classNames = new Array<string>();
        this.currentClassName = "";
        this.importedLocalNames = new Array<string>();
        this.importedMangledNames = new Array<string>();
    }

    public build(program: Program): MIRModule {
        log("MIRBuilder.build: start");
        
        // Phase 1: Collect class metadata
        log("MIRBuilder.build: Phase 1 - Collecting class metadata");
        for (let i = 0; i < program.declarations.length; i = i + 1) {
            let decl = program.declarations.get(i);
            if (decl.kind == "ClassDecl") {
                this.collectClassMetadata(decl);
            }
        }
        
        // Phase 2: Compute field offsets for all classes
        log("MIRBuilder.build: Phase 2 - Computing field offsets");
        for (let i = 0; i < this.classRegistry.length; i = i + 1) {
            let classInfo = this.classRegistry.get(i);
            classInfo.computeFieldOffsets();
        }
        
        // Phase 2.5: Process imports and build symbol mappings
        log("MIRBuilder.build: Phase 2.5 - Using hardcoded mappings in CallExpr (arrays don't work)");
        
        // Phase 3: Build functions and methods
        log("MIRBuilder.build: Phase 3 - Building functions");
        for (let i = 0; i < program.declarations.length; i = i + 1) {
            this.buildDeclaration(program.declarations.get(i));
        }
        
        log("MIRBuilder.build: complete");
        return this.module;
    }

    private buildDeclaration(decl: Declaration): void {
        if (decl.kind == "FunctionDecl") {
            // Skip function declarations without body (external/declare functions)
            if (decl.body != null) {
                this.buildFunction(decl);
            }
        } else if (decl.kind == "ClassDecl") {
            this.buildClass(decl);
        }
    }

    private collectClassMetadata(decl: Declaration): void {
        log("MIRBuilder.collectClassMetadata: " + decl.name);
        
        let classInfo = new ClassInfo(decl.name);
        
        // Collect fields and methods from class members
        if (decl.members != null) {
            let fieldIndex = 0;
            for (let i = 0; i < decl.members.length; i = i + 1) {
                let member = decl.members.get(i);
                
                if (member.kind == "FieldDecl") {
                    // Thu thập thông tin field
                    let fieldInfo = new ClassFieldInfo(member.name, member.typeText, fieldIndex);
                    classInfo.addField(fieldInfo);
                    log("  Field: " + member.name + " : " + member.typeText);
                    fieldIndex = fieldIndex + 1;
                } else if (member.kind == "MethodDecl" || member.kind == "ConstructorDecl") {
                    // Thu thập tên method
                    let methodInfo = new ClassMethodInfo(member.name, classInfo.methods.length);
                    classInfo.addMethod(methodInfo);
                    log("  Method: " + member.name);
                }
            }
        }
        
        // Lưu vào registry
        this.classRegistry.push(classInfo);
        this.classNames.push(decl.name);
        log("MIRBuilder: Registered class " + decl.name);
    }

    private getClassInfo(className: string): ClassInfo {
        for (let i = 0; i < this.classNames.length; i = i + 1) {
            if (this.classNames.get(i) == className) {
                return this.classRegistry.get(i);
            }
        }
        return null as ClassInfo;
    }

    private buildFunction(decl: Declaration): void {
        log("MIRBuilder.buildFunction: " + decl.name);
        log("MIRBuilder.buildFunction: reading detailA");
        let detailA = decl.detailA;
        log("MIRBuilder.buildFunction: detailA read = " + detailA);
        
        // Clear locals from previous function
        this.clearLocals();
        
        // Parse return type from detailA (e.g., "i32", "void")
        let returnType = this.parseType(decl.detailA);
        log("MIRBuilder.buildFunction: returnType parsed");
        let func = this.createFunction(decl.name, returnType);
        log("MIRBuilder.buildFunction: function created");
        
        // Add parameters
        log("MIRBuilder.buildFunction: params.length = ");
        print_i32(decl.params.length);
        // Reset param names for this function
        this.paramNames = new Array<string>();
        this.paramTypeTexts = new Array<string>();
        for (let i = 0; i < decl.params.length; i = i + 1) {
            let param = decl.params.get(i);
            let paramType = this.parseType(param.typeText);
            let paramReg = func.createRegister(paramType);
            // Track param name and type text; func.params gets ownership of paramReg
            this.paramNames.push(param.name);
            this.paramTypeTexts.push(param.typeText);
            func.params.push(paramReg);
        }
        
        log("MIRBuilder.buildFunction: checking body");
        // Build function body if it exists
        if (decl.body != null) {
            log("MIRBuilder.buildFunction: body exists, analyzing");
            this.analyzeStatement(decl.body);
            
            // Check if current block has a terminator
            let currentBlock = this.getCurrentBlock();
            let hasTerminator = false;
            if (currentBlock.instructions.length > 0) {
                let lastInst = currentBlock.instructions.get(currentBlock.instructions.length - 1);
                if (lastInst.opcode == "Return" || lastInst.opcode == "Branch" || lastInst.opcode == "Jump") {
                    hasTerminator = true;
                }
            }
            if (!hasTerminator) {
                if (returnType.name == "void") {
                    let voidVal = this.createConstant("0", new MIRType("void", false, 0));
                    this.createReturn(voidVal);
                } else {
                    let defaultVal = this.createConstant("0", returnType);
                    this.createReturn(defaultVal);
                }
            }
        } else {
            // No body - create default return
            if (returnType.name == "void") {
                let voidVal = this.createConstant("0", new MIRType("void", false, 0));
                this.createReturn(voidVal);
            } else {
                let defaultVal = this.createConstant("0", returnType);
                this.createReturn(defaultVal);
            }
        }
        
        this.module.functions.push(func);
    }
    
    private parseType(typeText: string): MIRType {
        if (typeText == "i32") return new MIRType("i32", false, 4);
        if (typeText == "i64") return new MIRType("i64", false, 8);
        if (typeText == "i8") return new MIRType("i8", false, 1);
        if (typeText == "i16") return new MIRType("i16", false, 2);
        if (typeText == "f32") return new MIRType("f32", false, 4);
        if (typeText == "f64") return new MIRType("f64", false, 8);
        if (typeText == "bool") return new MIRType("bool", false, 1);
        if (typeText == "void") return new MIRType("void", false, 0);
        if (typeText == "string") return new MIRType("string", true, 8);
        if (typeText == "ptr") return new MIRType("ptr", true, 8);
        // Unknown types are reference types (objects/classes) - represented as ptr
        return new MIRType(typeText, true, 8);
    }

    public createFunction(name: string, returnType: MIRType): MIRFunction {
        let func = new MIRFunction(name, returnType);
        this.currentFunction = func;
        let entryId = func.createBlock("entry");
        this.currentBlockId = entryId;
        this.entryBlockId = entryId;
        return func;
    }

    public getModule(): MIRModule {
        return this.module;
    }

    private analyzeStatement(stmt: Stmt): void {
        log("analyzeStatement: enter, kind = " + stmt.kind);
        if (stmt.kind == "BlockStmt") {
            log("analyzeStatement: BlockStmt, casting");
            let block = stmt as BlockStmt;
            log("analyzeStatement: cast done, reading statements");
            let stmts = block.statements;
            log("analyzeStatement: statements read, getting length");
            let len = stmts.length;
            log("analyzeStatement: BlockStmt, statements.length = ");
            print_i32(len);
            for (let i = 0; i < block.statements.length; i = i + 1) {
                log("analyzeStatement: processing statement index = ");
                print_i32(i);
                this.analyzeStatement(block.statements.get(i));
            }
        } else if (stmt.kind == "VarDeclStmt") {
            log("analyzeStatement: VarDeclStmt, casting");
            let varDecl = stmt as VarDeclStmt;
            log("analyzeStatement: VarDeclStmt, analyzing init expr");
            let val = this.analyzeExpression(varDecl.init);
            log("analyzeStatement: VarDeclStmt, expr analyzed");
            // Allocate space for the variable
            let addr = this.createAlloca(val.valueType);
            this.createStore(val, addr);
            // Add to symbol table
            this.addLocal(varDecl.name, addr);
        } else if (stmt.kind == "ExprStmt") {
            log("analyzeStatement: ExprStmt, casting");
            let exprStmt = stmt as ExprStmt;
            // Skip empty statements (e.g., standalone semicolons)
            if (exprStmt.expr == null) {
                log("analyzeStatement: ExprStmt is empty, skipping");
            } else {
                log("analyzeStatement: ExprStmt, analyzing expr");
                this.analyzeExpression(exprStmt.expr);
            }
            log("analyzeStatement: ExprStmt, done");
        } else if (stmt.kind == "ReturnStmt") {
            let retStmt = stmt as ReturnStmt;
            let val: MIRValue = null;
            if (retStmt.value == null) {
                val = this.createConstant("0", this.currentFunction.returnType);
            } else {
                val = this.analyzeExpression(retStmt.value);
                // Type coercion: if return value type doesn't match function return type, cast it
                if (val.valueType.name != this.currentFunction.returnType.name) {
                    // If function returns bool but value is i32, truncate to i1
                    if (this.currentFunction.returnType.name == "bool" && val.valueType.name == "i32") {
                        let constValue = "0";
                        if (val.kind == "Constant") {
                            constValue = (val as MIRConstant).value;
                        }
                        val = this.createConstant(constValue, this.currentFunction.returnType);
                    }
                }
            }
            this.createReturn(val);
        } else if (stmt.kind == "IfStmt") {
            let ifStmt = stmt as IfStmt;
            let cond = this.analyzeExpression(ifStmt.condition);
            let thenId = this.createBasicBlock("if.then");
            let elseId = this.createBasicBlock("if.else");
            let mergeId = this.createBasicBlock("if.merge");

            this.createBranch(cond, thenId, elseId);

            this.setInsertPoint(thenId);
            this.analyzeStatement(ifStmt.thenBranch);
            this.createJump(mergeId);

            this.setInsertPoint(elseId);
            if (ifStmt.elseBranch != null) {
                this.analyzeStatement(ifStmt.elseBranch);
            }
            this.createJump(mergeId);

            this.setInsertPoint(mergeId);
        } else if (stmt.kind == "WhileStmt") {
            let whileStmt = stmt as WhileStmt;
            let condId = this.createBasicBlock("while.cond");
            let bodyId = this.createBasicBlock("while.body");
            let endId = this.createBasicBlock("while.end");

            this.createJump(condId);
            this.setInsertPoint(condId);
            let cond = this.analyzeExpression(whileStmt.condition);
            this.createBranch(cond, bodyId, endId);

            this.setInsertPoint(bodyId);
            this.analyzeStatement(whileStmt.body);
            this.createJump(condId);

            this.setInsertPoint(endId);
        }
    }

    private analyzeExpression(expr: Expr): MIRValue {
        if (expr == null) {
            log("analyzeExpression: expr is NULL!");
            return this.createConstant("0", new MIRType("i32", false, 4));
        }
        log("analyzeExpression: expr.kind = " + expr.kind);
        if (expr.kind == "NumberLiteral") {
            let lit = expr as NumberLiteral;
            // Check if it's a float
            if (lit.value.indexOf(".") != -1) {
                return this.createConstant(lit.value, new MIRType("f32", false, 4));
            }
            return this.createConstant(lit.value, new MIRType("i32", false, 4));
        } else if (expr.kind == "StringLiteral") {
            let lit = expr as StringLiteral;
            return this.createConstant(lit.value, new MIRType("string", true, 8));
        } else if (expr.kind == "BooleanLiteral") {
            let lit = expr as BooleanLiteral;
            let val = "0";
            if (lit.value) {
                val = "1";
            }
            return this.createConstant(val, new MIRType("bool", false, 1));
        } else if (expr.kind == "NullLiteral") {
            // null is a pointer constant
            return this.createConstant("0", new MIRType("ptr", true, 8));
        } else if (expr.kind == "BinaryExpr") {
            let bin = expr as BinaryExpr;
            // Handle assignment separately
            if (bin.operator == "=") {
                // Left side: identifier (local variable)
                if (bin.left.kind == "Identifier") {
                    let id = bin.left as IdentifierExpr;
                    let addr = this.findLocal(id.name);
                    if (addr != null) {
                        let right = this.analyzeExpression(bin.right);
                        this.createStore(right, addr);
                        return right;
                    }
                }
                // Left side: MemberExpr (this.field = value)
                if (bin.left.kind == "MemberExpr") {
                    let mem = bin.left as MemberExpr;
                    let objVal = this.analyzeExpression(mem.object);
                    let classInfo = this.getClassInfo(this.currentClassName);
                    if (classInfo != null) {
                        let fieldInfo = classInfo.getFieldByName(mem.member);
                        if (fieldInfo != null) {
                            let right = this.analyzeExpression(bin.right);
                            let fieldType = this.parseType(fieldInfo.typeText);
                            let fieldPtr = this.createFieldPtr(objVal, fieldInfo.offsetStr, fieldType);
                            this.createStore(right, fieldPtr);
                            return right;
                        }
                    }
                }
                // Fallback: just evaluate right side
                return this.analyzeExpression(bin.right);
            }
            let left = this.analyzeExpression(bin.left);
            let right = this.analyzeExpression(bin.right);
            return this.createBinary(bin.operator, left, right);
        } else if (expr.kind == "Identifier") {
            let id = expr as IdentifierExpr;
            // Special case: null is a pointer constant
            if (id.name == "null") {
                return this.createConstant("0", new MIRType("ptr", true, 8));
            }
            // Look up variable in symbol table
            // First check if it's a function parameter (accessed by register id directly, no load needed)
            let paramIdx = this.findParamIndex(id.name);
            if (paramIdx >= 0) {
                // Re-create the param register by index (same id as when it was created: params are r0, r1, ...)
                let typeText = this.paramTypeTexts.get(paramIdx);
                let paramType = this.parseType(typeText);
                return createRegister(paramType, paramIdx);
            }
            let addr = this.findLocal(id.name);
            if (addr != null) {
                // Load the value from the address
                return this.createLoad(addr);
            }
            // If not found, return a dummy constant
            return this.createConstant("0", new MIRType("i32", false, 4));
        } else if (expr.kind == "CallExpr") {
            log("analyzeExpression: processing CallExpr");
            let call = expr as CallExpr;
            if (call.args == null) {
                log("CallExpr error: args is NULL!");
            } else {
                log("CallExpr args length =");
                print_i32(call.args.length);
            }
            let args = new Array<MIRValue>();
            for (let i = 0; i < call.args.length; i = i + 1) {
                log("CallExpr: analyzing arg index =");
                print_i32(i);
                args.push(this.analyzeExpression(call.args.get(i)));
            }
            log("CallExpr: args analyzed");
            let calleeName = "unknown";
            if (call.callee == null) {
                log("CallExpr error: callee is NULL!");
            } else {
                log("CallExpr: callee.kind = " + call.callee.kind);
                if (call.callee.kind == "Identifier") {
                    let calleeId = call.callee as IdentifierExpr;
                    calleeName = calleeId.name;
                } else if (call.callee.kind == "MemberExpr") {
                    // Handle qualified calls like memory.offset() or method calls like obj.method()
                    let memberExpr = call.callee as MemberExpr;
                    calleeName = memberExpr.member;
                    log("CallExpr: MemberExpr callee, member = " + calleeName);
                    
                    // Check if this is a method call on an object (obj.method())
                    if (memberExpr.object.kind == "Identifier") {
                        let objId = memberExpr.object as IdentifierExpr;
                        let objAddr = this.findLocal(objId.name);
                        if (objAddr != null) {
                            // This is a local variable, likely an object instance
                            // Look up which class has this method
                            log("CallExpr: checking if " + objId.name + " is an object with method " + calleeName);
                            let foundClassName = "";
                            for (let i = 0; i < this.classNames.length; i = i + 1) {
                                let className = this.classNames.get(i);
                                let classInfo = this.getClassInfo(className);
                                if (classInfo != null) {
                                    let methodIdx = classInfo.getMethodIndex(calleeName);
                                    if (methodIdx >= 0) {
                                        foundClassName = className;
                                    }
                                }
                            }
                            if (foundClassName != "") {
                                // This is a method call: obj.method(args) -> ClassName.method(obj, args)
                                log("CallExpr: detected method call, class = " + foundClassName);
                                let fullMethodName = foundClassName + "." + calleeName;
                                // Load the object from local variable
                                let objPtr = this.createLoad(objAddr);
                                // Insert objPtr as first argument (this)
                                let methodArgs = new Array<MIRValue>();
                                methodArgs.push(objPtr);
                                for (let i = 0; i < args.length; i = i + 1) {
                                    methodArgs.push(args.get(i));
                                }
                                // Determine return type (comprehensive inference for method calls)
                                let methodReturnType = new MIRType("void", false, 0);
                                // ClassInfo methods
                                if (calleeName == "getFieldByName") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "getFieldIndex") { methodReturnType = new MIRType("i32", false, 4); }
                                else if (calleeName == "getFieldOffset") { methodReturnType = new MIRType("i32", false, 4); }
                                else if (calleeName == "getMethodIndex") { methodReturnType = new MIRType("i32", false, 4); }
                                else if (calleeName == "addField") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "addMethod") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "computeFieldOffsets") { methodReturnType = new MIRType("void", false, 0); }
                                // Array methods
                                else if (calleeName == "get") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "push") { methodReturnType = new MIRType("void", false, 0); }
                                // MIRBuilder/helper methods
                                else if (calleeName == "getCurrentBlock") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "analyzeExpression") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "analyzeStatement") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "createRegister") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createLoad") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createBinary") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createFieldPtr") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "parseType") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createCall") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createAlloca") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createStore") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "createIntToPtr") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "createPtrToInt") { methodReturnType = new MIRType("i64", false, 8); }
                                // MIRCodegen methods
                                else if (calleeName == "emitType") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "emitValue") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "emitInstruction") { methodReturnType = new MIRType("void", false, 0); }
                                else if (calleeName == "byteToHex") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "hexDigit") { methodReturnType = new MIRType("ptr", true, 8); }
                                else if (calleeName == "recursiveJoin") { methodReturnType = new MIRType("ptr", true, 8); }
                                // Common getters that return primitives
                                else if (calleeName == "getCount" || calleeName == "getValue" || calleeName == "getExtra") {
                                    methodReturnType = new MIRType("i32", false, 4);
                                }
                                return this.createCall(fullMethodName, methodArgs, methodReturnType);
                            }
                        }
                    }
                    
                    // Special case: ptr.get() with no args = pointer dereference
                    if (calleeName == "get" && call.args.length == 0) {
                        log("CallExpr: detected ptr.get() dereference pattern");
                        let ptrValue = this.analyzeExpression(memberExpr.object);
                        // Determine result type from context - default to i32
                        let resultType = new MIRType("i32", false, 4);
                        let resultReg = this.currentFunction.createRegister(resultType);
                        let loadInst = createLoadInst(resultReg, ptrValue);
                        this.getCurrentBlock().instructions.push(loadInst);
                        return resultReg;
                    }
                }
            }
            log("CallExpr: calling createCall for " + calleeName);
            // Hardcode return types for known functions
            let returnType = new MIRType("i32", false, 4);
            // FFI functions that return pointers
            if (calleeName == "GetProcessHeap") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "tsn_HeapAlloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "tsn_HeapReAlloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "HeapAlloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "GetStdHandle") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "CreateFileA") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "ArgsIterator") { returnType = new MIRType("ptr", true, 8); }
            // Memory allocation functions
            else if (calleeName == "alloc") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "allocate") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "allocOwned") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "offset") { returnType = new MIRType("ptr", true, 8); }
            // Array/collection methods that return elements (assume ptr for objects)
            else if (calleeName == "get") { returnType = new MIRType("ptr", true, 8); }
            // Result/Option methods
            else if (calleeName == "value") { returnType = new MIRType("ptr", true, 8); }
            // Lexer methods
            else if (calleeName == "tokenize") { returnType = new MIRType("ptr", true, 8); }
            // MIR factory functions (all return ptr to MIRValue or MIRInst objects)
            else if (calleeName == "createConstant") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createRegister") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createGlobal") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createBinaryInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createLoadInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createStoreInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createCallInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createReturnInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createBranchInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createJumpInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createAllocaInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createGetElementPtrInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createIncrefInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createDecrefInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createIntToPtrInst") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createPtrToIntInst") { returnType = new MIRType("i64", false, 8); }
            // MIRCodegen methods
            else if (calleeName == "collectStringLiterals") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "emitHeader") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "emitGlobals") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "emitFunctions") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "emitStringLiteralDefinition") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "emitType") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "joinOutput") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "recursiveJoin") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "getString") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "byteToHex") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "hexDigit") { returnType = new MIRType("ptr", true, 8); }
            // Array methods (generic arrays assumed to contain ptr objects for now)
            else if (calleeName == "get") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "push") { returnType = new MIRType("void", false, 0); }
            // ClassInfo methods
            else if (calleeName == "getFieldByName") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "getFieldIndex") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "getFieldOffset") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "getMethodIndex") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "addField") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "addMethod") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "computeFieldOffsets") { returnType = new MIRType("void", false, 0); }
            // MIRBuilder helper methods
            else if (calleeName == "getCurrentBlock") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "findLocal") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "addLocal") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "findParamIndex") { returnType = new MIRType("i32", false, 4); }
            else if (calleeName == "getClassInfo") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createRegister") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createAlloca") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createLoad") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createStore") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "parseType") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createBinary") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createFieldPtr") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createLoadTyped") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createConstant") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createCall") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createIntToPtr") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "createPtrToInt") { returnType = new MIRType("i64", false, 8); }
            else if (calleeName == "analyzeExpression") { returnType = new MIRType("ptr", true, 8); }
            else if (calleeName == "analyzeStatement") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "buildFunction") { returnType = new MIRType("void", false, 0); }
            else if (calleeName == "buildClass") { returnType = new MIRType("void", false, 0); }
            
            // Hardcoded import mapping (arrays/fields don't work with Level 1→Level 3 compilation)
            let actualName = calleeName;
            if (calleeName == "add") {
                actualName = "_T.add$P.i32.i32";
            } else if (calleeName == "multiply") {
                actualName = "_T.multiply$P.i32.i32";
            }
            log("CallExpr: mapped " + calleeName + " -> " + actualName);
            return this.createCall(actualName, args, returnType);
        } else if (expr.kind == "NewExpr") {
            log("analyzeExpression: processing NewExpr");
            let newExpr = expr as NewExpr;
            
            // Handle generic types: Array<Token> -> Array_Token
            let actualClassName = newExpr.className;
            if (newExpr.typeArgs.length > 0) {
                log("analyzeExpression: NewExpr has typeArgs");
                actualClassName = newExpr.className + "_";
                for (let i = 0; i < newExpr.typeArgs.length; i = i + 1) {
                    if (i > 0) {
                        actualClassName = actualClassName + "_";
                    }
                    actualClassName = actualClassName + newExpr.typeArgs.get(i);
                }
                log("analyzeExpression: NewExpr generic type mangled to: " + actualClassName);
            }
            
            // Look up class info to get size
            let classInfo = this.getClassInfo(actualClassName);
            if (classInfo == null) {
                log("analyzeExpression: NewExpr class not found: " + actualClassName);
                return this.createConstant("0", new MIRType("ptr", true, 8));
            }
            
            // Allocate object: call _T.alloc$P.i64(size)
            log("analyzeExpression: NewExpr allocating size = " + classInfo.sizeStr);
            let sizeVal = this.createConstant(classInfo.sizeStr, new MIRType("i64", false, 8));
            let allocArgs = new Array<MIRValue>();
            allocArgs.push(sizeVal);
            let objPtr = this.createCall("_T.alloc$P.i64", allocArgs, new MIRType("ptr", true, 8));
            
            // TODO: Initialize VTable pointer at offset 0 (skip for now)
            
            // Call constructor if it exists: ClassName.init(objPtr, ...args)
            let constructorName = actualClassName + ".init";
            log("analyzeExpression: NewExpr calling constructor " + constructorName);
            let ctorArgs = new Array<MIRValue>();
            ctorArgs.push(objPtr); // 'this' parameter (ownership transferred to array)
            for (let i = 0; i < newExpr.args.length; i = i + 1) {
                ctorArgs.push(this.analyzeExpression(newExpr.args.get(i)));
            }
            // Call constructor (returns void, we ignore result)
            this.createCall(constructorName, ctorArgs, new MIRType("void", false, 0));
            
            // Return the allocated object pointer (get from array since objPtr was moved)
            return ctorArgs.get(0);
        } else if (expr.kind == "ThisExpr") {
            // 'this' -> register %r0 (first param of method)
            log("analyzeExpression: ThisExpr -> r0");
            return createRegister(new MIRType("ptr", true, 8), 0);
        } else if (expr.kind == "MemberExpr") {
            // Field access: obj.field -> load from field pointer
            log("analyzeExpression: MemberExpr");
            let mem = expr as MemberExpr;
            if (mem.object == null) {
                log("analyzeExpression: MemberExpr with null object, returning dummy value");
                return this.createConstant("0", new MIRType("ptr", true, 8));
            }
            let objVal = this.analyzeExpression(mem.object);
            
            // Determine the class name from the object
            let className = this.currentClassName; // default to current class for 'this' access
            
            // If object is an Identifier, look up its type text to get the actual class name
            if (mem.object.kind == "Identifier") {
                let id = mem.object as IdentifierExpr;
                let paramIdx = this.findParamIndex(id.name);
                if (paramIdx >= 0) {
                    // It's a parameter - get its type text which has the class name
                    className = this.paramTypeTexts.get(paramIdx);
                    log("analyzeExpression: MemberExpr on parameter, type: " + className);
                }
                // TODO: also check locals if we had a working local variable type tracking
            }
            
            let classInfo = this.getClassInfo(className);
            let fieldInfo = null as FieldInfo;
            if (classInfo != null) {
                fieldInfo = classInfo.getFieldByName(mem.member);
            }
            
            // Heuristic: if field not found, try guessing the class from field name
            if (fieldInfo == null) {
                log("analyzeExpression: MemberExpr trying heuristic for field: " + mem.member);
                if (mem.member == "offset" || mem.member == "offsetStr") {
                    className = "ClassFieldInfo";
                } else if (mem.member == "index") {
                    className = "ClassFieldInfo"; // or ClassMethodInfo, try ClassFieldInfo first
                } else if (mem.member == "typeText") {
                    className = "ClassFieldInfo";
                } else if (mem.member == "name") {
                    className = "ClassFieldInfo"; // Could also be ClassMethodInfo or ClassInfo
                } else if (mem.member == "size" || mem.member == "sizeStr") {
                    className = "ClassInfo";
                } else if (mem.member == "fields" || mem.member == "methods") {
                    className = "ClassInfo";
                }
                classInfo = this.getClassInfo(className);
                if (classInfo != null) {
                    fieldInfo = classInfo.getFieldByName(mem.member);
                }
            }
            
            if (fieldInfo != null) {
                log("analyzeExpression: MemberExpr field found: " + mem.member);
                // Compute field type for load
                let fieldType = this.parseType(fieldInfo.typeText);
                // Get field pointer via ptrtoint + add + inttoptr
                let fieldPtr = this.createFieldPtr(objVal, fieldInfo.offsetStr, fieldType);
                // Load value from field pointer
                return this.createLoadTyped(fieldPtr, fieldType);
            }
            
            log("analyzeExpression: MemberExpr field not found: " + mem.member);
            return this.createConstant("0", new MIRType("ptr", true, 8));
        }
        return this.createConstant("0", new MIRType("i32", false, 4));
    }

    public setInsertPoint(blockId: i32): void {
        this.currentBlockId = blockId;
    }

    private buildClass(decl: Declaration): void {
        log("MIRBuilder.buildClass: " + decl.name);
        for (let i = 0; i < decl.members.length; i = i + 1) {
            let m = decl.members.get(i);
            if (m.kind == "MethodDecl") {
                this.buildMethod(decl.name, m);
            }
        }
    }

    private buildMethod(className: string, member: ClassMemberDecl): void {
        let fullName = className + "." + member.name;
        log("MIRBuilder.buildMethod: " + fullName);
        // Set current class context for 'this' access
        log("MIRBuilder.buildMethod: setting currentClassName");
        this.currentClassName = className;
        log("MIRBuilder.buildMethod: clearing locals");
        // Clear locals from previous function
        this.clearLocals();

        log("MIRBuilder.buildMethod: parsing returnType, typeText = " + member.returnTypeText);
        let returnType = this.parseType(member.returnTypeText);
        let func = this.createFunction(fullName, returnType);
        
        // Add implicit 'this' parameter as the first parameter
        log("MIRBuilder.buildMethod: adding implicit 'this'");
        let thisType = new MIRType("ptr", true, 8);
        let thisReg = func.createRegister(thisType);
        this.paramNames.push("this");
        this.paramTypeTexts.push(className); // Store class name as type text for 'this'
        func.params.push(thisReg);

        // Add regular parameters
        if (member.params != null) {
            for (let i = 0; i < member.params.length; i = i + 1) {
                let param = member.params.get(i);
                let paramType = this.parseType(param.typeText);
                let paramReg = func.createRegister(paramType);
                this.paramNames.push(param.name);
                this.paramTypeTexts.push(param.typeText);
                func.params.push(paramReg);
            }
        }
        
        // Build method body
        if (member.hasBody) {
            log("MIRBuilder.buildMethod: building body");
            this.analyzeStatement(member.body);
            
            // Default return if no terminator
            let currentBlock = this.getCurrentBlock();
            let hasTerminator = false;
            if (currentBlock.instructions.length > 0) {
                let lastInst = currentBlock.instructions.get(currentBlock.instructions.length - 1);
                if (lastInst.opcode == "Return" || lastInst.opcode == "Branch" || lastInst.opcode == "Jump") {
                    hasTerminator = true;
                }
            }
            if (!hasTerminator) {
                if (returnType.name == "void") {
                    this.createReturn(this.createConstant("0", new MIRType("void", false, 0)));
                } else {
                    this.createReturn(this.createConstant("0", returnType));
                }
            }
        } else {
            // Default return for empty methods
            if (returnType.name == "void") {
                this.createReturn(this.createConstant("0", new MIRType("void", false, 0)));
            } else {
                this.createReturn(this.createConstant("0", returnType));
            }
        }
        
        this.module.functions.push(func);
    }

    public createBasicBlock(label: string): i32 {
        return this.currentFunction.createBlock(label);
    }

    public createBinary(op: string, left: MIRValue, right: MIRValue): MIRRegister {
        // Comparison operators always return bool (i1)
        let resultType = left.valueType;
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            resultType = new MIRType("bool", false, 1);
            // Type coercion: if comparing ptr with non-ptr, cast non-ptr to ptr
            if (left.valueType.isPointer && !right.valueType.isPointer) {
                let rightCasted = this.createIntToPtr(right);
                let result = this.currentFunction.createRegister(resultType);
                let inst = createBinaryInst(op, result, left, rightCasted);
                this.getCurrentBlock().instructions.push(inst);
                return result;
            } else if (!left.valueType.isPointer && right.valueType.isPointer) {
                let leftCasted = this.createIntToPtr(left);
                let result = this.currentFunction.createRegister(resultType);
                let inst = createBinaryInst(op, result, leftCasted, right);
                this.getCurrentBlock().instructions.push(inst);
                return result;
            }
        } else if (op == "+" || op == "-") {
            // String concatenation: if both operands are pointers and op is +, use string_concat
            if (op == "+" && left.valueType.isPointer && right.valueType.isPointer) {
                // Call _T.string_concat$P.ptr.ptr(left, right)
                let args = new Array<MIRValue>();
                args.push(left);
                args.push(right);
                let ptrType = new MIRType("ptr", true, 8);
                return this.createCall("_T.concat$P.ptr.ptr", args, ptrType);
            }
            // Pointer arithmetic: if one operand is ptr and other is int, perform i64-based pointer arithmetic
            if (left.valueType.isPointer && !right.valueType.isPointer) {
                let baseInt = this.createPtrToInt(left);
                // Cast right to i64 if needed
                let rightInt = right;
                if (right.valueType.name != "i64") {
                    rightInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
                    let sextInst = createBinaryInst("sext_hack", rightInt, right, right);
                    this.getCurrentBlock().instructions.push(sextInst);
                }
                let resultInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
                let inst = createBinaryInst(op, resultInt, baseInt, rightInt);
                this.getCurrentBlock().instructions.push(inst);
                return this.createIntToPtr(resultInt);
            } else if (!left.valueType.isPointer && right.valueType.isPointer) {
                if (op == "+") {
                    let baseInt = this.createPtrToInt(right);
                    // Cast left to i64 if needed
                    let leftInt = left;
                    if (left.valueType.name != "i64") {
                        leftInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
                        let sextInst = createBinaryInst("sext_hack", leftInt, left, left);
                        this.getCurrentBlock().instructions.push(sextInst);
                    }
                    let resultInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
                    let inst = createBinaryInst(op, resultInt, leftInt, baseInt);
                    this.getCurrentBlock().instructions.push(inst);
                    return this.createIntToPtr(resultInt);
                }
            }
        } else if (left.valueType.isPointer || right.valueType.isPointer) {
            let leftInt = left;
            if (left.valueType.isPointer) {
                leftInt = this.createPtrToInt(left);
            }
            let rightInt = right;
            if (right.valueType.isPointer) {
                rightInt = this.createPtrToInt(right);
            }
            let resultInt = this.currentFunction.createRegister(new MIRType("i64", false, 8));
            let inst = createBinaryInst(op, resultInt, leftInt, rightInt);
            this.getCurrentBlock().instructions.push(inst);
            return this.createIntToPtr(resultInt);
        }
        let result = this.currentFunction.createRegister(resultType);
        let inst = createBinaryInst(op, result, left, right);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createLoad(address: MIRValue): MIRRegister {
        // Determine the value type stored at address
        // The alloca register type name tells us the element type
        let addrType = address.valueType;
        let elemName = addrType.name;
        // Primitives: load returns the primitive value
        let isPrim = false;
        if (elemName == "i32") isPrim = true;
        else if (elemName == "i64") isPrim = true;
        else if (elemName == "i8") isPrim = true;
        else if (elemName == "i16") isPrim = true;
        else if (elemName == "f32") isPrim = true;
        else if (elemName == "f64") isPrim = true;
        else if (elemName == "bool") isPrim = true;
        let resultType = new MIRType(elemName, false, addrType.size);
        if (!isPrim) {
            // Reference/pointer types (string, class, Array, ptr) load as ptr
            resultType = new MIRType(elemName, true, 8);
        }
        let result = this.currentFunction.createRegister(resultType);
        let inst = createLoadInst(result, address);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createLoadTyped(address: MIRValue, loadType: MIRType): MIRRegister {
        // Load with explicit type (used for field access where we know the field type)
        let result = this.currentFunction.createRegister(loadType);
        let inst = createLoadInst(result, address);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createStore(value: MIRValue, address: MIRValue): void {
        let inst = createStoreInst(value, address);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createFieldPtr(thisVal: MIRValue, offsetStr: string, fieldType: MIRType): MIRRegister {
        // Generate field pointer via ptrtoint + add + inttoptr
        // %base_int = ptrtoint ptr %this to i64
        let baseInt = this.createPtrToInt(thisVal);
        // %field_int = add i64 %base_int, <offsetStr>
        let offsetConst = this.createConstant(offsetStr, new MIRType("i64", false, 8));
        let fieldIntReg = this.currentFunction.createRegister(new MIRType("i64", false, 8));
        let addInst = createBinaryInst("+", fieldIntReg, baseInt, offsetConst);
        this.getCurrentBlock().instructions.push(addInst);
        // %field_ptr = inttoptr i64 %field_int to ptr
        let fieldPtr = this.createIntToPtr(fieldIntReg);
        return fieldPtr;
    }

    public createCall(callee: string, args: Array<MIRValue>, returnType: MIRType): MIRRegister {
        let result = this.currentFunction.createRegister(returnType);
        let inst = createCallInst(result, callee, args);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createReturn(value: MIRValue): void {
        let inst = createReturnInst(value);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createBranch(condition: MIRValue, trueBlock: i32, falseBlock: i32): void {
        let inst = createBranchInst(condition, trueBlock, falseBlock);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createJump(targetBlock: i32): void {
        let inst = createJumpInst(targetBlock);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createAlloca(allocType: MIRType): MIRRegister {
        let result = this.currentFunction.createRegister(new MIRType(allocType.name, true, 8));
        let inst = createAllocaInst(result, allocType);
        
        // Insert into entry block BEFORE any terminator (Branch/Jump/Return)
        let entryBlock = this.currentFunction.blocks.get(this.entryBlockId);
        let insertPos = entryBlock.instructions.length;
        
        // Find first terminator position
        for (let i = 0; i < entryBlock.instructions.length; i = i + 1) {
            let existingInst = entryBlock.instructions.get(i);
            if (existingInst.opcode == "Branch" || existingInst.opcode == "Jump" || existingInst.opcode == "Return") {
                insertPos = i;
                break;
            }
        }
        
        // Shift instructions after insertPos and insert alloca
        let tempArray = new Array<MIRInst>();
        for (let i = 0; i < insertPos; i = i + 1) {
            tempArray.push(entryBlock.instructions.get(i));
        }
        tempArray.push(inst);
        for (let i = insertPos; i < entryBlock.instructions.length; i = i + 1) {
            tempArray.push(entryBlock.instructions.get(i));
        }
        
        // Replace instructions array
        entryBlock.instructions = tempArray;
        return result;
    }

    public createIncref(value: MIRValue): void {
        let inst = createIncrefInst(value);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createDecref(value: MIRValue): void {
        let inst = createDecrefInst(value);
        this.getCurrentBlock().instructions.push(inst);
    }

    public createConstant(value: string, valueType: MIRType): MIRConstant {
        return createConstant(valueType, value);
    }

    public createIntToPtr(value: MIRValue): MIRRegister {
        // Cast integer to pointer using inttoptr instruction
        let result = this.currentFunction.createRegister(new MIRType("ptr", true, 8));
        let inst = createIntToPtrInst(result, value);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    public createPtrToInt(value: MIRValue): MIRRegister {
        // Cast pointer to integer using ptrtoint instruction
        let result = this.currentFunction.createRegister(new MIRType("i64", false, 8));
        let inst = createPtrToIntInst(result, value);
        this.getCurrentBlock().instructions.push(inst);
        return result;
    }

    private getCurrentBlock(): MIRBasicBlock {
        return this.currentFunction.blocks.get(this.currentBlockId);
    }
    
    private addLocal(name: string, addr: MIRValue): void {
        this.locals.push(name);
        this.localAddrs.push(addr);
    }
    
    private findLocal(name: string): MIRValue {
        let i = 0;
        while (i < this.locals.length) {
            if (this.locals.get(i) == name) {
                return this.localAddrs.get(i);
            }
            i = i + 1;
        }
        return null as MIRValue;
    }

    private findParamIndex(name: string): i32 {
        let i = 0;
        while (i < this.paramNames.length) {
            if (this.paramNames.get(i) == name) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    
    private clearLocals(): void {
        log("MIRBuilder.clearLocals: start");
        this.locals = new Array<string>();
        log("MIRBuilder.clearLocals: locals reset");
        this.localAddrs = new Array<MIRValue>();
        log("MIRBuilder.clearLocals: localAddrs reset");
        this.paramNames = new Array<string>();
        log("MIRBuilder.clearLocals: paramNames reset");
        this.paramTypeTexts = new Array<string>();
        log("MIRBuilder.clearLocals: done");
    }

    private processImports(program: Program): void {
        log("processImports: using hardcoded mappings for test-helper.tsn");
        
        // Hardcoded mappings for test-helper.tsn
        this.importedLocalNames.push("add");
        this.importedMangledNames.push("_T.add$P.i32.i32");
        this.importedLocalNames.push("multiply");
        this.importedMangledNames.push("_T.multiply$P.i32.i32");
        
        log("processImports: added mappings, count = " + this.importedLocalNames.length);
    }
}
