import { log, print_i32 } from "std:console";
import { Array } from "std:array";
import { 
    Program, Declaration, ClassMemberDecl,
    Stmt, BlockStmt, VarDeclStmt, ReturnStmt, IfStmt, WhileStmt, ForStmt, ExprStmt,
    Expr, BinaryExpr, UnaryExpr, IdentifierExpr, NumberLiteral, StringLiteral, BooleanLiteral,
    MemberExpr, CallExpr, NewExpr, ThisExpr
} from "./ast.tsn";

export class Symbol {
    public name: string;
    public symKind: string; 
    public symType: string;

    constructor(name: string, symKind: string, symType: string) {
        this.name = name;
        this.symKind = symKind;
        this.symType = symType;
    }
}

export class Scope {
    // public symbols: Array<Symbol>;
    public parent: Scope;

    constructor(parent: Scope) {
        // this.symbols = new Array<Symbol>();
        this.parent = parent;
    }

    public define(symbol: Symbol): void {
        // this.symbols.push(symbol);
    }

    public resolve(name: string): Symbol {
        // for (let i = 0; i < this.symbols.length; i = i + 1) {
        //     let sym = this.symbols.get(i);
        //     if (sym.name == name) {
        //         return sym;
        //     }
        // }
        
        if (this.parent != null) {
            return this.parent.resolve(name);
        }
        
        return null;
    }
}

export class SemanticAnalyzer {
    // private globalScope: Scope;
    // private currentScope: Scope;
    private currentClassName: string;

    constructor() {
        // this.globalScope = new Scope(null);
        // this.currentScope = this.globalScope;
        this.currentClassName = "";
    }

    public analyze(program: Program): void {
        log("Semantics: starting analysis");
        
        // Pass 1: Collect global symbols
        // for (let i = 0; i < program.declarations.length; i = i + 1) {
        //     this.collectGlobalSymbol(program.declarations.get(i));
        // }

        // Pass 2: Full analysis
        // for (let i = 0; i < program.declarations.length; i = i + 1) {
        //     this.analyzeDeclaration(program.declarations.get(i));
        // }
        
        log("Semantics: analysis complete");
    }

    private collectGlobalSymbol(decl: Declaration): void {
        let dk = decl.kind;
        let dn = decl.name;
        // if (dk == "ClassDecl") {
        //     this.globalScope.define(new Symbol(dn, "class", dn));
        // } else if (dk == "FunctionDecl") {
        //     this.globalScope.define(new Symbol(dn, "func", "function"));
        // }
    }

    private analyzeDeclaration(decl_node: Declaration): void {
        if (decl_node == null) return;
        let dk_str = decl_node.kind;
        if (dk_str == "ClassDecl") {
            this.analyzeClass(decl_node);
        } else if (dk_str == "FunctionDecl") {
            this.analyzeFunction(decl_node);
        }
    }

    private enterScope(): void {
        // this.currentScope = new Scope(this.currentScope);
    }

    private exitScope(): void {
        // if (this.currentScope.parent != null) {
        //     this.currentScope = this.currentScope.parent;
        // }
    }

    private analyzeClass(decl: Declaration): void {
        if (decl == null) return;
        let dn = decl.name;
        log("Semantics: analyzing class " + dn);
        this.currentClassName = dn;
        // Collect members
        // let members = decl.members;
        // let mCount = members.length;
        // let mi = 0;
        // while (mi < mCount) {
        //     let m = members.get(mi);
        //     let mk = m.kind;
        //     if (mk == "MethodDecl" || mk == "ConstructorDecl") {
        //         this.analyzeMethod(m);
        //     }
        //     mi = mi + 1;
        // }
        this.currentClassName = "";
    }

    private analyzeMethod(member: ClassMemberDecl): void {
        log("Semantics: analyzing method/constructor " + member.name);
        this.enterScope();
        // Add 'this'
        // if (this.currentClassName != "") {
        //     this.currentScope.define(new Symbol("this", "var", this.currentClassName));
        // }
        // Add parameters
        let pList = member.params;
        let pCount = pList.length;
        let pIdx = 0;
        while (pIdx < pCount) {
            let p_param = pList.get(pIdx);
            let pt = p_param.typeText;
            let pn = p_param.name;
            // this.currentScope.define(new Symbol(pn, "param", pt));
            pIdx = pIdx + 1;
        }

        // Analyze body if exists
        // Note: For simplicity, we assume we can reach the body.
        // In ast-parser.tsn, we might need to store the body BlockStmt in ClassMemberDecl
        // but currently ast.tsn ClassMemberDecl only has bodyStatementCount.
        // Let's stub this or keep it as is if body isn't directly accessible yet.
        
        this.exitScope();
    }

    private analyzeFunction(decl: Declaration): void {
        log("Semantics: analyzing function " + decl.name);
        this.enterScope();
        // Parameters and body analysis would go here
        this.exitScope();
    }

    private analyzeStatement(stmt: Stmt): void {
        if (stmt == null) return;

        let kind = stmt.kind;
        if (kind == "BlockStmt") {
            let b_stmt = stmt as BlockStmt;
            this.analyzeBlock(b_stmt);
        } else if (kind == "VarDeclStmt") {
            let v_typed = stmt as VarDeclStmt;
            this.analyzeVarDecl(v_typed);
        } else if (kind == "ExprStmt") {
            this.analyzeExprStmt(stmt as ExprStmt);
        } else if (kind == "IfStmt") {
            this.analyzeIf(stmt as IfStmt);
        } else if (kind == "WhileStmt") {
            this.analyzeWhile(stmt as WhileStmt);
        } else if (kind == "ForStmt") {
            this.analyzeFor(stmt as ForStmt);
        } else if (kind == "ReturnStmt") {
            this.analyzeReturn(stmt as ReturnStmt);
        }
    }

    private analyzeVarDecl(v_node: VarDeclStmt): void {
        if (v_node == null) return;
        // let ts_str = v_node.typeText;
        // let ns_str = v_node.name;
        // this.currentScope.define(new Symbol(ns_str, "var", ts_str));
        // if (v_node.init != null) {
        //     let ie_node = v_node.init;
        //     this.analyzeExpression(ie_node);
        // }
    }

    private analyzeExprStmt(es_stmt: ExprStmt): void {
        if (es_stmt == null) return;
        let es_expr = es_stmt.expr;
        this.analyzeExpression(es_expr);
    }

    private analyzeIf(s_if: IfStmt): void {
        if (s_if == null) return;
        // this.analyzeExpression(s_if.condition);
        // this.analyzeStatement(s_if.thenBranch);
        // if (s_if.elseBranch != null) {
        //     this.analyzeStatement(s_if.elseBranch);
        // }
    }

    private analyzeWhile(w_stmt: WhileStmt): void {
        if (w_stmt == null) return;
        this.analyzeExpression(w_stmt.condition);
        this.analyzeStatement(w_stmt.body);
    }

    private analyzeFor(f_stmt: ForStmt): void {
        if (f_stmt == null) return;
        this.enterScope();
        // let f_init = f_stmt.init;
        // this.analyzeStatement(f_init);
        // if (f_stmt.condition != null) {
        //     let f_cond = f_stmt.condition;
        //     this.analyzeExpression(f_cond);
        // }
        // if (f_stmt.update != null) {
        //     let f_upd = f_stmt.update;
        //     this.analyzeExpression(f_upd);
        // }
        // let f_body = f_stmt.body;
        // this.analyzeStatement(f_body);
        this.exitScope();
    }

    private analyzeReturn(r_stmt: ReturnStmt): void {
        if (r_stmt == null) return;
        if (r_stmt.value != null) {
            let r_val = r_stmt.value;
            this.analyzeExpression(r_val);
        }
    }

    private analyzeExpression(expr: Expr): string {
        if (expr == null) return "void";
        
        let ek = expr.kind;
        if (ek == "NumberLiteral") return "i32";
        if (ek == "StringLiteral") return "string";
        if (ek == "BooleanLiteral") return "bool";
        
        if (ek == "Identifier") {
            let idExpr = expr as IdentifierExpr;
            // let idName = idExpr.name;
            // let sym = this.currentScope.resolve(idName);
            // if (sym == null) {
            //     log("Semantics Error: undefined identifier " + idName);
            //     return "unknown";
            // }
            // return sym.symType;
            return "unknown";
        }

        if (ek == "BinaryExpr") {
            let b_expr = expr as BinaryExpr;
            // let be_left = b_expr.left;
            // let be_right = b_expr.right;
            // let lt = this.analyzeExpression(be_left);
            // let rt = this.analyzeExpression(be_right);
            // Simple type check: must match
            // if (lt != rt && lt != "unknown" && rt != "unknown") {
            //     log("Semantics Warning: type mismatch in binary expr " + lt + " vs " + rt);
            // }
            // return lt;
            return "unknown";
        }

        if (ek == "UnaryExpr") {
            let u_expr = expr as UnaryExpr;
            // return this.analyzeExpression(u_expr.operand);
            return "unknown";
        }

        if (ek == "CallExpr") {
            let c_expr = expr as CallExpr;
            // let calleeType = this.analyzeExpression(c_expr.callee);
            // let c_args = c_expr.args;
            // for (let i = 0; i < c_args.length; i = i + 1) {
            //     this.analyzeExpression(c_args.get(i));
            // }
            // In a real compiler, look up return type from calleeType
            return "unknown"; 
        }

        if (ek == "MemberExpr") {
            let m_expr = expr as MemberExpr;
            // let objType = this.analyzeExpression(m_expr.object);
            // For now, return unknown as we don't have a class registry yet
            return "unknown";
        }

        if (ek == "NewExpr") {
            let n_expr = expr as NewExpr;
            // let n_args = n_expr.args;
            // for (let i = 0; i < n_args.length; i = i + 1) {
            //     this.analyzeExpression(n_args.get(i));
            // }
            // return n_expr.className;
            return "unknown";
        }

        if (ek == "ThisExpr") {
            if (this.currentClassName != "") {
                return this.currentClassName;
            }
            return "unknown";
        }

        if (ek == "ArrayLiteral") {
            let a_expr = expr as ArrayLiteral;
            let a_elems = a_expr.elements;
            for (let i = 0; i < a_elems.length; i = i + 1) {
                this.analyzeExpression(a_elems.get(i));
            }
            return "Array";
        }

        return "unknown";
    }

    private enterScope(): void {
        this.currentScope = new Scope(this.currentScope);
    }

    private exitScope(): void {
        if (this.currentScope.parent != null) {
            this.currentScope = this.currentScope.parent;
        }
    }
}
