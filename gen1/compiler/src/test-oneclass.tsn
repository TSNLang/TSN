// Test single class from ast.tsn
import { Array } from "std:array";

export class Program {
    functions: Array<FunctionDecl>;
    classes: Array<ClassDecl>;
    
    constructor() {
        this.functions = new Array<FunctionDecl>();
        this.classes = new Array<ClassDecl>();
    }
}

export class FunctionDecl {
    name: string;
    returnType: string;
    
    constructor(name: string, returnType: string) {
        this.name = name;
        this.returnType = returnType;
    }
}

export class ClassDecl {
    name: string;
    
    constructor(name: string) {
        this.name = name;
    }
}

function main(): i32 {
    return 0;
}
