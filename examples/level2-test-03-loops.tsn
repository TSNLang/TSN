// Level 2 Compiler Test 03: Loops
// This test verifies while loops and for loops

declare function print_i32(n: i32): void;

function sumWhile(n: i32): i32 {
    let sum = 0;
    let i = 1;
    while (i <= n) {
        sum = sum + i;
        i = i + 1;
    }
    return sum;
}

function sumFor(n: i32): i32 {
    let sum = 0;
    for (let i = 1; i <= n; i = i + 1) {
        sum = sum + i;
    }
    return sum;
}

function factorial(n: i32): i32 {
    let result = 1;
    let i = 1;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    return result;
}

function main(): i32 {
    let n = 5;
    
    let sum1 = sumWhile(n);
    print_i32(sum1);
    
    let sum2 = sumFor(n);
    print_i32(sum2);
    
    let fact = factorial(n);
    print_i32(fact);
    
    return 0;
}
