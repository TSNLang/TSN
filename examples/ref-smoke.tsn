import { log, print_i32 } from "std:console";

class User {
    name: string;
    age: i32;

    constructor(name: string, age: i32) {
        this.name = name;
        this.age = age;
    }
}

// 1. Mượn để đọc (Immutable Borrow) -> dùng const ref
function displayUser(const user: ref<User>): void {
    log("User name:");
    log(user.name);
    log("Age:");
    print_i32(user.age);
    // user.age = 30; // Lỗi: không thể gán cho const ref (Đã test thành công)
}

// 2. Mượn để sửa đổi (Mutable Borrow) -> dùng let ref
function celebrateBirthday(let user: ref<User>): void {
    user.age = user.age + 1;
}

function main(): i32 {
    log("--- Ref Smoke Test ---");

    // Khởi tạo đối tượng (Sở hữu thuộc về biến u)
    let u = new User("Nam", 25);

    // Truyền tham chiếu vào hàm displayUser (Immutable)
    displayUser(u); 

    // Truyền tham chiếu vào hàm thay đổi dữ liệu (Mutable)
    celebrateBirthday(u);

    // Kiểm tra kết quả sau khi sửa đổi
    log("After birthday:");
    displayUser(u); 

    // Debug age
    if (u.age == 26) {
        log("Age is correct: 26");
    } else {
        log("Age is INCORRECT!");
    }

    if (u.age == 26) {
        log("Test Passed!");
    } else {
        log("Test Failed!");
        return 1;
    }

    return 0;
}
