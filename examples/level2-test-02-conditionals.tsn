// Level 2 Compiler Test 02: Conditionals and comparisons
// This test verifies if/else statements and comparison operators

declare function print_i32(n: i32): void;

function max(a: i32, b: i32): i32 {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

function min(a: i32, b: i32): i32 {
    if (a < b) {
        return a;
    } else {
        return b;
    }
}

function isEqual(a: i32, b: i32): i32 {
    if (a == b) {
        return 1;
    } else {
        return 0;
    }
}

function main(): i32 {
    let x = 10;
    let y = 20;
    
    let maxVal = max(x, y);
    print_i32(maxVal);
    
    let minVal = min(x, y);
    print_i32(minVal);
    
    let eq1 = isEqual(x, y);
    print_i32(eq1);
    
    let eq2 = isEqual(x, x);
    print_i32(eq2);
    
    return 0;
}
