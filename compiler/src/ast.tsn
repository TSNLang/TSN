// AST Node Definitions - Phase 10: Tagged Union Approach
// No inheritance - all fields in base class with type tag

import { Array } from "std:array";

// ========================================
// BASE TYPES
// ========================================

export class SourceLocation {
    line: i32;
    column: i32;
    
    constructor(line: i32, column: i32) {
        this.line = line;
        this.column = column;
    }
}

// ========================================
// PROGRAM & DECLARATIONS
// ========================================

export class Program {
    functions: Array<FunctionDecl>;
    
    constructor() {
        this.functions = new Array<FunctionDecl>();
    }
}

export class FunctionDecl {
    name: string;
    params: Array<Parameter>;
    returnType: string;
    body: BlockStmt;
    
    constructor(name: string, returnType: string) {
        this.name = name;
        this.returnType = returnType;
        this.params = new Array<Parameter>();
        this.body = new BlockStmt();
    }
}

export class Parameter {
    name: string;
    typeAnnotation: string;
    
    constructor(name: string, typeAnnotation: string) {
        this.name = name;
        this.typeAnnotation = typeAnnotation;
    }
}

// ========================================
// STATEMENTS - Tagged Union Style
// ========================================

export class BlockStmt {
    statements: Array<Stmt>;
    
    constructor() {
        this.statements = new Array<Stmt>();
    }
}

// ALL statement data in ONE class - discriminated by kind
export class Stmt {
    kind: string;
    
    // ReturnStmt fields
    value: Expr;
    
    // ExprStmt fields
    expr: Expr;
    
    // VarDeclStmt fields
    name: string;
    typeAnnotation: string;
    init: Expr;
    
    constructor() {
        // Don't set kind in constructor - will be set after construction
        this.kind = "";
        this.name = "";
        this.typeAnnotation = "";
    }
}

// Factory functions for creating specific statement types
export function ReturnStmt(value: Expr): Stmt {
    let stmt = new Stmt();
    stmt.kind = "ReturnStmt";
    stmt.value = value;
    return stmt;
}

export function ExprStmt(expr: Expr): Stmt {
    let stmt = new Stmt();
    stmt.kind = "ExprStmt";
    stmt.expr = expr;
    return stmt;
}

export function VarDeclStmt(name: string, typeAnnotation: string, init: Expr): Stmt {
    let stmt = new Stmt();
    stmt.kind = "VarDeclStmt";
    stmt.name = name;
    stmt.typeAnnotation = typeAnnotation;
    stmt.init = init;
    return stmt;
}

// ========================================
// EXPRESSIONS - Tagged Union Style
// ========================================

// ALL expression data in ONE class - discriminated by kind
export class Expr {
    kind: string;           // PUT FIRST so it can be assigned!
    numValue: string;       // PUT SECOND so it can be assigned!
    
    // Identifier fields
    name: string;
    
    // BinaryExpr fields
    left: Expr;
    operator: string;
    right: Expr;
    
    // CallExpr fields
    callee: string;
    args: Array<Expr>;
    
    constructor() {
        this.kind = "";
        this.numValue = "";
        this.name = "";
        this.operator = "";
        this.callee = "";
        this.args = new Array<Expr>();
    }
}

// Factory functions for creating specific expression types
export function NumberLiteral(value: i32): Expr {
    let expr = new Expr();
    expr.kind = "NumberLiteral";
    // Convert i32 to string as workaround
    if (value == 0) expr.numValue = "0";
    else if (value == 1) expr.numValue = "1";
    else if (value == 42) expr.numValue = "42";
    else expr.numValue = "?";
    return expr;
}

export function Identifier(name: string): Expr {
    let expr = new Expr();
    expr.kind = "Identifier";
    expr.name = name;
    return expr;
}

export function BinaryExpr(left: Expr, operator: string, right: Expr): Expr {
    let expr = new Expr();
    expr.kind = "BinaryExpr";
    expr.left = left;
    expr.operator = operator;
    expr.right = right;
    return expr;
}

export function CallExpr(callee: string): Expr {
    let expr = new Expr();
    expr.kind = "CallExpr";
    expr.callee = callee;
    expr.args = new Array<Expr>();
    return expr;
}

// ========================================
// HELPER FUNCTIONS
// ========================================

export function isValidType(typeName: string): i32 {
    if (typeName == "i32") return 1;
    if (typeName == "i64") return 1;
    if (typeName == "bool") return 1;
    if (typeName == "void") return 1;
    return 0;
}
