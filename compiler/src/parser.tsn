// Parser - Recursive Descent Parser
// Convert tokens → AST

import { Array } from "std:array";
import { log } from "std:console";
import { Token } from "./lexer.tsn";
import { Program, FunctionDecl, Parameter, BlockStmt, Stmt, Expr, ReturnStmt, ExprStmt, VarDeclStmt, NumberLiteral, Identifier, BinaryExpr, CallExpr } from "./ast.tsn";

export class Parser {
    tokens: Array<Token>;
    current: i32;
    
    constructor(tokens: Array<Token>) {
        this.tokens = tokens;
        this.current = 0;
    }
    
    // ========================================
    // MAIN ENTRY POINT
    // ========================================
    
    public parse(): Program {
        let program = new Program();
        
        while (this.isAtEnd() == false) {
            if (this.check("FUNCTION")) {
                let func = this.parseFunction();
                program.functions.push(func);
            } else {
                this.advance();
            }
        }
        
        return program;
    }
    
    // ========================================
    // FUNCTION DECLARATION
    // ========================================
    
    private parseFunction(): FunctionDecl {
        this.consume("FUNCTION", "Expected 'function'");
        let name = this.consume("IDENTIFIER", "Expected function name").lexeme;
        this.consume("LPAREN", "Expected '('");
        
        let func = new FunctionDecl(name, "void");
        
        // Parse parameters: (a: i32, b: i32)
        if (this.check("RPAREN") == false) {
            // First parameter
            let param = this.parseParameter();
            func.params.push(param);
            
            // Additional parameters
            while (this.match("COMMA")) {
                let nextParam = this.parseParameter();
                func.params.push(nextParam);
            }
        }
        
        this.consume("RPAREN", "Expected ')'");
        
        // Parse return type
        if (this.match("COLON")) {
            func.returnType = this.consume("IDENTIFIER", "Expected return type").lexeme;
        }
        
        // Parse body - TRY AGAIN with simple parsing
        func.body = this.parseSimpleBlock();
        
        return func;
    }
    
    // Block parser - handles multiple statements
    private parseSimpleBlock(): BlockStmt {
        this.consume("LBRACE", "Expected '{'");
        let block = new BlockStmt();
        
        // Parse multiple statements
        while (this.check("RBRACE") == false && this.isAtEnd() == false) {
            if (this.check("RETURN")) {
                // Return statement
                this.consume("RETURN", "Expected 'return'");
                
                // Parse return value: number, identifier, or function call
                let valueExpr = new Expr();
                
                if (this.check("NUMBER")) {
                    let token = this.consume("NUMBER", "Expected number");
                    valueExpr.kind = "NumberLiteral";
                    valueExpr.name = token.lexeme;
                } else if (this.check("IDENTIFIER")) {
                    let token = this.consume("IDENTIFIER", "Expected identifier");
                    
                    // Check if it's a function call
                    if (this.check("LPAREN")) {
                        this.consume("LPAREN", "Expected '('");
                        
                        valueExpr.kind = "CallExpr";
                        valueExpr.callee = token.lexeme;
                        
                        // Parse arguments (bootstrap bug - won't work)
                        if (this.check("RPAREN") == false) {
                            // Skip args parsing - bootstrap bug
                            while (this.check("RPAREN") == false && this.isAtEnd() == false) {
                                this.advance();
                            }
                        }
                        
                        this.consume("RPAREN", "Expected ')'");
                    } else {
                        // Just an identifier
                        valueExpr.kind = "Identifier";
                        valueExpr.name = token.lexeme;
                    }
                }
                
                this.consume("SEMICOLON", "Expected ';'");
                
                let stmt = new Stmt();
                stmt.kind = "ReturnStmt";
                stmt.value = valueExpr;
                block.statements.push(stmt);
                
            } else if (this.check("LET")) {
                // Variable declaration
                this.consume("LET", "Expected 'let'");
                let name = this.consume("IDENTIFIER", "Expected variable name").lexeme;
                this.consume("COLON", "Expected ':'");
                let type = this.consume("IDENTIFIER", "Expected type").lexeme;
                this.consume("ASSIGN", "Expected '='");
                
                // Parse initializer - VERY simple: number or identifier only
                let initExpr = new Expr();
                if (this.check("NUMBER")) {
                    let token = this.consume("NUMBER", "Expected number");
                    initExpr.kind = "NumberLiteral";
                    initExpr.name = token.lexeme;
                } else if (this.check("IDENTIFIER")) {
                    let token = this.consume("IDENTIFIER", "Expected identifier");
                    initExpr.kind = "Identifier";
                    initExpr.name = token.lexeme;
                }
                
                this.consume("SEMICOLON", "Expected ';'");
                
                let stmt = new Stmt();
                stmt.kind = "VarDeclStmt";
                stmt.name = name;
                stmt.typeAnnotation = type;
                stmt.init = initExpr;
                block.statements.push(stmt);
                
            } else {
                // Unknown statement, skip token
                this.advance();
            }
        }
        
        this.consume("RBRACE", "Expected '}'");
        return block;
    }
    
    private parseParameter(): Parameter {
        let name = this.consume("IDENTIFIER", "Expected parameter name").lexeme;
        this.consume("COLON", "Expected ':'");
        let type = this.consume("IDENTIFIER", "Expected parameter type").lexeme;
        
        return new Parameter(name, type);
    }
    
    // ========================================
    // STATEMENTS
    // ========================================
    
    private parseBlock(): BlockStmt {
        this.consume("LBRACE", "Expected '{'");
        let block = new BlockStmt();
        
        // Parse exactly ONE statement then break
        let count = 0;
        while (this.check("RBRACE") == false && this.isAtEnd() == false) {
            let stmt = this.parseStatement();
            block.statements.push(stmt);
            
            count = count + 1;
            if (count >= 1) {
                // Force break after 1 statement
                break;
            }
        }
        
        this.consume("RBRACE", "Expected '}'");
        return block;
    }
    
    private parseStatement(): Stmt {
        // MUST advance at least one token to avoid infinite loop!
        if (this.check("RETURN")) {
            return this.parseReturn();
        }
        
        if (this.check("LET")) {
            return this.parseVarDecl();
        }
        
        // Expression statement
        return this.parseExprStmt();
    }
    
    private parseReturn(): Stmt {
        this.consume("RETURN", "Expected 'return'");
        this.advance();
        this.consume("SEMICOLON", "Expected ';'");
        
        // Create ReturnStmt WITHOUT setting value field
        let stmt = new Stmt();
        stmt.kind = "ReturnStmt";
        // Don't set stmt.value
        return stmt;
    }
    
    private parseVarDecl(): Stmt {
        this.consume("LET", "Expected 'let'");
        
        let name = this.consume("IDENTIFIER", "Expected variable name").lexeme;
        
        this.consume("COLON", "Expected ':'");
        
        let type = this.consume("IDENTIFIER", "Expected type").lexeme;
        
        this.consume("ASSIGN", "Expected '='");
        
        let init = this.parseExpression();
        
        this.consume("SEMICOLON", "Expected ';'");
        
        // Create VarDeclStmt manually
        let stmt = new Stmt();
        stmt.kind = "VarDeclStmt";
        stmt.name = name;
        stmt.typeAnnotation = type;
        stmt.init = init;
        return stmt;
    }
    
    private parseExprStmt(): Stmt {
        let expr = this.parseExpression();
        this.consume("SEMICOLON", "Expected ';'");
        
        // Create ExprStmt manually
        let stmt = new Stmt();
        stmt.kind = "ExprStmt";
        stmt.expr = expr;
        return stmt;
    }
    
    // ========================================
    // EXPRESSIONS (Operator Precedence)
    // ========================================
    
    private parseExpression(): Expr {
        return this.parseComparison();
    }
    
    private parseComparison(): Expr {
        let expr = this.parseAddition();
        
        while (this.match("LT") || this.match("GT") || this.match("LE") || this.match("GE") || this.match("EQ")) {
            let op = this.previous().lexeme;
            let right = this.parseAddition();
            
            // Create BinaryExpr manually
            let binExpr = new Expr();
            binExpr.kind = "BinaryExpr";
            binExpr.left = expr;
            binExpr.operator = op;
            binExpr.right = right;
            expr = binExpr;
        }
        
        return expr;
    }
    
    private parseAddition(): Expr {
        let expr = this.parseMultiplication();
        
        while (this.match("PLUS") || this.match("MINUS")) {
            let op = this.previous().lexeme;
            let right = this.parseMultiplication();
            
            // Create BinaryExpr manually
            let binExpr = new Expr();
            binExpr.kind = "BinaryExpr";
            binExpr.left = expr;
            binExpr.operator = op;
            binExpr.right = right;
            expr = binExpr;
        }
        
        return expr;
    }
    
    private parseMultiplication(): Expr {
        let expr = this.parsePrimary();
        
        while (this.match("STAR") || this.match("SLASH")) {
            let op = this.previous().lexeme;
            let right = this.parsePrimary();
            
            // Create BinaryExpr manually
            let binExpr = new Expr();
            binExpr.kind = "BinaryExpr";
            binExpr.left = expr;
            binExpr.operator = op;
            binExpr.right = right;
            expr = binExpr;
        }
        
        return expr;
    }
    
    private parsePrimary(): Expr {
        // Number literal
        if (this.check("NUMBER")) {
            let token = this.advance();
            
            // Store in numValue (first field in Expr)
            let expr = new Expr();
            expr.numValue = token.lexeme;  // Assign to first field!
            expr.kind = "NumberLiteral";
            return expr;
        }
        
        // Identifier or function call
        if (this.check("IDENTIFIER")) {
            let name = this.advance().lexeme;
            
            // Function call
            if (this.match("LPAREN")) {
                // Create CallExpr manually
                let call = new Expr();
                call.kind = "CallExpr";
                call.callee = name;
                call.args = new Array<Expr>();
                
                if (this.check("RPAREN") == false) {
                    call.args.push(this.parseExpression());
                    
                    while (this.match("COMMA")) {
                        call.args.push(this.parseExpression());
                    }
                }
                
                this.consume("RPAREN", "Expected ')'");
                return call;
            }
            
            // Just identifier  
            let idExpr = new Expr();
            idExpr.kind = "Identifier";
            idExpr.name = name;
            return idExpr;
        }
        
        // Parenthesized expression
        if (this.match("LPAREN")) {
            let expr = this.parseExpression();
            this.consume("RPAREN", "Expected ')'");
            return expr;
        }
        
        // Error fallback
        let errorExpr = new Expr();
        errorExpr.numValue = "0";  // First field!
        errorExpr.kind = "NumberLiteral";
        return errorExpr;
    }
    
    // ========================================
    // HELPER METHODS
    // ========================================
    
    private match(type: string): bool {
        if (this.check(type)) {
            this.advance();
            return true;
        }
        return false;
    }
    
    private check(type: string): bool {
        if (this.isAtEnd()) return false;
        return this.peek().type == type;
    }
    
    private advance(): Token {
        if (this.isAtEnd() == false) {
            this.current = this.current + 1;
        }
        return this.previous();
    }
    
    private isAtEnd(): bool {
        return this.peek().type == "EOF";
    }
    
    private peek(): Token {
        return this.tokens.get(this.current);
    }
    
    private previous(): Token {
        return this.tokens.get(this.current - 1);
    }
    
    private consume(type: string, message: string): Token {
        if (this.check(type)) {
            return this.advance();
        }
        
        // Error - return current token as fallback
        return this.peek();
    }
    
    private stringToInt(s: string): i32 {
        let result = 0;
        let i = 0;
        while (i < s.length) {
            let digit = s.charCodeAt(i) - 48; // '0' = 48
            result = result * 10 + digit;
            i = i + 1;
        }
        return result;
    }
    
    private intToString(n: i32): string {
        log("DEBUG intToString: n=" + this.intToStringDebug(n));
        if (n == 0) return "0";
        if (n == 42) return "42";
        return "?";
    }
    
    private intToStringDebug(n: i32): string {
        if (n == 0) return "0debug";
        if (n == 42) return "42debug";
        return "?debug";
    }
}
