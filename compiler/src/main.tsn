// TSN Compiler v2 - Main Entry Point
// Phase 1: Test Lexer và Parser

import { log } from "std:console";
import { readText } from "std:fs";
import { Lexer } from "./lexer.tsn";
import { Parser } from "./parser.tsn";
import { Codegen } from "./codegen.tsn";

function main(): void {
    log("=== TSN Compiler v2 - Phase 9 Test ===");
    
    // Test with parameters
    let source = "function add(a: i32, b: i32): i32 { return a + b; }";
    
    log("Source code loaded");
    log("Length: " + intToString(source.length));
    
    // Lexer
    log("\n=== LEXER ===");
    let lexer = new Lexer(source);
    let tokens = lexer.tokenize();
    
    log("Tokens count: " + intToString(tokens.length));
    
    // Parser
    log("\n=== PARSER ===");
    let parser = new Parser(tokens);
    let program = parser.parse();
    
    log("Functions parsed: " + intToString(program.functions.length));
    
    // Codegen
    log("\n=== CODEGEN ===");
    let codegen = new Codegen(program);
    let llvmIR = codegen.generate();
    
    log("First 100 chars of IR:");
    log(llvmIR);
    
    log("\n=== Phase 9 Complete ===");
}

function intToString(n: i32): string {
    if (n == 0) return "0";
    if (n == 1) return "1";
    if (n == 2) return "2";
    if (n == 3) return "3";
    if (n == 4) return "4";
    if (n == 5) return "5";
    if (n == 6) return "6";
    if (n == 7) return "7";
    if (n == 8) return "8";
    if (n == 9) return "9";
    if (n == 10) return "10";
    if (n == 20) return "20";
    if (n == 30) return "30";
    if (n == 32) return "32";
    if (n == 42) return "42";
    if (n == 100) return "100";
    return "?";
}
