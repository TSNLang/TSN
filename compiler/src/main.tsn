// TSN Compiler v2 - Main Entry Point
// Phase 1: Test Lexer và Parser

import { log } from "std:console";
import { readText } from "std:fs";
import { Lexer } from "./lexer.tsn";
import { Parser } from "./parser.tsn";

function main(): void {
    log("=== TSN Compiler v2 - Phase 1 Test ===");
    
    // Read source file
    let source = readText("../test-phase1.tsn");
    
    log("Source code loaded");
    log("Length: " + intToString(source.length));
    
    // Lexer
    log("\n=== LEXER ===");
    let lexer = new Lexer(source);
    let tokens = lexer.tokenize();
    
    log("Tokens count: " + intToString(tokens.length));
    
    // Print first 10 tokens
    let i = 0;
    while (i < 10 && i < tokens.length) {
        let token = tokens.get(i);
        log(token.type + " : " + token.lexeme);
        i = i + 1;
    }
    
    // Parser
    log("\n=== PARSER ===");
    let parser = new Parser(tokens);
    let program = parser.parse();
    
    log("Functions parsed: " + intToString(program.functions.length));
    
    // Print function names
    let j = 0;
    while (j < program.functions.length) {
        let func = program.functions.get(j);
        log("Function: " + func.name);
        log("  Return type: " + func.returnType);
        log("  Params: " + intToString(func.params.length));
        j = j + 1;
    }
    
    log("\n=== Phase 1 Complete ===");
}

function intToString(n: i32): string {
    if (n == 0) return "0";
    if (n == 1) return "1";
    if (n == 2) return "2";
    if (n == 3) return "3";
    if (n == 4) return "4";
    if (n == 5) return "5";
    if (n == 6) return "6";
    if (n == 7) return "7";
    if (n == 8) return "8";
    if (n == 9) return "9";
    if (n == 10) return "10";
    if (n == 20) return "20";
    if (n == 30) return "30";
    if (n == 32) return "32";
    if (n == 42) return "42";
    if (n == 100) return "100";
    return "?";
}
