    if (n == 62) return "62";
    if (n == 63) return "63";
    if (n == 64) return "64";
    if (n == 65) return "65";
    if (n == 66) return "66";
    if (n == 67) return "67";
    if (n == 70) return "70";
    if (n == 80) return "80";
    if (n == 90) return "90";
    if (n == 100) return "100";
    return "?";
}
