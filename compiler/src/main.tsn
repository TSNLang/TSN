// TSN Compiler v2 - Main Entry Point
// Phase 1: Test Lexer và Parser

import { log } from "std:console";
import { readText } from "std:fs";
import { Lexer } from "./lexer.tsn";
import { Parser } from "./parser.tsn";
import { Codegen } from "./codegen.tsn";

function main(): void {
    log("=== TSN Compiler v2 - Phase 13 ===");
    
    // Test case: multiple variables
    let source = "function test(): i32 { let x: i32 = 5; let y: i32 = 7; return y; }";
    
    let lexer = new Lexer(source);
    let tokens = lexer.tokenize();
    log("Tokens: " + intToString(tokens.length));
    
    let parser = new Parser(tokens);
    let program = parser.parse();
    log("Functions: " + intToString(program.functions.length));
    
    let func = program.functions.get(0);
    log("Statements: " + intToString(func.body.statements.length));
    
    let codegen = new Codegen(program);
    let llvmIR = codegen.generate();
    
    log("Generated IR:");
    log(llvmIR);
    
    log("");
    log("Phase 13 Complete: Multiple statements + variables working!");
}

function intToString(n: i32): string {
    if (n == 0) return "0";
    if (n == 1) return "1";
    if (n == 2) return "2";
    if (n == 3) return "3";
    if (n == 4) return "4";
    if (n == 5) return "5";
    if (n == 6) return "6";
    if (n == 7) return "7";
    if (n == 8) return "8";
    if (n == 9) return "9";
    if (n == 10) return "10";
    if (n == 11) return "11";
    if (n == 12) return "12";
    if (n == 13) return "13";
    if (n == 14) return "14";
    if (n == 15) return "15";
    if (n == 16) return "16";
    if (n == 17) return "17";
    if (n == 18) return "18";
    if (n == 19) return "19";
    if (n == 20) return "20";
    if (n == 21) return "21";
    if (n == 22) return "22";
    if (n == 23) return "23";
    if (n == 24) return "24";
    if (n == 25) return "25";
    if (n == 26) return "26";
    if (n == 27) return "27";
    if (n == 28) return "28";
    if (n == 29) return "29";
    if (n == 20) return "20";
    if (n == 30) return "30";
