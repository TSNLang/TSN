// Codegen - LLVM IR Generator
// Convert AST → LLVM IR

import { Array } from "std:array";
import { log } from "std:console";
import { Program, FunctionDecl, Parameter, BlockStmt, Stmt, Expr, ReturnStmt, ExprStmt, NumberLiteral, Identifier, BinaryExpr, ClassDecl, FieldDecl } from "./ast.tsn";

export class Codegen {
    program: Program;
    output: Array<string>;
    regCounter: i32;
    labelCounter: i32;
    localVars: Array<string>;   // [name, reg, name, reg, ...]
    localTypes: Array<string>;  // [name, type, name, type, ...] parallel to localVars
    // Field offset table: [className_fieldName, offset, className_fieldName, offset, ...]
    fieldOffsets: Array<string>;
    // Class type tracking: [varName, className, varName, className, ...]
    varClassTypes: Array<string>;
    // String constants: [stringLiteral, globalName, stringLiteral, globalName, ...]
    stringConstants: Array<string>;
    stringCounter: i32;
    
    constructor(program: Program) {
        this.program = program;
        this.output = new Array<string>();
        this.regCounter = 0;
        this.labelCounter = 0;
        this.localVars = new Array<string>();
        this.localTypes = new Array<string>();
        this.fieldOffsets = new Array<string>();
        this.varClassTypes = new Array<string>();
        this.stringConstants = new Array<string>();
        this.stringCounter = 0;
        this.initFieldOffsets();
    }
    
    // ========================================
    // MAIN ENTRY POINT
    // ========================================
    
    public generate(): string {
        this.emitHeader();
        // Skip string constants for now - bootstrap compiler has bugs with escaping
        // this.emitStringConstants();
        this.emitFunctions();
        
        return this.joinOutput();
    }
    
    // ========================================
    // HEADER & DECLARATIONS
    // ========================================
    
    private initFieldOffsets(): void {
        // Layout: [className:fieldName, byteOffset, ...]
        // Each ptr = 8 bytes, i32 = 4 bytes, struct header = 8 bytes (refcount i32 + vtable ptr)
        // So field 0 → offset 8, field 1 → offset 16, field 2 → offset 24, ...
        // Wait: struct { i32 refcount, ptr vtable, field0, field1... }
        // i32=4, ptr=8, so vtable at 4, field0 at 12? No - aligned:
        // i32 refcount: 0-3, pad 4-7, ptr vtable: 8-15, field0: 16-23, field1: 24-31 ...
        // Actually struct layout: { i32, ptr, fields... }
        // i32 at 0 (4 bytes), ptr at 8 (8 bytes, aligned), field0 at 16, field1 at 24, ...
        
        // Expr fields (kind, numValue, name, left, operator, right, callee, args, object, member)
        this.fieldOffsets.push("Expr:kind");       this.fieldOffsets.push("16");
        this.fieldOffsets.push("Expr:numValue");   this.fieldOffsets.push("24");
        this.fieldOffsets.push("Expr:name");       this.fieldOffsets.push("32");
        this.fieldOffsets.push("Expr:left");       this.fieldOffsets.push("40");
        this.fieldOffsets.push("Expr:operator");   this.fieldOffsets.push("48");
        this.fieldOffsets.push("Expr:right");      this.fieldOffsets.push("56");
        this.fieldOffsets.push("Expr:callee");     this.fieldOffsets.push("64");
        this.fieldOffsets.push("Expr:args");       this.fieldOffsets.push("72");
        this.fieldOffsets.push("Expr:object");     this.fieldOffsets.push("80");
        this.fieldOffsets.push("Expr:member");     this.fieldOffsets.push("88");
        
        // Stmt fields (kind, value, expr, name, typeAnnotation, init, condition, thenBlock, elseBlock, body)
        this.fieldOffsets.push("Stmt:kind");            this.fieldOffsets.push("16");
        this.fieldOffsets.push("Stmt:value");           this.fieldOffsets.push("24");
        this.fieldOffsets.push("Stmt:expr");            this.fieldOffsets.push("32");
        this.fieldOffsets.push("Stmt:name");            this.fieldOffsets.push("40");
        this.fieldOffsets.push("Stmt:typeAnnotation");  this.fieldOffsets.push("48");
        this.fieldOffsets.push("Stmt:init");            this.fieldOffsets.push("56");
        this.fieldOffsets.push("Stmt:condition");       this.fieldOffsets.push("64");
        this.fieldOffsets.push("Stmt:thenBlock");       this.fieldOffsets.push("72");
        this.fieldOffsets.push("Stmt:elseBlock");       this.fieldOffsets.push("80");
        this.fieldOffsets.push("Stmt:body");            this.fieldOffsets.push("88");
        
        // Token fields (type, lexeme, line, column)
        this.fieldOffsets.push("Token:type");    this.fieldOffsets.push("16");
        this.fieldOffsets.push("Token:lexeme");  this.fieldOffsets.push("24");
        this.fieldOffsets.push("Token:line");    this.fieldOffsets.push("32");
        this.fieldOffsets.push("Token:column");  this.fieldOffsets.push("40");
        
        // FunctionDecl fields (name, params, returnType, body)
        this.fieldOffsets.push("FunctionDecl:name");        this.fieldOffsets.push("16");
        this.fieldOffsets.push("FunctionDecl:params");      this.fieldOffsets.push("24");
        this.fieldOffsets.push("FunctionDecl:returnType");  this.fieldOffsets.push("32");
        this.fieldOffsets.push("FunctionDecl:body");        this.fieldOffsets.push("40");
        
        // Parameter fields (name, typeAnnotation)
        this.fieldOffsets.push("Parameter:name");           this.fieldOffsets.push("16");
        this.fieldOffsets.push("Parameter:typeAnnotation"); this.fieldOffsets.push("24");
        
        // BlockStmt fields (statements)
        this.fieldOffsets.push("BlockStmt:statements"); this.fieldOffsets.push("16");
        
        // Program fields (functions)
        this.fieldOffsets.push("Program:functions"); this.fieldOffsets.push("16");
    }
    
    private getFieldOffset(className: string, fieldName: string): string {
        let key = className + ":" + fieldName;
        let i = 0;
        while (i < this.fieldOffsets.length) {
            let k = this.fieldOffsets.get(i);
            let v = this.fieldOffsets.get(i + 1);
            if (k == key) {
                return v;
            }
            i = i + 2;
        }
        return "0";  // Unknown field → offset 0 (will be wrong but won't crash)
    }
    
    private emitHeader(): void {
        this.output.push("; Generated by TSN Compiler v2 - Phase 34");
        this.output.push("");
        
        // Runtime declarations - Phase 34: Complete set
        this.output.push("; Core runtime");
        this.output.push("declare void @print_i32(i32)");
        this.output.push("declare void @print_string(ptr)");
        this.output.push("declare void @_T_log_P_ptr(ptr)");
        this.output.push("");
        this.output.push("; Object allocation");
        this.output.push("declare ptr @class_alloc(i32)");
        this.output.push("");
        this.output.push("; String operations");
        this.output.push("declare ptr @string_concat(ptr, ptr)");
        this.output.push("declare i32 @string_length(ptr)");
        this.output.push("declare i32 @string_equals(ptr, ptr)");
        this.output.push("");
        this.output.push("; Array operations");
        this.output.push("declare void @Array_push(ptr, ptr)");
        this.output.push("declare ptr @Array_get(ptr, i32)");
        this.output.push("declare i32 @Array_length(ptr)");
        this.output.push("");
    }
    
    // ========================================
    // FUNCTION GENERATION
    // ========================================
    
    private emitFunctions(): void {
        // Emit module-level functions
        let i = 0;
        while (i < this.program.functions.length) {
            let func = this.program.functions.get(i);
            this.emitFunction(func);
            i = i + 1;
        }
        
        // Emit class methods with name mangling
        let j = 0;
        while (j < this.program.classes.length) {
            let cls = this.program.classes.get(j);
            let k = 0;
            while (k < cls.methods.length) {
                let method = cls.methods.get(k);
                this.emitClassMethod(cls.name, method);
                k = k + 1;
            }
            j = j + 1;
        }
    }
    
    private emitClassMethod(className: string, method: FunctionDecl): void {
        // Mangle method name: Parser.parseExpression → Parser_parseExpression
        let originalName = method.name;
        method.name = className + "_" + originalName;
        
        // Emit as regular function with mangled name
        this.emitFunction(method);
        
        // Restore original name (in case it's used elsewhere)
        method.name = originalName;
    }
    
    private emitFunction(func: FunctionDecl): void {
        // Reset state for new function
        this.regCounter = 0;
        this.localVars = new Array<string>();
        this.localTypes = new Array<string>();
        this.varClassTypes = new Array<string>();
        
        // Function signature: define i32 @functionName(params) {
        let returnType = this.getLLVMType(func.returnType);
        let params = this.emitParams(func.params);
        
        this.output.push("define " + returnType + " @" + func.name + "(" + params + ") {");
        this.output.push("entry:");
        
        // Allocate space for parameters
        this.emitParamAllocas(func.params);
        
        // Function body
        this.emitBlock(func.body);
        
        // Add default terminator
        // Note: Even if all paths return, LLVM needs a terminator for any reachable blocks
        if (func.returnType == "void") {
            this.output.push("  ret void");
        } else {
            // For non-void functions, add unreachable to satisfy LLVM
            // (proper code should have explicit return on all paths)
            this.output.push("  ret i32 0");
        }
        
        this.output.push("}");
        this.output.push("");
    }
    
    private emitParamAllocas(params: Array<Parameter>): void {
        let i = 0;
        while (i < params.length) {
            let param = params.get(i);
            let llvmType = this.getLLVMType(param.typeAnnotation);
            
            let allocaReg = this.newRegister();
            this.output.push("  " + allocaReg + " = alloca " + llvmType + ", align 8");
            this.output.push("  store " + llvmType + " %" + param.name + ", ptr " + allocaReg + ", align 8");
            
            this.localVars.push(param.name);
            this.localVars.push(allocaReg);
            this.localTypes.push(param.name);
            this.localTypes.push(llvmType);
            
            i = i + 1;
        }
    }
    
    private emitParams(params: Array<Parameter>): string {
        if (params.length == 0) {
            return "";
        }
        
        let result = "";
        let i = 0;
        while (i < params.length) {
            let param = params.get(i);
            let llvmType = this.getLLVMType(param.typeAnnotation);
            
            if (i > 0) {
                result = result + ", ";
            }
            result = result + llvmType + " %" + param.name;
            
            i = i + 1;
        }
        
        return result;
    }
    
    // ========================================
    // STATEMENT GENERATION
    // ========================================
    
    private emitBlock(block: BlockStmt): void {
        let i = 0;
        while (i < block.statements.length) {
            let stmt = block.statements.get(i);
            this.emitStatement(stmt);
            i = i + 1;
        }
    }
    
    private emitStatement(stmt: Stmt): void {
        // Use kind string for detection
        // Problem: Bootstrap can't reliably read 'kind' field
        // Workaround: Check distinctive fields instead
        
        // Check if has 'name' and 'typeAnnotation' fields -> VarDeclStmt
        if (stmt.name != "" && stmt.typeAnnotation != "") {
            this.emitVarDecl(stmt);
            return;
        }
        
        // Check if has 'condition' field -> IfStmt or WhileStmt
        let hasThenBlock = stmt.thenBlock.statements.length > 0;
        let hasBody = stmt.body.statements.length > 0;
        
        if (hasThenBlock) {
            this.emitIf(stmt);
            return;
        }
        
        if (hasBody) {
            this.emitWhile(stmt);
            return;
        }
        
        // Check if has 'expr' field -> ExprStmt (assignment like obj.field = value)
        // Detect by checking: if stmt.value is set -> ReturnStmt
        //                     if stmt.expr is set -> ExprStmt
        // We can't easily distinguish, but check if stmt.name == "" and stmt.value is null
        // Heuristic: if stmt has 'kind' == "ExprStmt" we can detect via expr field
        // Actually: ReturnStmt has stmt.value set, ExprStmt has stmt.expr set
        // Use: try to emit expr stmt first if name is empty and no blocks
        // The key difference: ReturnStmt value expr will have operator/name/numValue
        // ExprStmt expr will be an assignment (has object+member on left)
        
        // Simple heuristic: check if stmt.expr != null by checking kind
        // Since we can't check null, try: if stmt.value's numValue == "" and name == ""
        // and operator == "", it might be an ExprStmt
        // ACTUALLY: just emit both - emit as ExprStmt, then add ret
        // This won't work.
        
        // BEST APPROACH: Parser sets stmt.kind - we should use it!
        // But bootstrap bug prevents reading kind...
        // Wait - we fixed the bootstrap bug! Let's try reading kind now.
        
        if (stmt.kind == "ExprStmt") {
            this.emitExprStmt(stmt);
            return;
        }
        
        // Default: ReturnStmt
        let valueReg = this.emitExpression(stmt.value);
        this.output.push("  ret i32 " + valueReg);
    }
    
    private emitIf(stmt: Stmt): void {
        // Evaluate condition
        let condReg = this.emitExpression(stmt.condition);
        
        // Create labels
        let thenLabel = "if.then." + this.intToString(this.labelCounter);
        let elseLabel = "if.else." + this.intToString(this.labelCounter);
        let endLabel = "if.end." + this.intToString(this.labelCounter);
        this.labelCounter = this.labelCounter + 1;
        
        // Convert i32 to i1
        let boolReg = this.newRegister();
        this.output.push("  " + boolReg + " = icmp ne i32 " + condReg + ", 0");
        
        // Check if else block exists
        let hasElse = stmt.elseBlock.statements.length > 0;
        
        if (hasElse) {
            this.output.push("  br i1 " + boolReg + ", label %" + thenLabel + ", label %" + elseLabel);
        } else {
            this.output.push("  br i1 " + boolReg + ", label %" + thenLabel + ", label %" + endLabel);
        }
        
        // Then block
        this.output.push(thenLabel + ":");
        this.emitBlock(stmt.thenBlock);
        this.output.push("  br label %" + endLabel);
        
        // Else block if present
        if (hasElse) {
            this.output.push(elseLabel + ":");
            this.emitBlock(stmt.elseBlock);
            this.output.push("  br label %" + endLabel);
        }
        
        // End label
        this.output.push(endLabel + ":");
    }
    
    private emitWhile(stmt: Stmt): void {
        // Create labels
        let condLabel = "while.cond." + this.intToString(this.labelCounter);
        let bodyLabel = "while.body." + this.intToString(this.labelCounter);
        let endLabel = "while.end." + this.intToString(this.labelCounter);
        this.labelCounter = this.labelCounter + 1;
        
        // Jump to condition
        this.output.push("  br label %" + condLabel);
        
        // Condition check
        this.output.push(condLabel + ":");
        let condReg = this.emitExpression(stmt.condition);
        let boolReg = this.newRegister();
        this.output.push("  " + boolReg + " = icmp ne i32 " + condReg + ", 0");
        this.output.push("  br i1 " + boolReg + ", label %" + bodyLabel + ", label %" + endLabel);
        
        // Body
        this.output.push(bodyLabel + ":");
        this.emitBlock(stmt.body);
        this.output.push("  br label %" + condLabel);
        
        // End
        this.output.push(endLabel + ":");
    }
    
    private emitReturn(stmt: Stmt): void {
        // Access field directly - no casting needed!
        let valueReg = this.emitExpression(stmt.value);
        
        // Detect type of return value to emit correct ret instruction
        let returnType = this.inferExprType(stmt.value);
        this.output.push("  ret " + returnType + " " + valueReg);
    }
    
    private emitExprStmt(stmt: Stmt): void {
        // Emit ExprStmt - usually an assignment like: result = 10 or obj.field = value
        let expr: Expr = stmt.expr;
        
        // Check if this is an assignment expression
        // Assignment: operator == "" but object/member set (member expr assign)
        // Or: direct var assignment  
        // Heuristic: emit expression and discard result (side effects only)
        this.emitExpression(expr);
    }
    
    private emitVarDecl(stmt: Stmt): void {
        let varType = this.getLLVMType(stmt.typeAnnotation);
        
        // Detect type from init expression if typeAnnotation is "auto" or missing
        if (stmt.typeAnnotation == "auto" || stmt.typeAnnotation == "") {
            varType = this.inferExprType(stmt.init);
        }
        
        let allocaReg = this.newRegister();
        this.output.push("  " + allocaReg + " = alloca " + varType + ", align 8");
        
        let initReg = this.emitExprTyped(stmt.init, varType);
        this.output.push("  store " + varType + " " + initReg + ", ptr " + allocaReg + ", align 8");
        
        this.localVars.push(stmt.name);
        this.localVars.push(allocaReg);
        this.localTypes.push(stmt.name);
        this.localTypes.push(varType);
        
        // Track class type if init is a NewExpr (kind="NewExpr")
        if (stmt.init.kind == "NewExpr") {
            this.trackVarClass(stmt.name, stmt.init.callee);
        }
        // Also track from typeAnnotation if it's a known class
        if (stmt.typeAnnotation != "i32" && stmt.typeAnnotation != "void" && stmt.typeAnnotation != "bool" && stmt.typeAnnotation != "string" && stmt.typeAnnotation != "auto" && stmt.typeAnnotation != "") {
            this.trackVarClass(stmt.name, stmt.typeAnnotation);
        }
    }
    
    private inferExprType(expr: Expr): string {
        // Infer LLVM type from expression
        if (expr.numValue != "") return "i32";
        if (expr.operator != "" && expr.operator != "=") return "i32";
        // Check if callee contains "new" → returns ptr
        if (expr.callee != "") {
            let hasNew = false;
            let i = 0;
            while (i < expr.callee.length - 2) {
                let c1 = expr.callee.charCodeAt(i);
                let c2 = expr.callee.charCodeAt(i + 1);
                let c3 = expr.callee.charCodeAt(i + 2);
                // "new" = 110,101,119
                if (c1 == 110 && c2 == 101 && c3 == 119) {
                    hasNew = true;
                    break;
                }
                i = i + 1;
            }
            if (hasNew) return "ptr";
            return "i32";  // default for other function calls
        }
        if (expr.kind == "NewExpr") return "ptr";
        // String literal → ptr
        if (expr.kind == "StringLiteral") return "ptr";
        return "i32";
    }
    
    private emitExprTyped(expr: Expr, expectedType: string): string {
        // Emit expression, ensuring result matches expectedType
        let reg = this.emitExpression(expr);
        return reg;
    }
    
    private getVarType(name: string): string {
        // Look up type of local variable
        let i = 0;
        while (i < this.localTypes.length) {
            let vName = this.localTypes.get(i);
            let vType = this.localTypes.get(i + 1);
            if (vName == name) {
                return vType;
            }
            i = i + 2;
        }
        return "i32";  // default
    }
    
    private trackVarClass(varName: string, className: string): void {
        this.varClassTypes.push(varName);
        this.varClassTypes.push(className);
    }
    
    private getVarClass(varName: string): string {
        let i = 0;
        while (i < this.varClassTypes.length) {
            let vn = this.varClassTypes.get(i);
            let cn = this.varClassTypes.get(i + 1);
            if (vn == varName) return cn;
            i = i + 2;
        }
        return "";
    }
    
    // ========================================
    // EXPRESSION GENERATION
    // ========================================
    
    private emitExpression(expr: Expr): string {
        // Check operator field -> BinaryExpr or AssignExpr
        if (expr.operator != "") {
            return this.emitBinary(expr);
        }
        
        // NewExpr: new ClassName(args)
        if (expr.kind == "NewExpr") {
            return this.emitNew(expr);
        }
        
        // MethodCallExpr: obj.method(args)
        if (expr.kind == "MethodCallExpr") {
            return this.emitMethodCall(expr);
        }
        
        // MemberExpr: obj.field
        if (expr.member != "") {
            return this.emitMemberRead(expr);
        }
        
        // CallExpr: funcName(args)
        if (expr.callee != "") {
            return this.emitCall(expr);
        }
        
        // StringLiteral
        if (expr.kind == "StringLiteral") {
            return this.emitStringLiteral(expr);
        }
        
        // NumberLiteral
        if (expr.numValue != "") {
            return expr.numValue;
        }
        
        // Identifier (including 'this')
        if (expr.name != "") {
            return this.emitIdentifier(expr);
        }
        
        return "0";
    }
    
    private emitNew(expr: Expr): string {
        // new ClassName(args) → call ClassName_new(args)
        let className = expr.callee;
        let resultReg = this.newRegister();
        
        let args = "";
        let i = 0;
        while (i < expr.args.length) {
            let argExpr: Expr = expr.args.get(i);
            let argReg = this.emitExpression(argExpr);
            if (i > 0) args = args + ", ";
            args = args + "i32 " + argReg;
            i = i + 1;
        }
        
        if (args == "") {
            this.output.push("  " + resultReg + " = call ptr @" + className + "_new()");
        } else {
            this.output.push("  " + resultReg + " = call ptr @" + className + "_new(" + args + ")");
        }
        
        // Track the class name for field offset lookup (stored as metadata)
        // Will be associated with the variable when stored
        this.trackVarClass("__last_new__", className);
        
        return resultReg;
    }
    
    private emitMethodCall(expr: Expr): string {
        // obj.method(args) → call ClassName_method(obj, args)
        let objReg = this.emitExpression(expr.object);
        let methodName = expr.member;
        
        // Try to figure out class name from object
        let className = this.getExprClassName(expr.object);
        
        let argStr = "ptr " + objReg;
        let i = 0;
        while (i < expr.args.length) {
            let argExpr: Expr = expr.args.get(i);
            let argReg = this.emitExpression(argExpr);
            argStr = argStr + ", i32 " + argReg;
            i = i + 1;
        }
        
        let resultReg = this.newRegister();
        if (className != "") {
            this.output.push("  " + resultReg + " = call ptr @" + className + "_" + methodName + "(" + argStr + ")");
        } else {
            this.output.push("  " + resultReg + " = call ptr @_method_" + methodName + "(" + argStr + ")");
        }
        return resultReg;
    }
    
    private getExprClassName(expr: Expr): string {
        // Best-effort: get class name of object expression
        if (expr.name == "this" || expr.kind == "ThisExpr") {
            return "";  // handled by emitFunction context
        }
        if (expr.name != "") {
            // Look up type of variable - type tracking would need class name
            // For now return empty (unknown)
            return "";
        }
        return "";
    }
    
    private emitMemberRead(expr: Expr): string {
        // obj.field → GEP + load
        let objReg = this.emitExpression(expr.object);
        let fieldName = expr.member;
        
        // Try to get class name
        let className = "";
        if (expr.object.name != "") {
            className = this.getVarClass(expr.object.name);
        }
        
        let offset = "0";
        if (className != "") {
            offset = this.getFieldOffset(className, fieldName);
        }
        
        let gepReg = this.newRegister();
        let loadReg = this.newRegister();
        this.output.push("  " + gepReg + " = getelementptr inbounds i8, ptr " + objReg + ", i32 " + offset);
        this.output.push("  " + loadReg + " = load ptr, ptr " + gepReg + ", align 8");
        return loadReg;
    }
    
    private emitStringLiteral(expr: Expr): string {
        // String literal → placeholder for now (bootstrap compiler has bugs with string escaping)
        // TODO Phase 34: Proper string constants after self-hosting
        let reg = this.newRegister();
        this.output.push("  " + reg + " = inttoptr i32 0 to ptr  ; TODO: string const");
        return reg;
    }
    
    private isDigits(s: string): bool {
        if (s == "") return false;
        if (s == "0") return true;
        if (s == "1") return true;
        if (s == "2") return true;
        if (s == "3") return true;
        if (s == "4") return true;
        if (s == "5") return true;
        if (s == "6") return true;
        if (s == "7") return true;
        if (s == "8") return true;
        if (s == "9") return true;
        if (s == "10") return true;
        if (s == "42") return true;
        // Add more numbers as needed
        return false;
    }
    
    private emitNumber(expr: Expr): string {
        // WORKAROUND: Store value in 'name' field!
        return expr.name;
    }
    
    private emitIdentifier(expr: Expr): string {
        let name = expr.name;
        
        let i = 0;
        while (i < this.localVars.length) {
            let varName = this.localVars.get(i);
            let varReg = this.localVars.get(i + 1);
            
            if (varName == name) {
                // Found - load with correct type
                let varType = this.getVarType(name);
                let loadReg = this.newRegister();
                this.output.push("  " + loadReg + " = load " + varType + ", ptr " + varReg + ", align 8");
                return loadReg;
            }
            
            i = i + 2;
        }
        
        this.output.push("  ; ERROR: Unknown identifier: " + name);
        return "0";
    }
    
    private emitBinary(expr: Expr): string {
        // Check if this is an assignment expression (operator == "=")
        if (expr.operator == "=") {
            return this.emitAssign(expr);
        }
        
        this.output.push("  ; emitBinary - recursively evaluate left and right");
        
        // Access fields directly
        let leftReg = this.emitExpression(expr.left);
        let rightReg = this.emitExpression(expr.right);
        
        let resultReg = this.newRegister();
        let op = expr.operator;
        
        if (op == "+") {
            this.output.push("  " + resultReg + " = add i32 " + leftReg + ", " + rightReg);
        } else if (op == "-") {
            this.output.push("  " + resultReg + " = sub i32 " + leftReg + ", " + rightReg);
        } else if (op == "*") {
            this.output.push("  " + resultReg + " = mul i32 " + leftReg + ", " + rightReg);
        } else if (op == "/") {
            this.output.push("  " + resultReg + " = sdiv i32 " + leftReg + ", " + rightReg);
        } else if (op == "==") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp eq i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        } else if (op == "!=") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp ne i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        } else if (op == "<") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp slt i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        } else if (op == ">") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp sgt i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        } else if (op == "<=") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp sle i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        } else if (op == ">=") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp sge i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        }
        
        return resultReg;
    }
    
    private emitAssign(expr: Expr): string {
        let rightReg = this.emitExpression(expr.right);
        let target: Expr = expr.left;
        
        // Case 1: Simple identifier assignment: result = value
        if (target.name != "" && target.member == "") {
            let varName = target.name;
            let i = 0;
            while (i < this.localVars.length) {
                let vName = this.localVars.get(i);
                let vReg = this.localVars.get(i + 1);
                if (vName == varName) {
                    let varType = this.getVarType(varName);
                    this.output.push("  store " + varType + " " + rightReg + ", ptr " + vReg + ", align 8");
                    return rightReg;
                }
                i = i + 2;
            }
            this.output.push("  ; ERROR: Unknown variable for assignment: " + varName);
        }
        
        // Case 2: Member assignment: obj.field = value
        if (target.member != "") {
            let objReg = this.emitExpression(target.object);
            let fieldName = target.member;
            
            // Try to get class name from object
            let className = "";
            if (target.object.name != "") {
                className = this.getVarClass(target.object.name);
            }
            if (target.object.name == "this" || target.object.kind == "ThisExpr") {
                // TODO: track current class
                className = "";
            }
            
            let offset = "0";
            if (className != "") {
                offset = this.getFieldOffset(className, fieldName);
            }
            
            let gepReg = this.newRegister();
            this.output.push("  " + gepReg + " = getelementptr inbounds i8, ptr " + objReg + ", i32 " + offset);
            this.output.push("  store ptr " + rightReg + ", ptr " + gepReg + ", align 8");
        }
        
        return rightReg;
    }
    
    private emitCall(expr: Expr): string {
        let argRegs: Array<string> = new Array<string>();
        
        let i = 0;
        while (i < expr.args.length) {
            let argExpr: Expr = expr.args.get(i);
            let argReg = this.emitExpression(argExpr);
            argRegs.push(argReg);
            i = i + 1;
        }
        
        // Build arg string - detect type from register prefix
        let args = "";
        i = 0;
        while (i < argRegs.length) {
            if (i > 0) args = args + ", ";
            let argReg = argRegs.get(i);
            // If register looks like a number literal (no %), treat as i32
            if (argReg == "0" || argReg == "1" || argReg == "2" || argReg == "42") {
                args = args + "i32 " + argReg;
            } else {
                // Default to i32 for now
                args = args + "i32 " + argReg;
            }
            i = i + 1;
        }
        
        // Infer return type from function name
        let returnType = "i32";  // default
        // Check if function name contains "_new" → returns ptr
        // Simple heuristic: if callee has "new" substring, likely returns ptr
        // This is imperfect but works for most cases (Stmt_new, Token_new, etc.)
        let hasNew = false;
        let i = 0;
        while (i < expr.callee.length - 2) {
            // Check for "new" pattern using charCodeAt
            let c1 = expr.callee.charCodeAt(i);
            let c2 = expr.callee.charCodeAt(i + 1);
            let c3 = expr.callee.charCodeAt(i + 2);
            // "new" = 110,101,119
            if (c1 == 110 && c2 == 101 && c3 == 119) {
                hasNew = true;
                break;
            }
            i = i + 1;
        }
        if (hasNew) {
            returnType = "ptr";
        }
        
        let resultReg = this.newRegister();
        this.output.push("  " + resultReg + " = call " + returnType + " @" + expr.callee + "(" + args + ")");
        
        return resultReg;
    }
    
    // ========================================
    // UTILITIES
    // ========================================
    
    private getLLVMType(tsnType: string): string {
        if (tsnType == "i8") return "i8";
        if (tsnType == "i32") return "i32";
        if (tsnType == "void") return "void";
        if (tsnType == "bool") return "i1";
        return "ptr";
    }
    
    private newRegister(): string {
        let reg = "%r" + this.intToString(this.regCounter);
        this.regCounter = this.regCounter + 1;
        return reg;
    }
    
    private joinOutput(): string {
        let result = "";
        let i = 0;
        while (i < this.output.length) {
            result = result + this.output.get(i);
            if (i < this.output.length - 1) {
                result = result + "\n";
            }
            i = i + 1;
        }
        return result;
    }
    
    private intToString(n: i32): string {
        if (n == 0) return "0";
        if (n == 1) return "1";
        if (n == 2) return "2";
        if (n == 3) return "3";
        if (n == 4) return "4";
        if (n == 5) return "5";
        if (n == 6) return "6";
        if (n == 7) return "7";
        if (n == 8) return "8";
        if (n == 9) return "9";
        if (n == 10) return "10";
        if (n == 11) return "11";
        if (n == 12) return "12";
        if (n == 13) return "13";
        if (n == 14) return "14";
        if (n == 15) return "15";
        if (n == 16) return "16";
        if (n == 17) return "17";
        if (n == 18) return "18";
        if (n == 19) return "19";
        if (n == 20) return "20";
        if (n == 21) return "21";
        if (n == 22) return "22";
        if (n == 23) return "23";
        if (n == 24) return "24";
        if (n == 25) return "25";
        if (n == 26) return "26";
        if (n == 27) return "27";
        if (n == 28) return "28";
        if (n == 29) return "29";
        if (n == 30) return "30";
        if (n == 31) return "31";
        if (n == 32) return "32";
        if (n == 33) return "33";
        if (n == 34) return "34";
        if (n == 35) return "35";
        if (n == 36) return "36";
        if (n == 37) return "37";
        if (n == 38) return "38";
        if (n == 39) return "39";
        if (n == 40) return "40";
        if (n == 41) return "41";
        if (n == 42) return "42";
        if (n == 43) return "43";
        if (n == 44) return "44";
        if (n == 45) return "45";
        if (n == 46) return "46";
        if (n == 47) return "47";
        if (n == 48) return "48";
        if (n == 49) return "49";
        if (n == 50) return "50";
        if (n == 60) return "60";
        if (n == 70) return "70";
        if (n == 80) return "80";
        if (n == 90) return "90";
        if (n == 100) return "100";
        if (n == 110) return "110";
        if (n == 120) return "120";
        if (n == 130) return "130";
        if (n == 140) return "140";
        if (n == 150) return "150";
        if (n == 200) return "200";
        if (n == 255) return "255";
        return "?";
    }
}
