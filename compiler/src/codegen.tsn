// Codegen - LLVM IR Generator
// Convert AST → LLVM IR

import { Array } from "std:array";
import { log } from "std:console";
import { Program, FunctionDecl, Parameter, BlockStmt, Stmt, Expr, ReturnStmt, ExprStmt, NumberLiteral, Identifier, BinaryExpr } from "./ast.tsn";

export class Codegen {
    program: Program;
    output: Array<string>;
    regCounter: i32;
    labelCounter: i32;
    localVars: Array<string>;  // Track variable names & regs
    
    constructor(program: Program) {
        this.program = program;
        this.output = new Array<string>();
        this.regCounter = 0;
        this.labelCounter = 0;
        this.localVars = new Array<string>();
    }
    
    // ========================================
    // MAIN ENTRY POINT
    // ========================================
    
    public generate(): string {
        this.emitHeader();
        this.emitFunctions();
        
        return this.joinOutput();
    }
    
    // ========================================
    // HEADER & DECLARATIONS
    // ========================================
    
    private emitHeader(): void {
        this.output.push("; Generated by TSN Compiler v2");
        this.output.push("");
        
        // Runtime declarations
        this.output.push("declare void @print_i32(i32)");
        this.output.push("declare void @_T_log_P_ptr(ptr)");
        this.output.push("");
    }
    
    // ========================================
    // FUNCTION GENERATION
    // ========================================
    
    private emitFunctions(): void {
        let i = 0;
        while (i < this.program.functions.length) {
            let func = this.program.functions.get(i);
            this.emitFunction(func);
            i = i + 1;
        }
    }
    
    private emitFunction(func: FunctionDecl): void {
        // Reset state for new function
        this.regCounter = 0;
        this.localVars = new Array<string>();
        
        // Function signature: define i32 @functionName(params) {
        let returnType = this.getLLVMType(func.returnType);
        let params = this.emitParams(func.params);
        
        this.output.push("define " + returnType + " @" + func.name + "(" + params + ") {");
        this.output.push("entry:");
        
        // Allocate space for parameters
        this.emitParamAllocas(func.params);
        
        // Function body
        this.emitBlock(func.body);
        
        // Add default terminator
        // Note: Even if all paths return, LLVM needs a terminator for any reachable blocks
        if (func.returnType == "void") {
            this.output.push("  ret void");
        } else {
            // For non-void functions, add unreachable to satisfy LLVM
            // (proper code should have explicit return on all paths)
            this.output.push("  ret i32 0");
        }
        
        this.output.push("}");
        this.output.push("");
    }
    
    private emitParamAllocas(params: Array<Parameter>): void {
        let i = 0;
        while (i < params.length) {
            let param = params.get(i);
            let llvmType = this.getLLVMType(param.typeAnnotation);
            
            // Allocate stack space
            let allocaReg = this.newRegister();
            this.output.push("  " + allocaReg + " = alloca " + llvmType + ", align 8");
            
            // Store parameter value
            this.output.push("  store " + llvmType + " %" + param.name + ", ptr " + allocaReg + ", align 8");
            
            // Track variable: name → alloca register
            this.localVars.push(param.name);
            this.localVars.push(allocaReg);
            
            i = i + 1;
        }
    }
    
    private emitParams(params: Array<Parameter>): string {
        if (params.length == 0) {
            return "";
        }
        
        let result = "";
        let i = 0;
        while (i < params.length) {
            let param = params.get(i);
            let llvmType = this.getLLVMType(param.typeAnnotation);
            
            if (i > 0) {
                result = result + ", ";
            }
            result = result + llvmType + " %" + param.name;
            
            i = i + 1;
        }
        
        return result;
    }
    
    // ========================================
    // STATEMENT GENERATION
    // ========================================
    
    private emitBlock(block: BlockStmt): void {
        let i = 0;
        while (i < block.statements.length) {
            let stmt = block.statements.get(i);
            this.emitStatement(stmt);
            i = i + 1;
        }
    }
    
    private emitStatement(stmt: Stmt): void {
        // Use kind string for detection
        // Problem: Bootstrap can't reliably read 'kind' field
        // Workaround: Check distinctive fields instead
        
        // Check if has 'name' and 'typeAnnotation' fields -> VarDeclStmt
        if (stmt.name != "" && stmt.typeAnnotation != "") {
            this.emitVarDecl(stmt);
            return;
        }
        
        // Check if has 'condition' field -> IfStmt or WhileStmt
        let hasThenBlock = stmt.thenBlock.statements.length > 0;
        let hasBody = stmt.body.statements.length > 0;
        
        if (hasThenBlock) {
            this.emitIf(stmt);
            return;
        }
        
        if (hasBody) {
            this.emitWhile(stmt);
            return;
        }
        
        // Check if has 'expr' field -> ExprStmt (assignment like obj.field = value)
        // Detect by checking: if stmt.value is set -> ReturnStmt
        //                     if stmt.expr is set -> ExprStmt
        // We can't easily distinguish, but check if stmt.name == "" and stmt.value is null
        // Heuristic: if stmt has 'kind' == "ExprStmt" we can detect via expr field
        // Actually: ReturnStmt has stmt.value set, ExprStmt has stmt.expr set
        // Use: try to emit expr stmt first if name is empty and no blocks
        // The key difference: ReturnStmt value expr will have operator/name/numValue
        // ExprStmt expr will be an assignment (has object+member on left)
        
        // Simple heuristic: check if stmt.expr != null by checking kind
        // Since we can't check null, try: if stmt.value's numValue == "" and name == ""
        // and operator == "", it might be an ExprStmt
        // ACTUALLY: just emit both - emit as ExprStmt, then add ret
        // This won't work.
        
        // BEST APPROACH: Parser sets stmt.kind - we should use it!
        // But bootstrap bug prevents reading kind...
        // Wait - we fixed the bootstrap bug! Let's try reading kind now.
        
        if (stmt.kind == "ExprStmt") {
            this.emitExprStmt(stmt);
            return;
        }
        
        // Default: ReturnStmt
        let valueReg = this.emitExpression(stmt.value);
        this.output.push("  ret i32 " + valueReg);
    }
    
    private emitIf(stmt: Stmt): void {
        // Evaluate condition
        let condReg = this.emitExpression(stmt.condition);
        
        // Create labels
        let thenLabel = "if.then." + this.intToString(this.labelCounter);
        let elseLabel = "if.else." + this.intToString(this.labelCounter);
        let endLabel = "if.end." + this.intToString(this.labelCounter);
        this.labelCounter = this.labelCounter + 1;
        
        // Convert i32 to i1
        let boolReg = this.newRegister();
        this.output.push("  " + boolReg + " = icmp ne i32 " + condReg + ", 0");
        
        // Check if else block exists
        let hasElse = stmt.elseBlock.statements.length > 0;
        
        if (hasElse) {
            this.output.push("  br i1 " + boolReg + ", label %" + thenLabel + ", label %" + elseLabel);
        } else {
            this.output.push("  br i1 " + boolReg + ", label %" + thenLabel + ", label %" + endLabel);
        }
        
        // Then block
        this.output.push(thenLabel + ":");
        this.emitBlock(stmt.thenBlock);
        this.output.push("  br label %" + endLabel);
        
        // Else block if present
        if (hasElse) {
            this.output.push(elseLabel + ":");
            this.emitBlock(stmt.elseBlock);
            this.output.push("  br label %" + endLabel);
        }
        
        // End label
        this.output.push(endLabel + ":");
    }
    
    private emitWhile(stmt: Stmt): void {
        // Create labels
        let condLabel = "while.cond." + this.intToString(this.labelCounter);
        let bodyLabel = "while.body." + this.intToString(this.labelCounter);
        let endLabel = "while.end." + this.intToString(this.labelCounter);
        this.labelCounter = this.labelCounter + 1;
        
        // Jump to condition
        this.output.push("  br label %" + condLabel);
        
        // Condition check
        this.output.push(condLabel + ":");
        let condReg = this.emitExpression(stmt.condition);
        let boolReg = this.newRegister();
        this.output.push("  " + boolReg + " = icmp ne i32 " + condReg + ", 0");
        this.output.push("  br i1 " + boolReg + ", label %" + bodyLabel + ", label %" + endLabel);
        
        // Body
        this.output.push(bodyLabel + ":");
        this.emitBlock(stmt.body);
        this.output.push("  br label %" + condLabel);
        
        // End
        this.output.push(endLabel + ":");
    }
    
    private emitReturn(stmt: Stmt): void {
        // Access field directly - no casting needed!
        let valueReg = this.emitExpression(stmt.value);
        this.output.push("  ret i32 " + valueReg);
    }
    
    private emitExprStmt(stmt: Stmt): void {
        // Emit ExprStmt - usually an assignment like: result = 10 or obj.field = value
        let expr: Expr = stmt.expr;
        
        // Check if this is an assignment expression
        // Assignment: operator == "" but object/member set (member expr assign)
        // Or: direct var assignment  
        // Heuristic: emit expression and discard result (side effects only)
        this.emitExpression(expr);
    }
    
    private emitVarDecl(stmt: Stmt): void {
        // Allocate stack space for variable
        let allocaReg = this.newRegister();
        this.output.push("  " + allocaReg + " = alloca i32, align 8");
        
        // Store initial value
        let initReg = this.emitExpression(stmt.init);
        this.output.push("  store i32 " + initReg + ", ptr " + allocaReg + ", align 8");
        
        // Track variable: name → alloca register
        this.localVars.push(stmt.name);
        this.localVars.push(allocaReg);
    }
    
    // ========================================
    // EXPRESSION GENERATION
    // ========================================
    
    private emitExpression(expr: Expr): string {
        // WORKAROUND: Can't check kind due to bootstrap bug
        // Check distinctive fields to determine type
        
        // Check operator field -> BinaryExpr
        if (expr.operator != "") {
            return this.emitBinary(expr);
        }
        
        // Check if has callee field -> CallExpr
        if (expr.callee != "") {
            return this.emitCall(expr);
        }
        
        // Check numValue field -> NumberLiteral
        if (expr.numValue != "") {
            return expr.numValue;
        }
        
        // Check if name is set -> Identifier
        if (expr.name != "") {
            return this.emitIdentifier(expr);
        }
        
        // Fallback
        return "0";
    }
    
    private isDigits(s: string): bool {
        if (s == "") return false;
        if (s == "0") return true;
        if (s == "1") return true;
        if (s == "2") return true;
        if (s == "3") return true;
        if (s == "4") return true;
        if (s == "5") return true;
        if (s == "6") return true;
        if (s == "7") return true;
        if (s == "8") return true;
        if (s == "9") return true;
        if (s == "10") return true;
        if (s == "42") return true;
        // Add more numbers as needed
        return false;
    }
    
    private emitNumber(expr: Expr): string {
        // WORKAROUND: Store value in 'name' field!
        return expr.name;
    }
    
    private emitIdentifier(expr: Expr): string {
        let name = expr.name;
        
        // Look up variable in localVars array
        // Format: [name1, reg1, name2, reg2, ...]
        let i = 0;
        while (i < this.localVars.length) {
            let varName = this.localVars.get(i);
            let varReg = this.localVars.get(i + 1);
            
            if (varName == name) {
                // Found it! Load from alloca
                let loadReg = this.newRegister();
                this.output.push("  " + loadReg + " = load i32, ptr " + varReg + ", align 8");
                return loadReg;
            }
            
            i = i + 2;
        }
        
        // Not found - error
        this.output.push("  ; ERROR: Unknown identifier: " + name);
        return "0";
    }
    
    private emitBinary(expr: Expr): string {
        // Check if this is an assignment expression (operator == "=")
        if (expr.operator == "=") {
            return this.emitAssign(expr);
        }
        
        this.output.push("  ; emitBinary - recursively evaluate left and right");
        
        // Access fields directly
        let leftReg = this.emitExpression(expr.left);
        let rightReg = this.emitExpression(expr.right);
        
        let resultReg = this.newRegister();
        let op = expr.operator;
        
        if (op == "+") {
            this.output.push("  " + resultReg + " = add i32 " + leftReg + ", " + rightReg);
        } else if (op == "-") {
            this.output.push("  " + resultReg + " = sub i32 " + leftReg + ", " + rightReg);
        } else if (op == "*") {
            this.output.push("  " + resultReg + " = mul i32 " + leftReg + ", " + rightReg);
        } else if (op == "/") {
            this.output.push("  " + resultReg + " = sdiv i32 " + leftReg + ", " + rightReg);
        } else if (op == "==") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp eq i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        } else if (op == "!=") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp ne i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        } else if (op == "<") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp slt i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        } else if (op == ">") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp sgt i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        } else if (op == "<=") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp sle i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        } else if (op == ">=") {
            let cmpReg = this.newRegister();
            this.output.push("  " + cmpReg + " = icmp sge i32 " + leftReg + ", " + rightReg);
            this.output.push("  " + resultReg + " = zext i1 " + cmpReg + " to i32");
        }
        
        return resultReg;
    }
    
    private emitAssign(expr: Expr): string {
        // Assignment: left = right
        // Left can be: Identifier (local var) or MemberExpr (this.field)
        let rightReg = this.emitExpression(expr.right);
        
        let target: Expr = expr.left;
        
        // Case 1: Simple identifier assignment: result = value
        if (target.name != "") {
            // Find the alloca register for this variable
            let varName = target.name;
            let i = 0;
            while (i < this.localVars.length) {
                let vName = this.localVars.get(i);
                let vReg = this.localVars.get(i + 1);
                if (vName == varName) {
                    this.output.push("  store i32 " + rightReg + ", ptr " + vReg + ", align 8");
                    return rightReg;
                }
                i = i + 2;
            }
            this.output.push("  ; ERROR: Unknown variable for assignment: " + varName);
        }
        
        // Case 2: Member assignment: this.field = value or obj.field = value
        // target.member is set, target.object is set
        if (target.member != "") {
            let objReg = this.emitExpression(target.object);
            // Look up field index
            let fieldName = target.member;
            let gep = this.newRegister();
            // Need to find GEP index - simplified: emit as comment for now
            this.output.push("  ; member assign: " + fieldName);
            // TODO: proper GEP for member assignment
        }
        
        return rightReg;
    }
    
    private emitCall(expr: Expr): string {
        // Build argument list
        let args = "";
        let argRegs: Array<string> = new Array<string>();
        
        let i = 0;
        while (i < expr.args.length) {
            let argExpr = expr.args.get(i);
            let argReg = this.emitExpression(argExpr);
            argRegs.push(argReg);
            i = i + 1;
        }
        
        // Build argument string: i32 %r0, i32 %r1
        i = 0;
        while (i < argRegs.length) {
            if (i > 0) {
                args = args + ", ";
            }
            args = args + "i32 " + argRegs.get(i);
            i = i + 1;
        }
        
        let resultReg = this.newRegister();
        this.output.push("  " + resultReg + " = call i32 @" + expr.callee + "(" + args + ")");
        
        return resultReg;
    }
    
    // ========================================
    // UTILITIES
    // ========================================
    
    private getLLVMType(tsnType: string): string {
        if (tsnType == "i32") return "i32";
        if (tsnType == "void") return "void";
        if (tsnType == "bool") return "i1";
        return "ptr";
    }
    
    private newRegister(): string {
        let reg = "%r" + this.intToString(this.regCounter);
        this.regCounter = this.regCounter + 1;
        return reg;
    }
    
    private joinOutput(): string {
        let result = "";
        let i = 0;
        while (i < this.output.length) {
            result = result + this.output.get(i);
            if (i < this.output.length - 1) {
                result = result + "\n";
            }
            i = i + 1;
        }
        return result;
    }
    
    private intToString(n: i32): string {
        if (n == 0) return "0";
        if (n == 1) return "1";
        if (n == 2) return "2";
        if (n == 3) return "3";
        if (n == 4) return "4";
        if (n == 5) return "5";
        if (n == 6) return "6";
        if (n == 7) return "7";
        if (n == 8) return "8";
        if (n == 9) return "9";
        if (n == 10) return "10";
        if (n == 11) return "11";
        if (n == 12) return "12";
        if (n == 13) return "13";
        if (n == 14) return "14";
        if (n == 15) return "15";
        if (n == 16) return "16";
        if (n == 17) return "17";
        if (n == 18) return "18";
        if (n == 19) return "19";
        if (n == 20) return "20";
        if (n == 21) return "21";
        if (n == 22) return "22";
        if (n == 23) return "23";
        if (n == 24) return "24";
        if (n == 25) return "25";
        if (n == 26) return "26";
        if (n == 27) return "27";
        if (n == 28) return "28";
        if (n == 29) return "29";
        if (n == 30) return "30";
        if (n == 31) return "31";
        if (n == 32) return "32";
        if (n == 33) return "33";
        if (n == 34) return "34";
        if (n == 35) return "35";
        if (n == 36) return "36";
        if (n == 37) return "37";
        if (n == 38) return "38";
        if (n == 39) return "39";
        if (n == 40) return "40";
        if (n == 41) return "41";
        if (n == 42) return "42";
        if (n == 43) return "43";
        if (n == 44) return "44";
        if (n == 45) return "45";
        if (n == 46) return "46";
        if (n == 47) return "47";
        if (n == 48) return "48";
        if (n == 49) return "49";
        if (n == 50) return "50";
        if (n == 60) return "60";
        if (n == 70) return "70";
        if (n == 80) return "80";
        if (n == 90) return "90";
        if (n == 100) return "100";
        if (n == 110) return "110";
        if (n == 120) return "120";
        if (n == 130) return "130";
        if (n == 140) return "140";
        if (n == 150) return "150";
        if (n == 200) return "200";
        if (n == 255) return "255";
        return "?";
    }
}
