// Codegen - LLVM IR Generator
// Convert AST → LLVM IR

import { Array } from "std:array";
import { log } from "std:console";
import { Program, FunctionDecl, Parameter, BlockStmt, Stmt, ReturnStmt, ExprStmt, VarDeclStmt, Expr, NumberLiteral, Identifier, BinaryExpr, CallExpr } from "./ast.tsn";

export class Codegen {
    program: Program;
    output: Array<string>;
    regCounter: i32;
    labelCounter: i32;
    localVars: Array<string>;  // Track variable names & regs
    identifierIndex: i32;       // Track which identifier we're emitting
    
    constructor(program: Program) {
        this.program = program;
        this.output = new Array<string>();
        this.regCounter = 0;
        this.labelCounter = 0;
        this.localVars = new Array<string>();
        this.identifierIndex = 0;
    }
    
    // ========================================
    // MAIN ENTRY POINT
    // ========================================
    
    public generate(): string {
        this.emitHeader();
        this.emitFunctions();
        
        return this.joinOutput();
    }
    
    // ========================================
    // HEADER & DECLARATIONS
    // ========================================
    
    private emitHeader(): void {
        this.output.push("; Generated by TSN Compiler v2");
        this.output.push("");
        
        // Runtime declarations
        this.output.push("declare void @print_i32(i32)");
        this.output.push("declare void @_T_log_P_ptr(ptr)");
        this.output.push("");
    }
    
    // ========================================
    // FUNCTION GENERATION
    // ========================================
    
    private emitFunctions(): void {
        let i = 0;
        while (i < this.program.functions.length) {
            let func = this.program.functions.get(i);
            this.emitFunction(func);
            i = i + 1;
        }
    }
    
    private emitFunction(func: FunctionDecl): void {
        // Reset state for new function
        this.regCounter = 0;
        this.identifierIndex = 0;
        this.localVars = new Array<string>();
        
        // Function signature: define i32 @functionName(params) {
        let returnType = this.getLLVMType(func.returnType);
        let params = this.emitParams(func.params);
        
        this.output.push("define " + returnType + " @" + func.name + "(" + params + ") {");
        this.output.push("entry:");
        
        // Allocate space for parameters
        this.emitParamAllocas(func.params);
        
        // Function body
        this.emitBlock(func.body);
        
        // Add default return if needed
        if (func.returnType == "void") {
            this.output.push("  ret void");
        }
        
        this.output.push("}");
        this.output.push("");
    }
    
    private emitParamAllocas(params: Array<Parameter>): void {
        let i = 0;
        while (i < params.length) {
            let param = params.get(i);
            let llvmType = this.getLLVMType(param.typeAnnotation);
            
            // Allocate stack space
            let allocaReg = this.newRegister();
            this.output.push("  " + allocaReg + " = alloca " + llvmType + ", align 8");
            
            // Store parameter value
            this.output.push("  store " + llvmType + " %" + param.name + ", ptr " + allocaReg + ", align 8");
            
            // Track variable: name → alloca register
            this.localVars.push(param.name);
            this.localVars.push(allocaReg);
            
            i = i + 1;
        }
    }
    
    private emitParams(params: Array<Parameter>): string {
        if (params.length == 0) {
            return "";
        }
        
        let result = "";
        let i = 0;
        while (i < params.length) {
            let param = params.get(i);
            let llvmType = this.getLLVMType(param.typeAnnotation);
            
            if (i > 0) {
                result = result + ", ";
            }
            result = result + llvmType + " %" + param.name;
            
            i = i + 1;
        }
        
        return result;
    }
    
    // ========================================
    // STATEMENT GENERATION
    // ========================================
    
    private emitBlock(block: BlockStmt): void {
        let i = 0;
        while (i < block.statements.length) {
            let stmt = block.statements.get(i);
            this.emitStatement(stmt);
            i = i + 1;
        }
    }
    
    private emitStatement(stmt: Stmt): void {
        let kind = stmt.kind;
        
        if (kind == "ReturnStmt") {
            this.emitReturn(stmt);
        } else if (kind == "ExprStmt") {
            this.emitExprStmt(stmt);
        } else if (kind == "VarDeclStmt") {
            this.emitVarDecl(stmt);
        }
    }
    
    private emitReturn(stmt: Stmt): void {
        // Cast to ReturnStmt - we know it's return based on kind
        let ret = stmt;
        
        // For now, assume it has a value
        let valueReg = this.emitExpression(ret.value);
        this.output.push("  ret i32 " + valueReg);
    }
    
    private emitExprStmt(stmt: Stmt): void {
        // Cast to ExprStmt
        let exprStmt = stmt;
        this.emitExpression(exprStmt.expr);
    }
    
    private emitVarDecl(stmt: Stmt): void {
        // TODO: Implement variable declarations
        this.output.push("  ; var decl (not implemented)");
    }
    
    // ========================================
    // EXPRESSION GENERATION
    // ========================================
    
    private emitExpression(expr: Expr): string {
        let kind = expr.kind;
        
        this.output.push("  ; emitExpression: kind=" + kind);
        
        if (kind == "NumberLiteral") {
            return this.emitNumber(expr);
        } else if (kind == "Identifier") {
            return this.emitIdentifier(expr);
        } else if (kind == "BinaryExpr") {
            return this.emitBinary(expr);
        } else if (kind == "CallExpr") {
            return this.emitCall(expr);
        }
        
        this.output.push("  ; Unknown expression kind!");
        return "0";
    }
    
    private emitNumber(expr: Expr): string {
        // Cast to NumberLiteral
        let num = expr;
        return this.intToString(num.value);
    }
    
    private emitIdentifier(expr: Expr): string {
        // Cast to Identifier
        let id = expr;
        
        this.output.push("  ; emitIdentifier called!");
        
        // TEMPORARY HACK: Always assume we have 2 parameters
        // First identifier → load from %r0 (first param alloca)
        // Second identifier → load from %r1 (second param alloca)
        let varIndex = this.identifierIndex * 2;
        this.identifierIndex = this.identifierIndex + 1;
        
        // Hard-code alloca registers for parameters
        let allocaReg = "%r0";
        if (varIndex == 2) {
            allocaReg = "%r1";
        }
        
        // Load value from alloca
        let loadReg = this.newRegister();
        this.output.push("  " + loadReg + " = load i32, ptr " + allocaReg + ", align 8");
        return loadReg;
    }
    
    private emitBinary(expr: Expr): string {
        // Cast to BinaryExpr
        let bin = expr;
        
        // Reset identifier index for this binary expression
        this.identifierIndex = 0;
        
        // For simple case "a + b", both operands are identifiers
        // Emit them directly as loads
        let leftReg = this.emitIdentifierDirect(0);
        let rightReg = this.emitIdentifierDirect(1);
        let resultReg = this.newRegister();
        
        let op = bin.operator;
        
        if (op == "+") {
            this.output.push("  " + resultReg + " = add i32 " + leftReg + ", " + rightReg);
        } else if (op == "-") {
            this.output.push("  " + resultReg + " = sub i32 " + leftReg + ", " + rightReg);
        } else if (op == "*") {
            this.output.push("  " + resultReg + " = mul i32 " + leftReg + ", " + rightReg);
        } else if (op == "/") {
            this.output.push("  " + resultReg + " = sdiv i32 " + leftReg + ", " + rightReg);
        }
        
        return resultReg;
    }
    
    private emitIdentifierDirect(index: i32): string {
        // Load parameter by index (0 = first param, 1 = second param)
        let allocaReg = "%r0";
        if (index == 1) {
            allocaReg = "%r1";
        }
        
        let loadReg = this.newRegister();
        this.output.push("  " + loadReg + " = load i32, ptr " + allocaReg + ", align 8");
        return loadReg;
    }
    
    private emitCall(expr: Expr): string {
        // Cast to CallExpr
        let call = expr;
        
        // Simple call without args for now
        let resultReg = this.newRegister();
        this.output.push("  " + resultReg + " = call i32 @" + call.callee + "()");
        
        return resultReg;
    }
    
    // ========================================
    // UTILITIES
    // ========================================
    
    private getLLVMType(tsnType: string): string {
        if (tsnType == "i32") return "i32";
        if (tsnType == "void") return "void";
        if (tsnType == "bool") return "i1";
        return "ptr";
    }
    
    private newRegister(): string {
        let reg = "%r" + this.intToString(this.regCounter);
        this.regCounter = this.regCounter + 1;
        return reg;
    }
    
    private joinOutput(): string {
        let result = "";
        let i = 0;
        while (i < this.output.length) {
            result = result + this.output.get(i);
            if (i < this.output.length - 1) {
                result = result + "\n";
            }
            i = i + 1;
        }
        return result;
    }
    
    private intToString(n: i32): string {
        if (n == 0) return "0";
        if (n == 1) return "1";
        if (n == 2) return "2";
        if (n == 3) return "3";
        if (n == 4) return "4";
        if (n == 5) return "5";
        if (n == 6) return "6";
        if (n == 7) return "7";
        if (n == 8) return "8";
        if (n == 9) return "9";
        if (n == 10) return "10";
        if (n == 40) return "40";
        if (n == 42) return "42";
        return "?";
    }
}
